0A020                           .else
0A020                               FAMISTUDIO_DUAL_SUPPORT = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_CFG_SFX_SUPPORT
0A020                               FAMISTUDIO_CFG_SFX_SUPPORT = 0
