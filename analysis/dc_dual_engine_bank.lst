0A50C                               lda famistudio_epsm_note_table_lsb,y
0A50C                               sbc famistudio_epsm_note_table_lsb,x
0A50C                               sta slide_delta_lo
0A50C                               lda famistudio_epsm_note_table_msb,y
0A50C                               sbc famistudio_epsm_note_table_msb,x
0A50C                               jmp @note_table_done
0A50C                           .endif
0A50C                           .endif
0A50C                           @note_table_expansion:
0A50C                               lda famistudio_exp_note_table_lsb,y
0A50C                               sbc famistudio_exp_note_table_lsb,x
0A50C                               sta slide_delta_lo
0A50C                               lda famistudio_exp_note_table_msb,y
0A50C                               sbc famistudio_exp_note_table_msb,x
0A50C                           @note_table_done:
0A50C                           .endif
0A50C                               ldx tmp_slide_idx ; slide index.
0A50C                               sta famistudio_slide_pitch_hi,x
0A50C                               .if FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM
0A50C                                   cpx #FAMISTUDIO_FIRST_POSITIVE_SLIDE_CHANNEL ; Slide #3 is the first of expansion slides.
0A50C                                   bcs @positive_shift
0A50C                               .endif
0A50C                               @negative_shift:
