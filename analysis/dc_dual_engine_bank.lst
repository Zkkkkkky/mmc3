0A50C                               ; Noise slides have 4-bits of fraction.
0A50C                               asl famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               rol
0A50C                               asl famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               rol
0A50C                               asl famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               rol
0A50C                               asl famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               rol
0A50C                               sta famistudio_slide_pitch_hi+FAMISTUDIO_NOISE_SLIDE_INDEX
