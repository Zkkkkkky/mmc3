00440                           famistudio_chn_ptr_lo:            .dsb FAMISTUDIO_NUM_CHANNELS
00445                           famistudio_chn_ptr_hi:            .dsb FAMISTUDIO_NUM_CHANNELS
0044A                           famistudio_chn_note:              .dsb FAMISTUDIO_NUM_CHANNELS
0044F                           famistudio_chn_repeat:            .dsb FAMISTUDIO_NUM_CHANNELS
00454                           famistudio_chn_return_lo:         .dsb FAMISTUDIO_NUM_CHANNELS
00459                           .ende
0A020                           
0A020                           .enum $0032
00032                           famistudio_chn_return_hi:         .dsb FAMISTUDIO_NUM_CHANNELS
00037                           famistudio_chn_ref_len:           .dsb FAMISTUDIO_NUM_CHANNELS
0003C                           famistudio_pitch_env_repeat:      .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
0003F                           famistudio_pitch_env_addr_lo:     .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
00042                           famistudio_chn_volume_track:      .dsb FAMISTUDIO_NUM_CHANNELS
00047                           famistudio_pitch_env_addr_hi:     .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
0004A                           famistudio_tempo_env_ptr_lo:      .dsb 1
0004B                           famistudio_tempo_env_ptr_hi:      .dsb 1
0004C                           .ende
0A020                           
0A020                           .enum $0057
00057                           famistudio_pitch_env_ptr:         .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
0005A                           famistudio_tempo_env_counter:     .dsb 1
0005B                           famistudio_tempo_env_idx:         .dsb 1
0005C                           famistudio_tempo_frame_num:       .dsb 1
0005D                           famistudio_tempo_frame_cnt:       .dsb 1
0005E                           .ende
0A020                           
0A020                           .enum $046c
0046C                           famistudio_instrument_lo:         .dsb 1
0046D                           famistudio_instrument_hi:         .dsb 1
0046E                           famistudio_pulse1_prev:           .dsb 1
0046F                           famistudio_pulse2_prev:           .dsb 1
00470                           .ende
0A020                           
0A020                           famistudio_song_speed = $002f
0A020                           
0A020                           .if FAMISTUDIO_CFG_SFX_SUPPORT
0A020                           famistudio_output_buf = $004c
0A020                           .enum $0459
00459                           famistudio_sfx_base_addr:  .dsb (FAMISTUDIO_CFG_SFX_STREAMS * FAMISTUDIO_SFX_STRUCT_SIZE)
00468                           
00468                           famistudio_sfx_repeat = famistudio_sfx_base_addr + 0
00468                           famistudio_sfx_ptr_lo = famistudio_sfx_base_addr + 1
00468                           famistudio_sfx_ptr_hi = famistudio_sfx_base_addr + 2
00468                           famistudio_sfx_offset = famistudio_sfx_base_addr + 3
00468                           famistudio_sfx_buffer = famistudio_sfx_base_addr + 4
00468                           .ende
0A020                           .endif
0A020                           
0A020                           .else
