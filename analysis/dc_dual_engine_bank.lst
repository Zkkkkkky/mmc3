                                ; Second FamiStudio music/SFX engine for the expanded dual-engine DC.nes.
                                ; Logical CPU range: $A000-$BFFF, mapped as Mapper 194 PRG bank $64.
                                
                                    .fillvalue $00
                                    .base $a000
0A000                           
0A000                           dc_dual_init:
0A000 4C 20 A0                      jmp famistudio_init
0A003                           dc_dual_play:
0A003 4C B8 A0                      jmp famistudio_music_play
0A006                           dc_dual_stop:
0A006 4C 64 A0                      jmp famistudio_music_stop
0A009                           dc_dual_update:
0A009 4C 68 A1                      jmp famistudio_update
0A00C                           dc_dual_sfx_init:
0A00C 4C 3D A5                      jmp famistudio_sfx_init
0A00F                           dc_dual_sfx_play:
0A00F 4C 66 A5                      jmp famistudio_sfx_play
0A012                           
0A012                           ; Commands $9D-$9F select these three banks. Each bank contains one song.
0A012                           dc_dual_data_banks:
0A012 61 62 63 44                   db $61, $62, $63, "D"
0A016                           
0A016                           FAMISTUDIO_CFG_EXTERNAL       = 1
0A016                           FAMISTUDIO_CFG_NTSC_SUPPORT   = 1
0A016                           FAMISTUDIO_CFG_DPCM_SUPPORT   = 0
0A016                           FAMISTUDIO_CFG_SFX_SUPPORT    = 1
0A016                           FAMISTUDIO_CFG_SFX_STREAMS    = 1
0A016                           FAMISTUDIO_USE_VOLUME_TRACK   = 1
0A016                           FAMISTUDIO_USE_PITCH_TRACK    = 1
0A016                           FAMISTUDIO_CFG_SCATTERED_BSS  = 1
0A016                           FAMISTUDIO_CFG_DC_COMPACT_BSS = 1
0A016                           FAMISTUDIO_CFG_DC_FIXED_MUSIC_BASE = 1
0A016                           FAMISTUDIO_CFG_DC_FIXED_SFX_TABLE  = 1
0A016                           
0A016                           ; Both engines reuse the stock driver's certified RAM, but never update in
0A016                           ; the same frame.  FamiStudio owns it only while a custom song is active;
0A016                           ; the stock engine is fully reset before a stock command is replayed.
0A016                           FAMISTUDIO_ASM6_ZP_ENUM       = $0000
0A016                           FAMISTUDIO_ASM6_BSS_ENUM      = $0500
0A016                           FAMISTUDIO_ASM6_CODE_BASE     = $a020
0A016                           
0A016 00 00 00 00 00 00 00 00..     .dsb $0a, $00
0A020                               .include "famistudio_asm6_granzon.asm"
0A020                           ;======================================================================================================================
0A020                           ; FAMISTUDIO SOUND ENGINE (4.5.0)
0A020                           ; Copyright (c) 2019-2026 Mathieu Gauthier
0A020                           ;
0A020                           ; Copying and distribution of this file, with or without
0A020                           ; modification, are permitted in any medium without royalty provided
0A020                           ; the copyright notice and this notice are preserved in all source
0A020                           ; code copies. This file is offered as-is, without any warranty.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; This is the FamiStudio sound engine. It is used by the NSF and ROM exporter of FamiStudio and can be used to make 
0A020                           ; games. It supports every feature from FamiStudio, some of them are toggeable to save CPU/memory.
0A020                           ;
0A020                           ; This is essentially a heavily modified version of FamiTone2 by Shiru. A lot of his code and comments are still
0A020                           ; present here, so massive thanks to him!! I am not trying to steal his work or anything, i renamed a lot of functions
0A020                           ; and variables because at some point it was becoming a mess of coding standards and getting hard to maintain.
0A020                           ;
0A020                           ; Moderately advanced users can probably figure out how to use the sound engine simply by reading these comments.
0A020                           ; For more in-depth documentation, please go to:
0A020                           ;
0A020                           ;    https://famistudio.org/doc/soundengine/
0A020                           ;======================================================================================================================
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; INTERFACE
0A020                           ;
0A020                           ; The interface is pretty much the same as FamiTone2, with a slightly different naming convention. The subroutines you
0A020                           ; can call from your game are: 
0A020                           ;
0A020                           ;   - famistudio_init            : Initialize the engine with some music data.
0A020                           ;   - famistudio_music_play      : Start music playback with a specific song.
0A020                           ;   - famistudio_music_pause     : Pause/unpause music playback.
0A020                           ;   - famistudio_music_stop      : Stops music playback.
0A020                           ;   - famistudio_sfx_init        : Initialize SFX engine with SFX data.
0A020                           ;   - famistudio_sfx_play        : Play a SFX.
0A020                           ;   - famistudio_sfx_sample_play : Play a DPCM SFX.
0A020                           ;   - famistudio_update          : Updates the music/SFX engine, call once per frame, ideally from NMI.
0A020                           ;
0A020                           ; You can check the demo ROM to see how they are used or check out the online documentation for more info.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; CONFIGURATION
0A020                           ;
0A020                           ; There are 2 main ways of configuring the engine. 
0A020                           ;
0A020                           ;   1) The simplest way is right here, in the section below. Simply comment/uncomment these defines, and move on 
0A020                           ;      with your life.
0A020                           ;
0A020                           ;   2) The second way is "externally", using definitions coming from elsewhere in your app or the command line. If you
0A020                           ;      wish do so, simply define FAMISTUDIO_CFG_EXTERNAL=1 and this whole section will be ignored. You are then 
0A020                           ;      responsible for providing all configuration. This is useful if you have multiple projects that needs 
0A020                           ;      different configurations, while pointing to the same code file. This is how the provided demos and FamiStudio
0A020                           ;      uses it.
0A020                           ;
0A020                           ; Note that unless specified, the engine uses "if" and not "ifdef" for all boolean values so you need to define these
0A020                           ; to non-zero values. Undefined values will be assumed to be zero.
0A020                           ;
0A020                           ; There are 4 main things to configure, each of them will be detailed below.
0A020                           ;
0A020                           ;   1) Segments (ZP/RAM/PRG)
0A020                           ;   2) Audio expansion
0A020                           ;   3) Global engine parameters
0A020                           ;   4) Supported features
0A020                           ;======================================================================================================================
0A020                           
0A020                           .ifndef FAMISTUDIO_CFG_EXTERNAL 
0A020                               FAMISTUDIO_CFG_EXTERNAL = 0
0A020                           .endif
0A020                           
0A020                           ; Set this to configure the sound engine from outside (in your app, or from the command line)
0A020                           .if !FAMISTUDIO_CFG_EXTERNAL
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; 1) SEGMENT CONFIGURATION
0A020                           ;
0A020                           ; You need to tell where you want to allocate the zeropage, RAM and code. This section will be slightly different for
0A020                           ; each assembler.
0A020                           ;
0A020                           ; For ASM6, you need to specify the .enum location for zeroage and RAM/BSS as well as the .org for the engine code.
0A020                           ;======================================================================================================================
0A020                           
0A020                           FAMISTUDIO_ASM6_ZP_ENUM   = $0000
0A020                           FAMISTUDIO_ASM6_BSS_ENUM  = $0200
0A020                           FAMISTUDIO_ASM6_CODE_BASE = $8000
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; 2) AUDIO EXPANSION CONFIGURATION
0A020                           ;
0A020                           ; You can enable up to one audio expansion (FAMISTUDIO_EXP_XXX). Enabling more than one expansion will lead to
0A020                           ; undefined behavior. Memory usage goes up as more complex expansions are used. The audio expansion you choose
0A020                           ; **MUST MATCH** with the data you will load in the engine. Loading a FDS song while enabling VRC6 will lead to
0A020                           ; undefined behavior.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ; Konami VRC6 (2 extra square + saw)
0A020                           ; FAMISTUDIO_EXP_VRC6          = 1 
0A020                           
0A020                           ; Rainbow-Net (homebrew clone of VRC6)
0A020                           ; FAMISTUDIO_EXP_RAINBOW       = 1
0A020                           
0A020                           ; Konami VRC7 (6 FM channels)
0A020                           ; FAMISTUDIO_EXP_VRC7          = 1 
0A020                           
0A020                           ; Nintendo MMC5 (2 extra squares, extra DPCM not supported)
0A020                           ; FAMISTUDIO_EXP_MMC5          = 1 
0A020                           
0A020                           ; Sunsoft S5B (2 extra squares, advanced features not supported.)
0A020                           ; FAMISTUDIO_EXP_S5B           = 1 
0A020                           
0A020                           ; Famicom Disk System (extra wavetable channel)
0A020                           ; FAMISTUDIO_EXP_FDS           = 1 
0A020                           
0A020                           ; Namco 163 (between 1 and 8 extra wavetable channels) + number of channels.
0A020                           ; FAMISTUDIO_EXP_N163          = 1 
0A020                           ; FAMISTUDIO_EXP_N163_CHN_CNT  = 4
0A020                           
0A020                           ; EPSM (Expansion Port Sound Module)
0A020                           ; FAMISTUDIO_EXP_EPSM          = 1
0A020                           ; Fine-tune control for enabling specific channels
0A020                           ; Default values for the channels are to enable all channels.
0A020                           ; FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT     = 3
0A020                           ; FAMISTUDIO_EXP_EPSM_FM_CHN_CNT      = 6
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN1_ENABLE = 1
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN2_ENABLE = 1
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN3_ENABLE = 1
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN4_ENABLE = 1
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN5_ENABLE = 1
0A020                           ; FAMISTUDIO_EXP_EPSM_RHYTHM_CHN6_ENABLE = 1
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; 3) GLOBAL ENGINE CONFIGURATION
0A020                           ;
0A020                           ; These are parameters that configures the engine, but are independent of the data you will be importing, such as
0A020                           ; which platform (PAL/NTSC) you want to support playback for, whether SFX are enabled or not, etc. They all have the
0A020                           ; form FAMISTUDIO_CFG_XXX.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ; One of these MUST be defined (PAL or NTSC playback). Note that only NTSC support is supported when using any of the audio expansions.
0A020                           ; FAMISTUDIO_CFG_PAL_SUPPORT   = 1
0A020                           FAMISTUDIO_CFG_NTSC_SUPPORT  = 1
0A020                           
0A020                           ; Support for sound effects playback + number of SFX that can play at once.
0A020                           ; FAMISTUDIO_CFG_SFX_SUPPORT   = 1
0A020                           ; FAMISTUDIO_CFG_SFX_STREAMS   = 2
0A020                           
0A020                           ; Blaarg's smooth vibrato technique. Eliminates phase resets ("pops") on square channels. 
0A020                           ; FAMISTUDIO_CFG_SMOOTH_VIBRATO = 1
0A020                           
0A020                           ; Enables DPCM playback support.
0A020                           FAMISTUDIO_CFG_DPCM_SUPPORT   = 1
0A020                           
0A020                           ; Must be enabled if you are calling sound effects from a different thread than the sound engine update.
0A020                           ; FAMISTUDIO_CFG_THREAD         = 1
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; 4) SUPPORTED FEATURES CONFIGURATION
0A020                           ;
0A020                           ; Every feature supported in FamiStudio is supported by this sound engine. If you know for sure that you are not using
0A020                           ; specific features in your music, you can disable them to save memory/processing time. Using a feature in your song
0A020                           ; and failing to enable it will likely lead to crashes (BRK), or undefined behavior. They all have the form
0A020                           ; FAMISTUDIO_USE_XXX.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ; Must be enabled if the songs you will be importing have been created using FamiTracker tempo mode. If you are using
0A020                           ; FamiStudio tempo mode, this must be undefined. You cannot mix and match tempo modes, the engine can only run in one
0A020                           ; mode or the other. 
0A020                           ; More information at: https://famistudio.org/doc/song/#tempo-modes
0A020                           ; FAMISTUDIO_USE_FAMITRACKER_TEMPO = 1
0A020                           
0A020                           ; Must be enabled if the songs uses delayed notes or delayed cuts. This is obviously only available when using
0A020                           ; FamiTracker tempo mode as FamiStudio tempo mode does not need this.
0A020                           ; FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS = 1
0A020                           
0A020                           ; Must be enabled if the songs uses release notes. 
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#release-point
0A020                           FAMISTUDIO_USE_RELEASE_NOTES = 1
0A020                           
0A020                           ; Must be enabled if any song uses the volume track. The volume track allows manipulating the volume at the track level
0A020                           ; independently from instruments.
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#editing-volume-tracks-effects
0A020                           FAMISTUDIO_USE_VOLUME_TRACK      = 1
0A020                           
0A020                           ; Must be enabled if any song uses slides on the volume track. Volume track must be enabled too.
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#editing-volume-tracks-effects
0A020                           ; FAMISTUDIO_USE_VOLUME_SLIDES     = 1
0A020                           
0A020                           ; Must be enabled if any song uses the pitch track. The pitch track allows manipulating the pitch at the track level
0A020                           ; independently from instruments.
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#pitch
0A020                           FAMISTUDIO_USE_PITCH_TRACK       = 1
0A020                           
0A020                           ; Must be enabled if any song uses slide notes. Slide notes allows portamento and slide effects.
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#slide-notes
0A020                           FAMISTUDIO_USE_SLIDE_NOTES       = 1
0A020                           
0A020                           ; Must be enabled if any song uses slide notes on the noise channel too. 
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#slide-notes
0A020                           ; FAMISTUDIO_USE_NOISE_SLIDE_NOTES = 1
0A020                           
0A020                           ; Must be enabled if any song uses the vibrato speed/depth effect track. 
0A020                           ; More information at: https://famistudio.org/doc/pianoroll/#vibrato-depth-speed
0A020                           FAMISTUDIO_USE_VIBRATO           = 1
0A020                           
0A020                           ; Must be enabled if any song uses arpeggios (not to be confused with instrument arpeggio envelopes, those are always
0A020                           ; supported).
0A020                           ; More information at: (TODO)
0A020                           FAMISTUDIO_USE_ARPEGGIO          = 1
0A020                           
0A020                           ; Must be enabled if any song uses the "Duty Cycle" effect (equivalent of FamiTracker Vxx, also called "Timbre").  
0A020                           ; FAMISTUDIO_USE_DUTYCYCLE_EFFECT  = 1
0A020                           
0A020                           ; Must be enabled if any song uses the DPCM delta counter. Only makes sense if DPCM samples
0A020                           ; are enabled (FAMISTUDIO_CFG_DPCM_SUPPORT).
0A020                           ; More information at: (TODO)
0A020                           ; FAMISTUDIO_USE_DELTA_COUNTER     = 1
0A020                           
0A020                           ; Must be enabled if your project uses more than 1 bank of DPCM samples.
0A020                           ; When using this, you must implement the "famistudio_dpcm_bank_callback" callback 
0A020                           ; and switch to the correct bank every time a sample is played.
0A020                           ; FAMISTUDIO_USE_DPCM_BANKSWITCHING = 1
0A020                           
0A020                           ; Must be enabled if your project uses more than 63 unique DPCM mappings (a mapping is DPCM sample
0A020                           ; assigned to a note, with a specific pitch/loop, etc.). Implied when using FAMISTUDIO_USE_DPCM_BANKSWITCHING.
0A020                           ; FAMISTUDIO_USE_DPCM_EXTENDED_RANGE = 1
0A020                           
0A020                           ; Allows having up to 256 instrument at the cost of slightly higher CPU usage when switching instrument.
0A020                           ; When this is off, the limit is 64 for regular instruments and 32 for expansion instrumnets.
0A020                           ; FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE = 1
0A020                           
0A020                           ; Must be enabled if your project uses the "Phase Reset" effect.
0A020                           ; FAMISTUDIO_USE_PHASE_RESET = 1
0A020                           
0A020                           ; Must be enabled if your project uses the FDS expansion and at least one instrument with FDS Auto-Mod enabled.
0A020                           ; FAMISTUDIO_USE_FDS_AUTOMOD  = 1
0A020                           
0A020                           .endif
0A020                           
0A020                           ; Memory location of the DPCM samples. Must be between $c000 and $ffc0, and a multiple of 64.
0A020                           .ifndef FAMISTUDIO_DPCM_OFF
0A020                               FAMISTUDIO_DPCM_OFF = $c000
0A020                           .endif
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; END OF CONFIGURATION
0A020                           ;
0A020                           ; Ideally, you should not have to change anything below this line.
0A020                           ;======================================================================================================================
0A020                           
0A020                           ;======================================================================================================================
0A020                           ; INTERNAL DEFINES (Do not touch)
0A020                           ;======================================================================================================================
0A020                           
