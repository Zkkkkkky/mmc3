0A537                           ; FAMISTUDIO_SAMPLE_STOP (internal)
0A537                           ;
0A537                           ; Stop DPCM sample if it plays
0A537                           ;
0A537                           ; [in] no input params.
0A537                           ;======================================================================================================================
0A537                           
0A537                           famistudio_sample_stop:
0A537                           
0A537 A9 0F                         lda #%00001111
0A539 8D 15 40                      sta FAMISTUDIO_APU_SND_CHN
0A53C 60                            rts
