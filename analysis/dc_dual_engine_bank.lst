0A020                           famistudio_sfx_addr_lo:    .dsb 1
0A020                           famistudio_sfx_addr_hi:    .dsb 1
0A020                           famistudio_sfx_base_addr:  .dsb (FAMISTUDIO_CFG_SFX_STREAMS * FAMISTUDIO_SFX_STRUCT_SIZE)
0A020                           
0A020                           ; TODO: Refactor SFX memory layout. These uses a AoS approach, not a fan. 
0A020                           famistudio_sfx_repeat = famistudio_sfx_base_addr + 0
0A020                           famistudio_sfx_ptr_lo = famistudio_sfx_base_addr + 1
0A020                           famistudio_sfx_ptr_hi = famistudio_sfx_base_addr + 2
0A020                           famistudio_sfx_offset = famistudio_sfx_base_addr + 3
0A020                           famistudio_sfx_buffer = famistudio_sfx_base_addr + 4
0A020                           
0A020                           .endif 
0A020                           
0A020                           .ende
0A020                           
0A020                           .endif
