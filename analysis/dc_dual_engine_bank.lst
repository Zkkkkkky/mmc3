0A50C                               cpx #3
0A50C                               beq @noise_slide
0A50C                           .endif
0A50C                               lda famistudio_channel_to_slide,x
0A50C                               tax
0A50C                               lda (channel_data_ptr),y ; Read slide step size
0A50C                               iny
