0A53D                           
0A53D                           .if FAMISTUDIO_USE_DPCM_BANKSWITCHING || FAMISTUDIO_USE_DPCM_EXTENDED_RANGE
0A53D                               ; famistudio_dpcm_list + sample number * (4 or 5)
0A53D                               sta sample_index
0A53D                               ldy #0
0A53D                               sty sample_data_ptr+1
0A53D                               asl
0A53D                               rol sample_data_ptr+1
0A53D                               asl 
0A53D                               rol sample_data_ptr+1 ; Will clear carry
0A53D                           .if FAMISTUDIO_USE_DPCM_BANKSWITCHING
0A53D                               ; Multiply by 5 instead of 4.
0A53D                               adc sample_index
0A53D                               bcc add_list_ptr
0A53D                                   inc sample_data_ptr+1 
0A53D                                   clc
0A53D                               add_list_ptr:
0A53D                           .endif
0A53D                                   adc famistudio_dpcm_list_lo
0A53D                                   sta sample_data_ptr+0
0A53D                                   lda sample_data_ptr+1
0A53D                                   adc famistudio_dpcm_list_hi
0A53D                                   sta sample_data_ptr+1    
0A53D                           .else
0A53D                               asl ; Sample number * 4, offset in the sample table
0A53D                               asl ; Carry should be clear now, we dont allow more than 63 sample mappings.
0A53D                               adc famistudio_dpcm_list_lo
0A53D                               sta sample_data_ptr+0
0A53D                               lda #0
0A53D                               adc famistudio_dpcm_list_hi
0A53D                               sta sample_data_ptr+1
0A53D                           .endif
0A53D                           
0A53D                           stop_dpcm:
0A53D                               lda #%00001111 ; Stop DPCM
0A53D                               sta FAMISTUDIO_APU_SND_CHN
0A53D                           
0A53D                               ldy #0
0A53D                               lda (sample_data_ptr),y ; Sample offset
0A53D                               sta FAMISTUDIO_APU_DMC_START
0A53D                               iny
0A53D                               lda (sample_data_ptr),y ; Sample length
0A53D                               sta FAMISTUDIO_APU_DMC_LEN
0A53D                               iny
0A53D                               lda (sample_data_ptr),y ; Pitch and loop
0A53D                               sta FAMISTUDIO_APU_DMC_FREQ
0A53D                               iny
0A53D                           
0A53D                           .if FAMISTUDIO_USE_DELTA_COUNTER
0A53D                               lda famistudio_dmc_delta_counter
0A53D                               bmi read_dmc_initial_value
0A53D                               sta FAMISTUDIO_APU_DMC_RAW
0A53D                               lda #$ff
0A53D                               sta famistudio_dmc_delta_counter
0A53D                               bmi start_dmc
0A53D                           read_dmc_initial_value:
0A53D                           .endif    
0A53D                           
0A53D                               bit update_flags
0A53D                               bmi start_dmc
0A53D                               lda (sample_data_ptr),y ; Initial DMC counter
0A53D                               sta FAMISTUDIO_APU_DMC_RAW
0A53D                           
0A53D                           start_dmc:
0A53D                           .if FAMISTUDIO_USE_DPCM_BANKSWITCHING
0A53D                               iny
0A53D                               lda (sample_data_ptr),y ; Bank number
0A53D                               jsr famistudio_dpcm_bank_callback
0A53D                           .endif
0A53D                           
0A53D                               lda #%00011111 ; Start DMC
0A53D                               sta FAMISTUDIO_APU_SND_CHN
0A53D                           
0A53D                               rts
0A53D                           
0A53D                           ;======================================================================================================================
0A53D                           ; FAMISTUDIO_SAMPLE_PLAY_MUSIC (internal)
0A53D                           ;
0A53D                           ; Play DPCM sample, used by music player, could be used externally. Samples played for music have lower priority than
0A53D                           ; samples played by SFX.
0A53D                           ;
0A53D                           ; [in] a: Sample index, 1...63.
0A53D                           ;======================================================================================================================
0A53D                           
0A53D                           famistudio_music_sample_play:
0A53D                           
0A53D                               ldx famistudio_dpcm_effect
0A53D                               beq sample_play
0A53D                               tax
0A53D                               lda FAMISTUDIO_APU_SND_CHN
0A53D                               and #16
0A53D                               beq @not_busy
0A53D                               rts
0A53D                           
0A53D                           @not_busy:
0A53D                               sta famistudio_dpcm_effect
0A53D                               txa
0A53D                               jmp sample_play
0A53D                           
0A53D                           .endif
0A53D                           
0A53D                           .if FAMISTUDIO_CFG_SFX_SUPPORT
0A53D                           
0A53D                           ;======================================================================================================================
0A53D                           ; FAMISTUDIO_SFX_INIT (public)
0A53D                           ;
0A53D                           ; Initialize the sound effect player.
0A53D                           ;
0A53D                           ; [in] x: Sound effect data pointer (lo)
0A53D                           ; [in] y: Sound effect data pointer (hi)
0A53D                           ;======================================================================================================================
0A53D                           
0A53D                           famistudio_sfx_init:
0A53D                           
0A53D                               effect_list_ptr = famistudio_ptr0
0A53D                           
0A53D                           .ifndef FAMISTUDIO_CFG_DC_FIXED_SFX_TABLE
0A53D                               stx effect_list_ptr+0
0A53D                               sty effect_list_ptr+1
0A53D                               
0A53D                               ldy #0
0A53D                               
0A53D                           .if FAMISTUDIO_DUAL_SUPPORT
0A53D                               lda famistudio_pal_adjust ; Add 2 to the sound list pointer for PAL
0A53D                               bne @ntsc
0A53D                               iny
0A53D                               iny
0A53D                           @ntsc:
0A53D                           .endif
0A53D                               
0A53D                               lda (effect_list_ptr),y 
0A53D                               sta famistudio_sfx_addr_lo
0A53D                               iny
0A53D                               lda (effect_list_ptr),y
0A53D                               sta famistudio_sfx_addr_hi
0A53D                           .endif
0A53D                           
0A53D A2 00                         ldx #FAMISTUDIO_SFX_CH0 
0A53F                           
0A53F                           @set_channels:
0A53F 20 4C A5                      jsr famistudio_sfx_clear_channel
0A542 8A                            txa
0A543 18                            clc
0A544 69 0F                         adc #FAMISTUDIO_SFX_STRUCT_SIZE
0A546 AA                            tax
0A547 E0 0F                         cpx #FAMISTUDIO_SFX_STRUCT_SIZE*FAMISTUDIO_CFG_SFX_STREAMS
0A549 D0 F4                         bne @set_channels
0A54B                           
0A54B 60                            rts
0A54C                           
0A54C                           ;======================================================================================================================
0A54C                           ; FAMISTUDIO_SFX_CLEAR_CHANNEL (internal)
0A54C                           ;
0A54C                           ; Clears output buffer of a sound effect.
0A54C                           ;
0A54C                           ; [in] x: Offset of the sound effect stream.
0A54C                           ;======================================================================================================================
0A54C                           
0A54C                           famistudio_sfx_clear_channel:
0A54C                           
0A54C A9 00                         lda #0
0A54E 9D 5B 04                      sta famistudio_sfx_ptr_hi,x   ; This stops the effect
0A551 9D 59 04                      sta famistudio_sfx_repeat,x
0A554 9D 5C 04                      sta famistudio_sfx_offset,x
0A557 9D 63 04                      sta famistudio_sfx_buffer+6,x ; Mute triangle
0A55A A9 30                         lda #$30
0A55C 9D 5D 04                      sta famistudio_sfx_buffer+0,x ; Mute pulse1
0A55F 9D 60 04                      sta famistudio_sfx_buffer+3,x ; Mute pulse2
0A562 9D 66 04                      sta famistudio_sfx_buffer+9,x ; Mute noise
0A565 60                            rts
0A566                           
0A566                           ;======================================================================================================================
0A566                           ; FAMISTUDIO_SFX_PLAY (public)
0A566                           ;
0A566                           ; Plays a sound effect.
0A566                           ;
0A566                           ; [in] a: Sound effect index (0...127)
0A566                           ; [in] x: Offset of sound effect channel, should be FAMISTUDIO_SFX_CH0..FAMISTUDIO_SFX_CH3
0A566                           ;======================================================================================================================
0A566                           
0A566                           famistudio_sfx_play:
0A566                           
0A566                               effect_data_ptr = famistudio_ptr0
0A566                           
0A566 0A                            asl a
0A567 A8                            tay
0A568                           
0A568 20 4C A5                      jsr famistudio_sfx_clear_channel ; Stops the effect if it plays
0A56B                           
0A56B                           .ifdef FAMISTUDIO_CFG_DC_FIXED_SFX_TABLE
0A56B A9 22                         lda #<dc_sfx_table
0A56D 85 2D                         sta effect_data_ptr+0
0A56F A9 A8                         lda #>dc_sfx_table
0A571 85 2E                         sta effect_data_ptr+1
0A573                           .else
0A573                               lda famistudio_sfx_addr_lo
0A573                               sta effect_data_ptr+0
0A573                               lda famistudio_sfx_addr_hi
0A573                               sta effect_data_ptr+1
0A573                           .endif
0A573                           
0A573 B1 2D                         lda (effect_data_ptr),y
0A575 9D 5A 04                      sta famistudio_sfx_ptr_lo,x
0A578 C8                            iny
0A579 B1 2D                         lda (effect_data_ptr),y
0A57B 9D 5B 04                      sta famistudio_sfx_ptr_hi,x ; This write enables the effect
0A57E                           
0A57E 60                            rts
0A57F                           
0A57F                           ;======================================================================================================================
0A57F                           ; FAMISTUDIO_SFX_UPDATE (internal)
0A57F                           ;
0A57F                           ; Updates a single sound effect stream.
0A57F                           ;
0A57F                           ; [in] x: Offset of sound effect channel, should be FAMISTUDIO_SFX_CH0..FAMISTUDIO_SFX_CH3
0A57F                           ;======================================================================================================================
0A57F                           
0A57F                           famistudio_sfx_update:
0A57F                           
0A57F                               tmp = famistudio_r0
0A57F                               tmpx = famistudio_r1
0A57F                               effect_data_ptr = famistudio_ptr0
0A57F                           
0A57F BD 59 04                      lda famistudio_sfx_repeat,x ; Check if repeat counter is not zero
0A582 F0 05                         beq @no_repeat
0A584 DE 59 04                      dec famistudio_sfx_repeat,x ; Decrement and return
0A587 D0 4B                         bne @update_buf ; Just mix with output buffer
0A589                           
0A589                           @no_repeat:
0A589 BD 5B 04                      lda famistudio_sfx_ptr_hi,x ; Check if MSB of the pointer is not zero
0A58C D0 01                         bne @sfx_active
0A58E 60                            rts ; Return otherwise, no active effect
0A58F                           
0A58F                           @sfx_active:
0A58F 85 2E                         sta effect_data_ptr+1         ;load effect pointer into temp
0A591 BD 5A 04                      lda famistudio_sfx_ptr_lo,x
0A594 85 2D                         sta effect_data_ptr+0
0A596 BC 5C 04                      ldy famistudio_sfx_offset,x
0A599 18                            clc
0A59A                           
0A59A                           @read_byte:
0A59A B1 2D                         lda (effect_data_ptr),y ; Read byte of effect
0A59C 30 12                         bmi @get_data ; If bit 7 is set, it is a register write
0A59E F0 31                         beq @eof
0A5A0 C8                            iny
0A5A1 D0 03                         bne @store_repeat
0A5A3 20 3B A6                      jsr @inc_sfx
0A5A6                           @store_repeat:
0A5A6 9D 59 04                      sta famistudio_sfx_repeat,x ; If bit 7 is reset, it is number of repeats
0A5A9 98                            tya
0A5AA 9D 5C 04                      sta famistudio_sfx_offset,x
0A5AD 4C D4 A5                      jmp @update_buf
0A5B0                           
0A5B0                           @get_data:
0A5B0 C8                            iny
0A5B1 D0 03                         bne @get_data2
0A5B3 20 3B A6                      jsr @inc_sfx
0A5B6                           @get_data2:
0A5B6 86 28                         stx tmp ; It is a register write
0A5B8 65 28                         adc tmp ; Get offset in the effect output buffer
0A5BA AA                            tax
0A5BB B1 2D                         lda (effect_data_ptr),y
0A5BD C8                            iny
0A5BE D0 09                         bne @write_buffer
0A5C0 86 29                         stx tmpx
0A5C2 A6 28                         ldx tmp
0A5C4 20 3B A6                      jsr @inc_sfx
0A5C7 A6 29                         ldx tmpx
0A5C9                           @write_buffer:
0A5C9 9D DD 03                      sta famistudio_sfx_buffer-128,x
0A5CC A6 28                         ldx tmp
0A5CE 4C 9A A5                      jmp @read_byte 
0A5D1                           
0A5D1                           @eof:
0A5D1 9D 5B 04                      sta famistudio_sfx_ptr_hi,x ; Mark channel as inactive
0A5D4                           
0A5D4                           @update_buf:
0A5D4 A5 4C                         lda famistudio_output_buf ; Compare effect output buffer with main output buffer
0A5D6 29 0F                         and #$0f ; If volume of pulse 1 of effect is higher than that of the main buffer, overwrite the main buffer value with the new one
0A5D8 85 28                         sta tmp 
0A5DA BD 5D 04                      lda famistudio_sfx_buffer+0,x
0A5DD 29 0F                         and #$0f
0A5DF C5 28                         cmp tmp
0A5E1 90 0F                         bcc @no_pulse1
0A5E3 BD 5D 04                      lda famistudio_sfx_buffer+0,x
0A5E6 85 4C                         sta famistudio_output_buf+0
0A5E8 BD 5E 04                      lda famistudio_sfx_buffer+1,x
0A5EB 85 4D                         sta famistudio_output_buf+1
0A5ED BD 5F 04                      lda famistudio_sfx_buffer+2,x
0A5F0 85 4E                         sta famistudio_output_buf+2
0A5F2                           
0A5F2                           @no_pulse1:
0A5F2 A5 4F                         lda famistudio_output_buf+3
0A5F4 29 0F                         and #$0f
0A5F6 85 28                         sta tmp
0A5F8 BD 60 04                      lda famistudio_sfx_buffer+3,x
0A5FB 29 0F                         and #$0f
0A5FD C5 28                         cmp tmp
0A5FF 90 0F                         bcc @no_pulse2
0A601 BD 60 04                      lda famistudio_sfx_buffer+3,x
0A604 85 4F                         sta famistudio_output_buf+3
0A606 BD 61 04                      lda famistudio_sfx_buffer+4,x
0A609 85 50                         sta famistudio_output_buf+4
0A60B BD 62 04                      lda famistudio_sfx_buffer+5,x
0A60E 85 51                         sta famistudio_output_buf+5
0A610                           
0A610                           @no_pulse2:
0A610 BD 63 04                      lda famistudio_sfx_buffer+6,x ; Overwrite triangle of main output buffer if it is active
0A613 F0 0C                         beq @no_triangle
0A615 85 52                         sta famistudio_output_buf+6
0A617 BD 64 04                      lda famistudio_sfx_buffer+7,x
0A61A 85 53                         sta famistudio_output_buf+7
0A61C BD 65 04                      lda famistudio_sfx_buffer+8,x
0A61F 85 54                         sta famistudio_output_buf+8
0A621                           
0A621                           @no_triangle:
0A621 A5 55                         lda famistudio_output_buf+9
0A623 29 0F                         and #$0f
0A625 85 28                         sta tmp
0A627 BD 66 04                      lda famistudio_sfx_buffer+9,x
0A62A 29 0F                         and #$0f
0A62C C5 28                         cmp tmp
0A62E 90 0A                         bcc @no_noise
0A630 BD 66 04                      lda famistudio_sfx_buffer+9,x
0A633 85 55                         sta famistudio_output_buf+9
0A635 BD 67 04                      lda famistudio_sfx_buffer+10,x
0A638 85 56                         sta famistudio_output_buf+10
0A63A                           
0A63A                           @no_noise:
0A63A 60                            rts
0A63B                           
0A63B                           @inc_sfx:
0A63B E6 2E                         inc effect_data_ptr+1
0A63D FE 5B 04                      inc famistudio_sfx_ptr_hi,x
0A640 60                            rts
0A641                           
0A641                           .endif
