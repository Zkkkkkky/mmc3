0A020                           famistudio_r2:   .dsb 1
0A020                           famistudio_r3:   .dsb 1
0A020                           
0A020                           famistudio_ptr0: .dsb 2
0A020                           famistudio_ptr1: .dsb 2
0A020                           .if FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_S5B
0A020                           famistudio_ptr2: .dsb 2
0A020                           .endif
0A020                           .ende
0A020                           .endif
