0A020                           ;======================================================================================================================
0A020                           ; FAMISTUDIO_INIT (public)
0A020                           ;
0A020                           ; Reset APU, initialize the sound engine with some music data.
0A020                           ; 
0A020                           ; [in] a : Playback platform, zero for PAL, non-zero for NTSC.
0A020                           ; [in] x : Pointer to music data (lo)
0A020                           ; [in] y : Pointer to music data (hi)
0A020                           ;======================================================================================================================
0A020                           
0A020                           famistudio_init:
0A020                               
0A020                               music_data_ptr = famistudio_ptr0
0A020                           
0A020                           .ifndef FAMISTUDIO_CFG_DC_FIXED_MUSIC_BASE
0A020                               stx famistudio_song_list_lo
0A020                               sty famistudio_song_list_hi
0A020                           .endif
0A020 86 2D                         stx music_data_ptr+0
0A022 84 2E                         sty music_data_ptr+1
0A024                           
0A024                           .if FAMISTUDIO_DUAL_SUPPORT
0A024                               tax
0A024                               beq @pal
0A024                               lda #97
0A024                           @pal:
0A024                           .else
0A024                               .if FAMISTUDIO_CFG_PAL_SUPPORT
0A024                                   lda #0
0A024                               .endif
0A024                               .if FAMISTUDIO_CFG_NTSC_SUPPORT
0A024 A9 61                             lda #97
0A026                               .endif
0A026                           .endif
0A026                           .ifndef FAMISTUDIO_CFG_DC_COMPACT_BSS
0A026                               sta famistudio_pal_adjust
0A026                           .endif
0A026                           
0A026 20 64 A0                      jsr famistudio_music_stop
0A029                           
0A029                               ; Instrument address
0A029 A0 01                         ldy #1
0A02B B1 2D                         lda (music_data_ptr),y
0A02D 8D 6C 04                      sta famistudio_instrument_lo
0A030 C8                            iny
0A031 B1 2D                         lda (music_data_ptr),y
0A033 8D 6D 04                      sta famistudio_instrument_hi
0A036 C8                            iny
0A037                           
0A037                               ; Expansions instrument address
0A037                               .if FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_S5B
0A037                                   lda (music_data_ptr),y
0A037                                   sta famistudio_exp_instrument_lo
0A037                                   iny
0A037                                   lda (music_data_ptr),y
0A037                                   sta famistudio_exp_instrument_hi
0A037                                   iny
0A037                               .endif
0A037                           
0A037                               ; Sample list address
0A037                           .if FAMISTUDIO_CFG_DPCM_SUPPORT
0A037                               lda (music_data_ptr),y
0A037                               sta famistudio_dpcm_list_lo
0A037                               iny
0A037                               lda (music_data_ptr),y
0A037                               sta famistudio_dpcm_list_hi
0A037                           .endif
0A037                           
0A037 A9 80                         lda #$80 ; Previous pulse period MSB, to not write it when not changed
0A039 8D 6E 04                      sta famistudio_pulse1_prev
0A03C 8D 6F 04                      sta famistudio_pulse2_prev
0A03F                           
0A03F A9 0F                         lda #$0f ; Enable channels, stop DMC
0A041 8D 15 40                      sta FAMISTUDIO_APU_SND_CHN
0A044 A9 80                         lda #$80 ; Disable triangle length counter
0A046 8D 08 40                      sta FAMISTUDIO_APU_TRI_LINEAR
0A049 A9 00                         lda #$00 ; Load noise length
0A04B 8D 0F 40                      sta FAMISTUDIO_APU_NOISE_HI
0A04E                           
0A04E A9 30                         lda #$30 ; Volumes to 0
0A050 8D 00 40                      sta FAMISTUDIO_APU_PL1_VOL
0A053 8D 04 40                      sta FAMISTUDIO_APU_PL2_VOL
0A056 8D 0C 40                      sta FAMISTUDIO_APU_NOISE_VOL
0A059 A9 08                         lda #$08 ; No sweep
0A05B 8D 01 40                      sta FAMISTUDIO_APU_PL1_SWEEP
0A05E 8D 05 40                      sta FAMISTUDIO_APU_PL2_SWEEP
0A061                           
0A061                           .if FAMISTUDIO_EXP_VRC6
0A061                           @init_vrc6:
0A061                               lda #0
0A061                               sta FAMISTUDIO_VRC6_FREQ_CTRL ; NESDEV wiki says to write zero at startup.
0A061                           .endif
0A061                           
0A061                           .if FAMISTUDIO_EXP_VRC7
0A061                           @init_vrc7:
0A061                               lda #0
0A061                               sta FAMISTUDIO_VRC7_SILENCE ; Enable VRC7 audio.
0A061                           .endif
0A061                           
0A061                           @init_epsm:
0A061                           .if FAMISTUDIO_EXP_EPSM
0A061                               lda #FAMISTUDIO_EPSM_REG_TONE
0A061                               sta FAMISTUDIO_EPSM_ADDR
0A061                               lda #$38 ; No noise, just 3 tones for now.
0A061                               sta FAMISTUDIO_EPSM_DATA
0A061                               lda #$29
0A061                               sta FAMISTUDIO_EPSM_ADDR
0A061                               lda #$80 
0A061                               sta FAMISTUDIO_EPSM_DATA
0A061                               lda #$27
0A061                               sta FAMISTUDIO_EPSM_ADDR
0A061                               lda #$00 
0A061                               sta FAMISTUDIO_EPSM_DATA
0A061                               lda #$11
0A061                               sta FAMISTUDIO_EPSM_ADDR
0A061                               lda #$37 
0A061                               sta FAMISTUDIO_EPSM_DATA
0A061                           .endif
0A061                           
0A061                           .if FAMISTUDIO_EXP_MMC5
0A061                           @init_mmc5:
0A061                               lda #$00
0A061                               sta FAMISTUDIO_MMC5_PCM_MODE
0A061                               lda #$03
0A061                               sta FAMISTUDIO_MMC5_SND_CHN
0A061                               lda #$80 ; Previous pulse period MSB, to not write it when not changed
0A061                               sta famistudio_mmc5_pulse1_prev
0A061                               sta famistudio_mmc5_pulse2_prev    
0A061                           .endif
0A061                           
0A061                           .if FAMISTUDIO_EXP_S5B
0A061                           @init_s5b:
0A061                               lda #FAMISTUDIO_S5B_REG_TONE
0A061                               sta FAMISTUDIO_S5B_ADDR
0A061                               lda #$38 ; No noise, just 3 tones for now.
0A061                               sta FAMISTUDIO_S5B_DATA
0A061                           .endif
0A061                           
0A061 4C 64 A0                      jmp famistudio_music_stop
