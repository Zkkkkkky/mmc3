0A35A                           
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_S5B
0A35A                           
0A35A                           famistudio_do_s5b_note_attack:
0A35A                           
0A35A                               chan_idx = famistudio_r0
0A35A                               tmp_y    = famistudio_r1
0A35A                           
0A35A                               ; Reset mixer/noise envelopes.
0A35A                               sty tmp_y
0A35A                               ldy chan_idx
0A35A                               ldx famistudio_channel_env,y
0A35A                               lda #0
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_value+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                               sta famistudio_env_value+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                               ldx chan_idx
0A35A                               ldy tmp_y
0A35A                           
0A35A                               ; Set hi-bit of envelope shape to remember to reset it.
0A35A                               lda #$80
0A35A                               ora famistudio_s5b_chn_env_shape-FAMISTUDIO_S5B_CH0_IDX,x
0A35A                               sta famistudio_s5b_chn_env_shape-FAMISTUDIO_S5B_CH0_IDX,x
0A35A                               rts
0A35A                           
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_FDS
0A35A                           
0A35A                           famistudio_do_fds_note_attack:
0A35A                           
0A35A                               chan_idx = famistudio_r0
0A35A                               tmp_y    = famistudio_r1
0A35A                           
0A35A                               ; TODO : We used to set the modulation value here, but that's bad.
0A35A                               ; https://www.nesdev.org/wiki/FDS_audio#Mod_frequency_high_($4087)
0A35A                               ; lda #$80
0A35A                               ; sta FAMISTUDIO_FDS_MOD_HI
0A35A                               ; lda #0
0A35A                               ; sta FAMISTUDIO_FDS_SWEEP_BIAS
0A35A                           
0A35A                               lda famistudio_fds_mod_delay
0A35A                               sta famistudio_fds_mod_delay_counter
0A35A                           
0A35A                               sty tmp_y
0A35A                               ldy chan_idx
0A35A                               ldx famistudio_channel_env,y
0A35A                               lda #0
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_FDS_WAVE_IDX_OFF,x
0A35A                               lda #1 ; Index 0 is release point, so envelope starts at 1.
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_FDS_WAVE_IDX_OFF,x
0A35A                           
0A35A                               ; Clear wave index to -1 to force reload.
0A35A                               ldx chan_idx
0A35A                               lda #$ff
0A35A                               sta famistudio_fds_wave_index
0A35A                               ldy tmp_y
0A35A                               rts
0A35A                           
0A35A                           .endif
0A35A                           
0A35A                           famistudio_do_note_attack:
0A35A                           
0A35A                               chan_idx = famistudio_r0
0A35A                               tmp_x    = famistudio_r2
0A35A                           
0A35A                           .if FAMISTUDIO_CFG_EQUALIZER 
0A35A                               lda #9
0A35A                               sta famistudio_chn_note_counter,x
0A35A                           .endif
0A35A                           .if FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A35A                               lda chan_idx
0A35A                               cmp #FAMISTUDIO_EPSM_CHAN_RHYTHM_START
0A35A                               bcs @epsm_instrument
0A35A                           .endif
0A35A BD 0C A7                      lda famistudio_channel_env,x
0A35D AA                            tax
0A35E                           
0A35E                               ; Volume envelope.
0A35E A9 01                         lda #1
0A360 9D 35 04                      sta famistudio_env_ptr,x ; Reset volume envelope pointer to 1 (volume have releases point in index 0)
0A363 A9 00                         lda #0
0A365 9D 0B 04                      sta famistudio_env_repeat,x
0A368                           
0A368                               ; Arpeggio envelope
0A368 9D 0C 04                      sta famistudio_env_repeat+FAMISTUDIO_ENV_NOTE_OFF,x
0A36B 9D 36 04                      sta famistudio_env_ptr+FAMISTUDIO_ENV_NOTE_OFF,x
0A36E                           
0A36E                               ; Duty envelope (optional)
0A36E A5 28                         lda chan_idx
0A370 C9 02                         cmp #2 ; Triangle has no duty.
0A372 F0 0B                         beq @no_duty
0A374                           .if FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_S5B || FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_EPSM
0A374                               cmp #5
0A374                               bcs @no_duty
0A374                           .endif
0A374                           @duty:
0A374 A9 00                         lda #0
0A376 9D 0D 04                      sta famistudio_env_repeat+FAMISTUDIO_ENV_DUTY_OFF,x
0A379 9D 37 04                      sta famistudio_env_ptr+FAMISTUDIO_ENV_DUTY_OFF,x
0A37C                               .if FAMISTUDIO_USE_DUTYCYCLE_EFFECT
0A37C                                   stx tmp_x
0A37C                                   ldx chan_idx
0A37C                                   lda famistudio_channel_to_dutycycle,x 
0A37C                                   tax
0A37C                                   lda famistudio_duty_cycle,x
0A37C                                   ldx tmp_x
0A37C                               .endif
0A37C 9D 02 04                      sta famistudio_env_value+FAMISTUDIO_ENV_DUTY_OFF,x
0A37F                           
0A37F                           @no_duty:
0A37F                               ; Pitch envelope
0A37F A6 28                         ldx chan_idx
0A381 BD 11 A7                      lda famistudio_channel_to_pitch_env, x
0A384 30 0F                         bmi @no_pitch
0A386 AA                            tax
0A387                           
0A387                           @reset_pitch_env:
0A387 A9 00                         lda #0
0A389 9D 2C 04                      sta famistudio_pitch_env_value_lo,x
0A38C 9D 2F 04                      sta famistudio_pitch_env_value_hi,x
0A38F 95 3C                         sta famistudio_pitch_env_repeat,x
0A391 A9 01                         lda #1
0A393 95 57                         sta famistudio_pitch_env_ptr,x     ; Reset pitch envelope pointer to 1 (pitch envelope have relative/absolute flag in the first byte) 
0A395                           
0A395                           @no_pitch:
0A395                           
0A395                           .if FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_S5B || FAMISTUDIO_EXP_FDS
0A395                               lda chan_idx
0A395                               cmp #5
0A395                               bcc @done
0A395                               @vrc7_instrument:
0A395                               .if FAMISTUDIO_EXP_VRC7
0A395                                   jmp famistudio_do_vrc7_note_attack
0A395                               .endif
0A395                               @n163_instrument:
0A395                               .if FAMISTUDIO_EXP_N163
0A395                                   jmp famistudio_do_n163_note_attack
0A395                               .endif
0A395                               @s5b_instrument:
0A395                               .if FAMISTUDIO_EXP_S5B
0A395                                   jmp famistudio_do_s5b_note_attack
0A395                               .endif
0A395                               @fds_instrument:
0A395                               .if FAMISTUDIO_EXP_FDS
0A395                                   jmp famistudio_do_fds_note_attack
0A395                               .endif
0A395                               @epsm_instrument:
0A395                               .if FAMISTUDIO_EXP_EPSM
0A395                                   jmp famistudio_do_epsm_note_attack
0A395                               .endif
0A395                           .endif
0A395                           
0A395                           @done:
0A395 A6 28                         ldx chan_idx
0A397 60                            rts
0A398                               
0A398                           ;======================================================================================================================
0A398                           ; FAMISTUDIO_LOAD_BASIC_ENVELOPES (internal)
0A398                           ;
0A398                           ; Internal function to load the most common envelopes (volume, arp, duty (optional) and pitch) for an instrument.
0A398                           ;
0A398                           ; [in] x:      first envelope index.
0A398                           ; [in] r0:     instrument index.
0A398                           ; [in] ptr1/y: point to instrument data to load.
0A398                           ;======================================================================================================================
0A398                           
0A398                           famistudio_load_basic_envelopes:
0A398                           
0A398                               instrument_ptr = famistudio_ptr1
0A398                               chan_idx      = famistudio_r0
0A398                               tmp_x         = famistudio_r3
0A398                           
0A398                               ; Volume envelope
0A398 B1 30                         lda (instrument_ptr),y
0A39A 9D 16 04                      sta famistudio_env_addr_lo,x
0A39D C8                            iny
0A39E B1 30                         lda (instrument_ptr),y
0A3A0 C8                            iny
0A3A1 9D 21 04                      sta famistudio_env_addr_hi,x
0A3A4 E8                            inx
0A3A5                           
0A3A5                               ; Arpeggio envelope
0A3A5                           .if FAMISTUDIO_USE_ARPEGGIO
0A3A5                               stx tmp_x
0A3A5                               ldx chan_idx
0A3A5                               lda famistudio_chn_env_override,x ; Check if its overriden by arpeggio.
0A3A5                               lsr
0A3A5                               ldx tmp_x
0A3A5                               bcc @arpeggio_envelope 
0A3A5                               iny ; Instrument arpeggio is overriden by arpeggio, dont touch!
0A3A5                               jmp @duty_envelope
0A3A5                           .endif
0A3A5                           
0A3A5                           @arpeggio_envelope:    
0A3A5 B1 30                         lda (instrument_ptr),y
0A3A7 9D 16 04                      sta famistudio_env_addr_lo,x
0A3AA C8                            iny
0A3AB B1 30                         lda (instrument_ptr),y
0A3AD 9D 21 04                      sta famistudio_env_addr_hi,x
0A3B0                           
0A3B0                           @duty_envelope:
0A3B0                               ; Duty cycle envelope
0A3B0 A5 28                         lda chan_idx
0A3B2 C9 02                         cmp #2 ; Triangle has no duty.
0A3B4 F0 10                         beq @no_duty
0A3B6                           .if FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_S5B || FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_EPSM
0A3B6                               cmp #5
0A3B6                               bcs @pitch_envelope
0A3B6                           .endif
0A3B6                               @duty:
0A3B6 E8                                inx
0A3B7 C8                                iny
0A3B8 B1 30                             lda (instrument_ptr),y
0A3BA 9D 16 04                          sta famistudio_env_addr_lo,x
0A3BD C8                                iny
0A3BE B1 30                             lda (instrument_ptr),y
0A3C0 9D 21 04                          sta famistudio_env_addr_hi,x
0A3C3 4C C8 A3                          jmp @pitch_envelope        
0A3C6                               @no_duty:
0A3C6 C8                                iny
0A3C7 C8                                iny
0A3C8                           
0A3C8                           @pitch_envelope:
0A3C8                               ; Pitch envelopes.
0A3C8                           .if !FAMISTUDIO_EXP_NONE
0A3C8                               stx tmp_x 
0A3C8                           .endif
0A3C8 A6 28                         ldx chan_idx
0A3CA                           .if FAMISTUDIO_USE_VIBRATO 
0A3CA                               lda famistudio_chn_env_override,x 
0A3CA                               asl ; Bit-7 tells us if the pitch env is overriden, temporarely store in carry.
0A3CA                           .endif    
0A3CA BD 11 A7                      lda famistudio_channel_to_pitch_env, x
0A3CD 30 0B                         bmi @done
0A3CF AA                            tax
0A3D0                           .if FAMISTUDIO_USE_VIBRATO 
0A3D0                               ror ; Bring back our bit-7 from above.
0A3D0                               bpl @no_vibrato ; In bit 7 is set, instrument pitch is overriden by vibrato, dont touch pitch envelope!
0A3D0                               iny
0A3D0                               iny
0A3D0                               bne @done
0A3D0                               @no_vibrato:
0A3D0                           .endif    
0A3D0 C8                            iny
0A3D1 B1 30                         lda (instrument_ptr),y
0A3D3 95 3F                         sta famistudio_pitch_env_addr_lo,x
0A3D5 C8                            iny
0A3D6 B1 30                         lda (instrument_ptr),y
0A3D8 95 47                         sta famistudio_pitch_env_addr_hi,x
0A3DA                           @done:
0A3DA                           .if !FAMISTUDIO_EXP_NONE
0A3DA                               ; For expansion, preserve X (envelope index) and Y (pointer in instrument data)
0A3DA                               ; as they may want to load more after.
0A3DA                               ldx tmp_x
0A3DA                               inx
0A3DA                               iny
0A3DA                           .endif
0A3DA 60                            rts
0A3DB                               
0A3DB                           ;======================================================================================================================
0A3DB                           ; FAMISTUDIO_SET_INSTRUMENT (internal)
0A3DB                           ;
0A3DB                           ; Internal function to set an instrument for a given channel. Will initialize all instrument envelopes.
0A3DB                           ;
0A3DB                           ; [in] x/r0: channel index
0A3DB                           ; [in] a:    instrument index.
0A3DB                           ;======================================================================================================================
0A3DB                           
0A3DB                           famistudio_set_instrument:
0A3DB                           
0A3DB                               instrument_ptr = famistudio_ptr1
0A3DB                               chan_idx      = famistudio_r0
0A3DB                           
0A3DB                               ; Pre-multiply by 4 if not using extended range, faster pointer arithmetic.
0A3DB                               .if !FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE
0A3DB 0A                            asl a
0A3DC 0A                            asl a
0A3DD                               .endif
0A3DD                           
0A3DD A4 28                         ldy chan_idx
0A3DF BE 0C A7                      ldx famistudio_channel_env,y
0A3E2                           
0A3E2                           .if FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_S5B
0A3E2                               cpy #5
0A3E2                               bcc @base_instrument
0A3E2                               .if FAMISTUDIO_EXP_FDS
0A3E2                               @fds_instrument:
0A3E2                                   jmp famistudio_set_fds_instrument
0A3E2                               .endif
0A3E2                               .if FAMISTUDIO_EXP_VRC7
0A3E2                               @vrc7_instrument:
0A3E2                                   jmp famistudio_set_vrc7_instrument
0A3E2                               .endif
0A3E2                               .if FAMISTUDIO_EXP_N163
0A3E2                               @n163_instrument:
0A3E2                                   jmp famistudio_set_n163_instrument
0A3E2                               .endif
0A3E2                               .if FAMISTUDIO_EXP_S5B
0A3E2                               @s5b_instrument:
0A3E2                                   jmp famistudio_set_s5b_instrument
0A3E2                               .endif
0A3E2                               .if FAMISTUDIO_EXP_EPSM
0A3E2                               @epsm_instrument:
0A3E2                                   jmp famistudio_set_epsm_instrument
0A3E2                               .endif
0A3E2                           .endif
0A3E2                           
0A3E2                           @base_instrument:
0A3E2                           
0A3E2                               .if !FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE
0A3E2 0A                                asl ; Instrument number is pre multiplied by 4
0A3E3 A8                                tay
0A3E4 AD 6D 04                          lda famistudio_instrument_hi
0A3E7 69 00                             adc #0 ; Use carry to extend range for 64 instruments
0A3E9 85 31                             sta instrument_ptr+1
0A3EB AD 6C 04                          lda famistudio_instrument_lo
0A3EE 85 30                             sta instrument_ptr+0
0A3F0                               .else
0A3F0                                   ; Multiply by instrument stride of 8.
0A3F0                                   ldy #0
0A3F0                                   sty instrument_ptr+1
0A3F0                                   asl
0A3F0                                   rol instrument_ptr+1 
0A3F0                                   asl
0A3F0                                   rol instrument_ptr+1 
0A3F0                                   asl
0A3F0                                   rol instrument_ptr+1 
0A3F0                                   clc
0A3F0                                   adc famistudio_instrument_lo
0A3F0                                   sta instrument_ptr+0
0A3F0                                   lda instrument_ptr+1
0A3F0                                   adc famistudio_instrument_hi
0A3F0                                   sta instrument_ptr+1
0A3F0                               .endif
0A3F0                           
0A3F0 4C 98 A3                      jmp famistudio_load_basic_envelopes ; Will 'rts'
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_S5B
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_GET_EXP_INST_PTR (internal)
0A3F3                           ;
0A3F3                           ; Retrives the expansion instrument pointer for a given index.
0A3F3                           ;
0A3F3                           ; [in]  a:      instrument index.
0A3F3                           ; [out] ptr1/y: the instrument pointer + offset
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_get_exp_inst_ptr:
0A3F3                           
0A3F3                               instrument_ptr = famistudio_ptr1
0A3F3                           
0A3F3                            .if !FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE
0A3F3                               asl ; Instrument number is pre multiplied by 4
0A3F3                               asl
0A3F3                               tay
0A3F3                               lda famistudio_exp_instrument_hi
0A3F3                               adc #0  ; Use carry to extend range for 32 expansion instruments
0A3F3                               sta instrument_ptr+1
0A3F3                               lda famistudio_exp_instrument_lo
0A3F3                               sta instrument_ptr+0
0A3F3                           .else
0A3F3                               ; Multiply by expansion instrument stride of 16.
0A3F3                               ldy #0
0A3F3                               sty instrument_ptr+1
0A3F3                               asl
0A3F3                               rol instrument_ptr+1 
0A3F3                               asl
0A3F3                               rol instrument_ptr+1 
0A3F3                               asl
0A3F3                               rol instrument_ptr+1 
0A3F3                               asl
0A3F3                               rol instrument_ptr+1 
0A3F3                               clc
0A3F3                               adc famistudio_exp_instrument_lo
0A3F3                               sta instrument_ptr+0
0A3F3                               lda instrument_ptr+1
0A3F3                               adc famistudio_exp_instrument_hi
0A3F3                               sta instrument_ptr+1
0A3F3                           .endif   
0A3F3                           
0A3F3                               rts
0A3F3                           
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM
0A3F3                           
0A3F3                           .macro skip_exp_basic_envelopes
0A3F3                           .if FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE
0A3F3                               ldy #6
0A3F3                           .else
0A3F3                               iny
0A3F3                               iny
0A3F3                               iny
0A3F3                               iny
0A3F3                               iny
0A3F3                               iny
0A3F3                           .endif
0A3F3                           .endm
0A3F3                           
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_VRC7
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_SET_VRC7_INSTRUMENT (internal)
0A3F3                           ;
0A3F3                           ; Internal function to set a VRC7 instrument for a given channel. Will load custom patch if needed.
0A3F3                           ;
0A3F3                           ; [in] y/r0: channel index
0A3F3                           ; [in] x:    index of first envelope of instrument
0A3F3                           ; [in] a:    instrument index.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_set_vrc7_instrument:
0A3F3                           
0A3F3                               ptr          = famistudio_ptr1
0A3F3                               chan_idx     = famistudio_r0
0A3F3                               update_flags = famistudio_r1 ; bit 7 = no attack, bit 6 = has set delayed cut
0A3F3                               
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                               bit update_flags
0A3F3                               bpl @load_envelopes
0A3F3                           
0A3F3                               @skip_envelopes:
0A3F3                                   skip_exp_basic_envelopes
0A3F3                                   jmp @load_patch
0A3F3                               @load_envelopes:
0A3F3                                   jsr famistudio_load_basic_envelopes
0A3F3                           
0A3F3                               @load_patch:
0A3F3                               ldx chan_idx
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_chn_vrc7_sustain ; Release override.
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_chn_vrc7_patch-FAMISTUDIO_VRC7_CH0_IDX,x
0A3F3                               bne @done
0A3F3                           
0A3F3                               @read_custom_patch:
0A3F3                               ldx #0
0A3F3                               iny
0A3F3                               @read_patch_loop:
0A3F3                                   stx FAMISTUDIO_VRC7_REG_SEL
0A3F3                                   jsr famistudio_vrc7_wait_reg_select
0A3F3                                   lda (ptr),y
0A3F3                                   iny
0A3F3                                   sta FAMISTUDIO_VRC7_REG_WRITE
0A3F3                                   jsr famistudio_vrc7_wait_reg_write
0A3F3                                   inx
0A3F3                                   cpx #8
0A3F3                                   bne @read_patch_loop
0A3F3                           
0A3F3                               @done:
0A3F3                               rts
0A3F3                           
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_S5B
0A3F3                               
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_SET_S5B_INSTRUMENT (internal)
0A3F3                           ;
0A3F3                           ; Internal function to set a S5B instrument. 
0A3F3                           ;
0A3F3                           ; [in] y/r0: channel index
0A3F3                           ; [in] x:    index of first envelope of instrument
0A3F3                           ; [in] a:    instrument index.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_set_s5b_instrument:
0A3F3                           
0A3F3                               chan_idx = famistudio_r0
0A3F3                               ptr      = famistudio_ptr1
0A3F3                           
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                               jsr famistudio_load_basic_envelopes
0A3F3                           
0A3F3                               @mixer:
0A3F3                               sec
0A3F3                           
0A3F3                               ; After 'famistudio_load_basic_envelopes' x should point to the correct envelope.
0A3F3                               @loop:
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_env_addr_lo,x
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_env_addr_hi,x
0A3F3                                   bcc @load_env_params
0A3F3                                   clc
0A3F3                                   inx
0A3F3                                   iny
0A3F3                                   bcc @loop
0A3F3                           
0A3F3                               @load_env_params:
0A3F3                           
0A3F3                               ; Envelope shape + auto-pitch octave
0A3F3                               ldx chan_idx
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_s5b_chn_env_shape-FAMISTUDIO_S5B_CH0_IDX,x
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_s5b_chn_env_octave-FAMISTUDIO_S5B_CH0_IDX,x
0A3F3                               
0A3F3                               ; Skip if using auto-period
0A3F3                               cmp #$80
0A3F3                               bne @done
0A3F3                           
0A3F3                               ; Skip if effect set manual period this frame.
0A3F3                               lda famistudio_s5b_env_override
0A3F3                               bne @done 
0A3F3                           
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_s5b_env_period_lo
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_s5b_env_period_hi
0A3F3                           
0A3F3                               @done:
0A3F3                               rts
0A3F3                               
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_EPSM
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_SET_EPSM_INSTRUMENT (internal)
0A3F3                           ;
0A3F3                           ; Internal function to set a EPSM instrument. 
0A3F3                           ;
0A3F3                           ; [in] x/r0: channel index
0A3F3                           ; [in] a:    instrument index.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_set_epsm_instrument:
0A3F3                           
0A3F3                               ptr          = famistudio_ptr1
0A3F3                               env_ptr      = famistudio_ptr2
0A3F3                               ex_patch     = famistudio_ptr2
0A3F3                               chan_idx     = famistudio_r0
0A3F3                               chan_idx2    = famistudio_r0
0A3F3                               update_flags = famistudio_r1 ; bit 7 = no attack, bit 6 = has set delayed cut
0A3F3                               reg_offset   = famistudio_r3
0A3F3                               
0A3F3                           .if FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A3F3                               cpy #FAMISTUDIO_EPSM_CHAN_RHYTHM_START
0A3F3                               bcc @process_regular_instrument
0A3F3                                   ; We are processing a rhythm instrument, so skip all the fluff.
0A3F3                                   ; We only need to load the volume of the instrument and store it in the attack.
0A3F3                                   ; load the instrument
0A3F3                                   ;sty chan_idx
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                                   
0A3F3                                   ; Load the offset for the rhythm track and keep it in x
0A3F3                                   ldx chan_idx
0A3F3                                   lda famistudio_rhythm_lut-FAMISTUDIO_EPSM_CHAN_RHYTHM_START, x
0A3F3                                   tax
0A3F3                           
0A3F3                                   ; Read the first envelope pointer for the volume, we'll use this to get the volume later
0A3F3                               sty reg_offset
0A3F3                                   lda (ptr),y
0A3F3                                   sta env_ptr
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta env_ptr+1
0A3F3                               ; the first value is the release point, so load the second offset which is the volume
0A3F3                               ldy #1
0A3F3                               lda (env_ptr),y
0A3F3                               and #$0F
0A3F3                               sta famistudio_chn_epsm_rhythm_volume,x
0A3F3                               lda reg_offset
0A3F3                               clc
0A3F3                               adc #14 ; skip over envelopes + square stuff.
0A3F3                               tay
0A3F3                               lda (ptr),y
0A3F3                               sta ex_patch
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta ex_patch+1
0A3F3                               ldy #1
0A3F3                               lda (ex_patch),y
0A3F3                               and #$c0
0A3F3                               sta famistudio_chn_epsm_rhythm_stereo,x
0A3F3                           
0A3F3                               rts
0A3F3                           .endif
0A3F3                           @process_regular_instrument:
0A3F3                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT > 0
0A3F3                               cpy #FAMISTUDIO_EPSM_CHAN_FM_START
0A3F3                               bcc @skip_fm_instrument
0A3F3                                   sta famistudio_chn_epsm_fm_instrument-FAMISTUDIO_EPSM_CHAN_FM_START,y
0A3F3                               @skip_fm_instrument:
0A3F3                           .endif
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                               bit update_flags
0A3F3                               bpl @load_envelopes
0A3F3                           
0A3F3                               ; The exporter will ensure this only happens on FM channels.
0A3F3                               @skip_envelopes:
0A3F3                                   skip_exp_basic_envelopes
0A3F3                                   jmp @check_square_channel
0A3F3                               @load_envelopes:
0A3F3                                   jsr famistudio_load_basic_envelopes
0A3F3                           
0A3F3                               @check_square_channel:
0A3F3                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT > 0
0A3F3                               ; channels 0-2 (square) do not need any further handling since they do not support patches
0A3F3                               lda chan_idx
0A3F3                               cmp #FAMISTUDIO_EPSM_CHAN_FM_START
0A3F3                               bcs @not_square_channel
0A3F3                                   ;lda famistudio_channel_env,x
0A3F3                                   ;tax
0A3F3                           .endif
0A3F3                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT > 0
0A3F3                                   @noise:
0A3F3                                   sec
0A3F3                           
0A3F3                               @loop:
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_env_addr_lo,x
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_env_addr_hi,x
0A3F3                                   bcc @load_env_params
0A3F3                                   clc
0A3F3                                   inx
0A3F3                                   iny
0A3F3                                   bcc @loop
0A3F3                           
0A3F3                               @load_env_params:
0A3F3                           
0A3F3                                   ; Envelope shape + auto-pitch octave
0A3F3                                   ldx chan_idx
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_epsm_chn_env_shape-FAMISTUDIO_EPSM_CH0_IDX,x
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_epsm_chn_env_octave-FAMISTUDIO_EPSM_CH0_IDX,x
0A3F3                               
0A3F3                                   ; Skip if using auto-period
0A3F3                                   cmp #$80
0A3F3                                   bne @done
0A3F3                           
0A3F3                                   ; Skip if effect set manual period this frame.
0A3F3                                   lda famistudio_epsm_env_override
0A3F3                                   bne @done 
0A3F3                           
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_epsm_env_period_lo
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   sta famistudio_epsm_env_period_hi
0A3F3                           
0A3F3                                   @done:
0A3F3                           
0A3F3                           .endif
0A3F3                                   rts
0A3F3                           
0A3F3                           @not_square_channel:
0A3F3                               rts
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_FDS
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_UPDATE_FDS_WAVE (internal)
0A3F3                           ;
0A3F3                           ; Internal function to upload the FDS waveform (if needed) of an FDS instrument. 
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_update_fds_wave:
0A3F3                           
0A3F3                               ptr        = famistudio_ptr1
0A3F3                               wave_ptr   = famistudio_ptr0
0A3F3                               tmp_enable = famistudio_r3
0A3F3                           
0A3F3                               ; See if the wave index has changed.
0A3F3                               lda famistudio_env_value+FAMISTUDIO_FDS_CH0_ENVS+FAMISTUDIO_ENV_FDS_WAVE_IDX_OFF
0A3F3                               cmp famistudio_fds_wave_index
0A3F3                               beq @done
0A3F3                           
0A3F3                               ; Retrieve the instrument pointer.
0A3F3                               sta famistudio_fds_wave_index
0A3F3                               lda famistudio_chn_fds_instrument
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                           
0A3F3                               ; Master volume
0A3F3                               tya
0A3F3                               adc #8 ; Carry is clear here.
0A3F3                               tay
0A3F3                               lda (ptr),y
0A3F3                               and #3 ; Bits 0 and 1 are master volume
0A3F3                               tax    ; Store master volume to x
0A3F3                               ora #$80
0A3F3                               sta tmp_enable ; Store maaster volume with write enable
0A3F3                               iny
0A3F3                               
0A3F3                               ; Load the wave table pointer.
0A3F3                               lda (ptr),y
0A3F3                               sta wave_ptr+0
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta wave_ptr+1
0A3F3                           
0A3F3                               ; Load the pointer for the current wave in the table.
0A3F3                               lda famistudio_fds_wave_index
0A3F3                               asl
0A3F3                               tay
0A3F3                               lda (wave_ptr),y
0A3F3                               sta ptr+0
0A3F3                               iny
0A3F3                               lda (wave_ptr),y
0A3F3                               sta ptr+1
0A3F3                           
0A3F3                               ; FDS Waveform
0A3F3                               ldy #63
0A3F3                               @wave_loop:
0A3F3                                   lda tmp_enable
0A3F3                                   sta FAMISTUDIO_FDS_VOL ; Enable RAM write.
0A3F3                                   lda (ptr),y 
0A3F3                                   sta FAMISTUDIO_FDS_WAV_START,y ; Write 2 samples between each write toggle (saves ~500 CPU cycles, sounds identical)
0A3F3                                   dey
0A3F3                                   lda (ptr),y 
0A3F3                                   sta FAMISTUDIO_FDS_WAV_START,y
0A3F3                                   stx FAMISTUDIO_FDS_VOL ; Disable RAM write.
0A3F3                                   dey
0A3F3                                   bpl @wave_loop
0A3F3                                   
0A3F3                               @done:
0A3F3                               rts
0A3F3                               
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_SET_FDS_INSTRUMENT (internal)
0A3F3                           ;
0A3F3                           ; Internal function to set a FDS instrument. Will upload the wave and modulation envelope if needed.
0A3F3                           ;
0A3F3                           ; [in] y/r0: channel index
0A3F3                           ; [in] x:    index of first envelope of instrument
0A3F3                           ; [in] a:    instrument index.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_set_fds_instrument:
0A3F3                           
0A3F3                               ptr           = famistudio_ptr1
0A3F3                               wave_ptr      = famistudio_ptr2
0A3F3                               tmp_mod_depth = famistudio_r3
0A3F3                           
0A3F3                               ; Store instrument number (premultipled by 4 if not using extended range)
0A3F3                               sta famistudio_chn_fds_instrument-FAMISTUDIO_FDS_CH0_IDX,y
0A3F3                           
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                               jsr famistudio_load_basic_envelopes
0A3F3                           
0A3F3                               ; Load the wave index envelope, x will point to the correct envelope.
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_env_addr_lo,x
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_env_addr_hi,x
0A3F3                           
0A3F3                               ; FDS Modulation
0A3F3                               @write_fds_mod:
0A3F3                                   iny
0A3F3                                   lda (ptr),y ; Read depth / master volume, shift twice for depth and store for later
0A3F3                                   lsr
0A3F3                                   lsr
0A3F3                                   sta tmp_mod_depth
0A3F3                           
0A3F3                                   ; Skip to mod envelope
0A3F3                                   iny
0A3F3                                   iny
0A3F3                                   iny
0A3F3                           
0A3F3                                   ; Compare mod envelope pointer, only write the mod table if it has changed
0A3F3                                   lda (ptr),y
0A3F3                                   cmp famistudio_fds_mod_envelope+0
0A3F3                                   bne @write_mod_table
0A3F3                                   iny
0A3F3                                   lda (ptr),y
0A3F3                                   cmp famistudio_fds_mod_envelope+1
0A3F3                                   beq @load_mod_param ; Skip writing the mod table
0A3F3                                   dey
0A3F3                                   lda (ptr),y
0A3F3                           
0A3F3                                   @write_mod_table:
0A3F3                                       ; Store new envelope pointer
0A3F3                                       sta wave_ptr+0
0A3F3                                       sta famistudio_fds_mod_envelope+0
0A3F3                                       iny
0A3F3                                       lda (ptr),y
0A3F3                                       sta wave_ptr+1
0A3F3                                       sta famistudio_fds_mod_envelope+1
0A3F3                           
0A3F3                                       ; Reset and write modulation
0A3F3                                       tya ; Store y in x and restore after loop
0A3F3                                       tax
0A3F3                                       lda #$80
0A3F3                                       sta FAMISTUDIO_FDS_MOD_HI ; Need to disable modulation before writing.
0A3F3                                       sta FAMISTUDIO_FDS_SWEEP_ENV
0A3F3                                       ldy #0
0A3F3                                       sty FAMISTUDIO_FDS_SWEEP_BIAS
0A3F3                                       @mod_loop:
0A3F3                                           lda (wave_ptr),y
0A3F3                                           sta FAMISTUDIO_FDS_MOD_TABLE
0A3F3                                           iny
0A3F3                                           cpy #32
0A3F3                                           bne @mod_loop
0A3F3                                       txa
0A3F3                                       tay
0A3F3                           
0A3F3                               @load_mod_param:
0A3F3                                   iny
0A3F3                                   .if FAMISTUDIO_USE_FDS_AUTOMOD
0A3F3                                       lda (ptr),y
0A3F3                                       bpl @check_mod_speed
0A3F3                           
0A3F3                                       @auto_mod:
0A3F3                                           and #$7f ; Clear bit 7 before setting
0A3F3                                           sta famistudio_fds_automod_numer
0A3F3                                           iny
0A3F3                                           lda (ptr),y
0A3F3                                           sta famistudio_fds_automod_denom
0A3F3                                           bne @check_mod_depth
0A3F3                                   .endif
0A3F3                           
0A3F3                                   @check_mod_speed:
0A3F3                                       .if FAMISTUDIO_USE_FDS_AUTOMOD
0A3F3                                           lda #0
0A3F3                                           sta famistudio_fds_automod_numer
0A3F3                                       .endif
0A3F3                                       bit famistudio_fds_override_flags
0A3F3                                       bmi @mod_speed_overriden
0A3F3                           
0A3F3                                       @load_mod_speed:
0A3F3                                           lda (ptr),y
0A3F3                                           sta famistudio_fds_mod_speed+0
0A3F3                                           iny
0A3F3                                           lda (ptr),y
0A3F3                                           sta famistudio_fds_mod_speed+1
0A3F3                                           jmp @check_mod_depth
0A3F3                           
0A3F3                                       @mod_speed_overriden:
0A3F3                                           iny
0A3F3                           
0A3F3                                   @check_mod_depth:
0A3F3                                       bit famistudio_fds_override_flags
0A3F3                                       bvs @mod_depth_overriden
0A3F3                           
0A3F3                                       @load_mod_depth:
0A3F3                                           tya ; Use depth that was stored earlier
0A3F3                                           tax
0A3F3                                           lda tmp_mod_depth 
0A3F3                                           sta famistudio_fds_mod_depth
0A3F3                                           txa
0A3F3                                           tay
0A3F3                           
0A3F3                                       @mod_depth_overriden:
0A3F3                                           iny
0A3F3                                           lda (ptr),y
0A3F3                                           sta famistudio_fds_mod_delay
0A3F3                               rts
0A3F3                           
0A3F3                           .endif
0A3F3                           
0A3F3                           .if FAMISTUDIO_EXP_N163
0A3F3                           
0A3F3                           famistudio_n163_wave_table:
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $00
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $08
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $10
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $18
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $20
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $28
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $30
0A3F3                               .byte FAMISTUDIO_N163_REG_WAVE - $38
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_UPDATE_N163_WAVE (internal)
0A3F3                           ;
0A3F3                           ; Internal function to upload the waveform (if needed) of an N163 instrument. 
0A3F3                           ;
0A3F3                           ; [in] y: N163 channel idx (0,1,2,3,4,5,6,7)
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_update_n163_wave:
0A3F3                               
0A3F3                               ptr           = famistudio_ptr1
0A3F3                               wave_ptr      = famistudio_ptr0
0A3F3                               wave_pos      = famistudio_r1
0A3F3                               wave_len      = famistudio_r2
0A3F3                           
0A3F3                               lda famistudio_n163_env_table, y
0A3F3                               tax 
0A3F3                           
0A3F3                               ; See if the wave index has changed.
0A3F3                               lda famistudio_env_value+FAMISTUDIO_ENV_N163_WAVE_IDX_OFF,x
0A3F3                               cmp famistudio_chn_n163_wave_index,y
0A3F3                               beq @done
0A3F3                           
0A3F3                               ; Retrieve the instrument pointer.
0A3F3                               sta famistudio_chn_n163_wave_index,y
0A3F3                               tya
0A3F3                               tax
0A3F3                               lda famistudio_chn_n163_instrument,y
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                           
0A3F3                               lda famistudio_n163_wave_table, x
0A3F3                               sta FAMISTUDIO_N163_ADDR
0A3F3                           
0A3F3                               ; Wave position
0A3F3                               tya
0A3F3                               adc #8 ; Carry is clear here.
0A3F3                               tay
0A3F3                               lda (ptr),y
0A3F3                               sta wave_pos
0A3F3                               sta FAMISTUDIO_N163_DATA
0A3F3                               iny
0A3F3                           
0A3F3                               ; Wave length
0A3F3                               lda (ptr),y
0A3F3                               lsr
0A3F3                               sta wave_len
0A3F3                               lda #$80 ; (128 - wave length / 2) * 2 == 256 - wave length
0A3F3                               sec
0A3F3                               sbc wave_len
0A3F3                               asl
0A3F3                               sta famistudio_chn_n163_wave_len, x
0A3F3                               iny
0A3F3                           
0A3F3                               ; Load the wave table pointer.
0A3F3                               lda (ptr),y
0A3F3                               sta wave_ptr+0
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta wave_ptr+1
0A3F3                           
0A3F3                               ; Load the pointer for the current wave in the table.
0A3F3                               lda famistudio_chn_n163_wave_index,x
0A3F3                               asl
0A3F3                               tay
0A3F3                               lda (wave_ptr),y
0A3F3                               sta ptr+0
0A3F3                               iny
0A3F3                               lda (wave_ptr),y
0A3F3                               sta ptr+1
0A3F3                           
0A3F3                               ; Upload to N163
0A3F3                               ldy #0
0A3F3                               lda wave_pos
0A3F3                               lsr 
0A3F3                               ora #$80
0A3F3                               sta FAMISTUDIO_N163_ADDR
0A3F3                               ldy #0
0A3F3                               @wave_loop:
0A3F3                                   lda (ptr),y
0A3F3                                   sta FAMISTUDIO_N163_DATA
0A3F3                                   iny
0A3F3                                   cpy wave_len
0A3F3                                   bne @wave_loop
0A3F3                           
0A3F3                               txa
0A3F3                               tay
0A3F3                           
0A3F3                               @done:
0A3F3                               rts
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_SET_N163_INSTRUMENT (internal)
0A3F3                           ;
0A3F3                           ; Internal function to set a N163 instrument.
0A3F3                           ;
0A3F3                           ; [in] y/r0: channel index
0A3F3                           ; [in] x:    index of first envelope of instrument
0A3F3                           ; [in] a:    instrument index.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_set_n163_instrument:
0A3F3                           
0A3F3                               ptr      = famistudio_ptr1
0A3F3                               chan_idx = famistudio_r0
0A3F3                           
0A3F3                               ; Store instrument number (premultipled by 4 if not using extended range)
0A3F3                               sta famistudio_chn_n163_instrument-FAMISTUDIO_N163_CH0_IDX,y
0A3F3                               
0A3F3                               jsr famistudio_get_exp_inst_ptr
0A3F3                               jsr famistudio_load_basic_envelopes
0A3F3                           
0A3F3                               ; Load the wave index envelope, x will point to the correct envelope.
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_env_addr_lo,x
0A3F3                               iny
0A3F3                               lda (ptr),y
0A3F3                               sta famistudio_env_addr_hi,x
0A3F3                           
0A3F3                               rts
0A3F3                           
0A3F3                           .endif
0A3F3                           
0A3F3                           ;======================================================================================================================
0A3F3                           ; FAMISTUDIO_UPDATE_CHANNEL (internal)
0A3F3                           ;
0A3F3                           ; Advances the song by one frame for a given channel. If a new note or effect(s) are found, they will be processed.
0A3F3                           ;
0A3F3                           ; [in]  x: channel index
0A3F3                           ; [out] z: non-zero if we triggered a new note.
0A3F3                           ;======================================================================================================================
0A3F3                           
0A3F3                           famistudio_advance_channel:
0A3F3                               
0A3F3                               chan_idx         = famistudio_r0
0A3F3                               update_flags     = famistudio_r1 ; bit 7 = no attack, bit 6 = has set delayed cut
0A3F3                               temp_ptr_y       = famistudio_r2
0A3F3                               tmp_slide_from   = famistudio_r2
0A3F3                               tmp_slide_idx    = famistudio_r2
0A3F3                               tmp_duty_cycle   = famistudio_r2
0A3F3                               tmp_ptr_lo       = famistudio_r2
0A3F3                               tmp_y1           = famistudio_r2
0A3F3                               slide_delta_lo   = famistudio_ptr1_hi
0A3F3                               tmp_y2           = famistudio_ptr1_lo
0A3F3                               channel_data_ptr = famistudio_ptr0
0A3F3                               opcode_jmp_ptr   = famistudio_ptr1
0A3F3                               tempo_env_ptr    = famistudio_ptr1
0A3F3                               env_ptr          = famistudio_ptr1
0A3F3                           
0A3F3 BD 4F 04                      lda famistudio_chn_repeat,x
0A3F6 F0 06                         beq @no_repeat
0A3F8 DE 4F 04                      dec famistudio_chn_repeat,x
0A3FB A9 00                         lda #0
0A3FD 60                            rts
0A3FE                           
0A3FE                           @no_repeat:
0A3FE BD 40 04                      lda famistudio_chn_ptr_lo,x
0A401 85 2D                         sta channel_data_ptr+0
0A403 BD 45 04                      lda famistudio_chn_ptr_hi,x
0A406 85 2E                         sta channel_data_ptr+1
0A408 A0 00                         ldy #0
0A40A 84 29                         sty update_flags
0A40C 86 28                         stx chan_idx    
0A40E                           
0A40E                           @read_byte:
0A40E B1 2D                         lda (channel_data_ptr),y
0A410 C8                            iny
0A411                           
0A411                           ; $80 to $ff = sequence of empty notes (up to 64) or instrument changes (up to 64)
0A411                           @check_negative: 
0A411 09 00                         ora #0
0A413 30 24                         bmi @empty_notes_or_instrument_change
0A415                           
0A415                           ; $00 to $3f = notes from C1 to D6 (most common notes, same as FT2 range)
0A415                           ; $40 to $6f = opcodes for various things.
0A415                           @check_regular_note:
0A415 C9 40                         cmp #$40
0A417 90 36                         bcc @common_note
0A419                           
0A419                           .if FAMISTUDIO_USE_VOLUME_TRACK
0A419                           ; $70 to $7f = volume change 
0A419                           @check_volume_track:
0A419 C9 70                         cmp #$70
0A41B 90 0A                         bcc @jmp_to_opcode
