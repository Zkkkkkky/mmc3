0A306                                   jsr famistudio_update_epsm_rhythm_channel_sound
0A306                               @skip_epsm_rhythm_update:
0A306                                   dec @loop_cnt
0A306                                   bpl @epsm_rhythm_channel_loop
0A306                           .endif
