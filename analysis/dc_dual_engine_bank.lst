0A0B8                           ;======================================================================================================================
0A0B8                           ; FAMISTUDIO_MUSIC_PLAY (public)
0A0B8                           ;
0A0B8                           ; Plays a song from the loaded music data (from a previous call to famistudio_init).
0A0B8                           ; 
0A0B8                           ; [in] a : Song index.
0A0B8                           ;======================================================================================================================
0A0B8                           
0A0B8                           famistudio_music_play:
0A0B8                           
0A0B8                               tmp = famistudio_r0
0A0B8                               song_list_ptr = famistudio_ptr0
0A0B8                               temp_env_ptr  = famistudio_ptr1
0A0B8                           
0A0B8                           .ifdef FAMISTUDIO_CFG_DC_FIXED_MUSIC_BASE
0A0B8 A2 00                         ldx #<$8000
0A0BA 86 2D                         stx song_list_ptr+0
0A0BC A2 80                         ldx #>$8000
0A0BE 86 2E                         stx song_list_ptr+1
0A0C0                           .else
0A0C0                               ldx famistudio_song_list_lo
0A0C0                               stx song_list_ptr+0
0A0C0                               ldx famistudio_song_list_hi
0A0C0                               stx song_list_ptr+1
0A0C0                           .endif
0A0C0                           
0A0C0 A0 00                         ldy #0
0A0C2 D1 2D                         cmp (song_list_ptr),y
0A0C4 90 01                         bcc @valid_song
0A0C6 60                            rts ; Invalid song index.
0A0C7                           
0A0C7                           @valid_song:
0A0C7                           .if FAMISTUDIO_NUM_CHANNELS = 5
0A0C7                               ; Here we basically assume we have 17 songs or less (17 songs * 14 bytes per song + 5 bytes header < 256).
0A0C7 0A                            asl
0A0C8 85 28                         sta tmp
0A0CA 0A                            asl
0A0CB AA                            tax
0A0CC 0A                            asl
0A0CD 65 28                         adc tmp
0A0CF 86 28                         stx tmp
0A0D1 65 28                         adc tmp
0A0D3 69 05                         adc #5 ; Song count + instrument ptr + sample ptr
0A0D5 A8                            tay
0A0D6                           .else
0A0D6                               ; This supports a larger number of songs as it increments the pointer itself, not Y.
0A0D6                               ; As the number of channel becomes huge, this become necessary to support a decent
0A0D6                               ; number of songs.
0A0D6                               tax
0A0D6                               lda song_list_ptr+0
0A0D6                               @song_mult_loop:
0A0D6                                   dex
0A0D6                                   bmi @song_mult_loop_done
0A0D6                                   adc #(FAMISTUDIO_NUM_CHANNELS * 2 + 4)
0A0D6                                   bcc @song_mult_loop
0A0D6                                   inc song_list_ptr+1
0A0D6                                   clc
0A0D6                                   bcc @song_mult_loop
0A0D6                           
0A0D6                               @song_mult_loop_done:
0A0D6                                   sta song_list_ptr+0
0A0D6                           
0A0D6                           .if FAMISTUDIO_EXP_FDS || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM || FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_S5B
0A0D6                               ldy #7 ; Song count + instrument ptr + exp instrument ptr + sample ptr
0A0D6                           .else
0A0D6                               ldy #5 ; Song count + instrument ptr + sample ptr
0A0D6                           .endif
0A0D6                           .endif
0A0D6                           
0A0D6 20 64 A0                      jsr famistudio_music_stop
0A0D9                           
0A0D9 A2 00                         ldx #0
0A0DB                           
0A0DB                           @set_channels:
0A0DB                           
0A0DB                               ; Channel data address
0A0DB B1 2D                         lda (song_list_ptr),y
0A0DD 9D 40 04                      sta famistudio_chn_ptr_lo,x
0A0E0 C8                            iny
0A0E1 B1 2D                         lda (song_list_ptr),y
0A0E3 9D 45 04                      sta famistudio_chn_ptr_hi,x
0A0E6 C8                            iny
0A0E7                           
0A0E7 A9 00                         lda #0
0A0E9 9D 4F 04                      sta famistudio_chn_repeat,x
0A0EC 9D 4A 04                      sta famistudio_chn_note,x
0A0EF 95 37                         sta famistudio_chn_ref_len,x
0A0F1                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A0F1 A9 F0                             lda #$f0
0A0F3 95 42                             sta famistudio_chn_volume_track,x
0A0F5                               .endif
0A0F5                               .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A0F5                                   lda #$ff
0A0F5                                   sta famistudio_chn_note_delay,x
0A0F5                                   sta famistudio_chn_cut_delay,x
0A0F5                               .endif    
0A0F5                           
0A0F5                           @nextchannel:
0A0F5 E8                            inx
0A0F6 E0 05                         cpx #FAMISTUDIO_NUM_CHANNELS
0A0F8 D0 E1                         bne @set_channels
0A0FA                           
0A0FA                           .if FAMISTUDIO_USE_FAMITRACKER_TEMPO
0A0FA                               lda famistudio_pal_adjust
0A0FA                               beq @pal
0A0FA                               iny
0A0FA                               iny
0A0FA                           @pal:
0A0FA                           
0A0FA                               ; Tempo increment.
0A0FA                               lda (song_list_ptr),y
0A0FA                               sta famistudio_tempo_step_lo
0A0FA                               iny
0A0FA                               lda (song_list_ptr),y
0A0FA                               sta famistudio_tempo_step_hi
0A0FA                           
0A0FA                               lda #0 ; Reset tempo accumulator
0A0FA                               sta famistudio_tempo_acc_lo
0A0FA                               lda #6 ; Default speed
0A0FA                               sta famistudio_tempo_acc_hi
0A0FA                               sta famistudio_song_speed ; Apply default speed, this also enables music
0A0FA                           .else
0A0FA B1 2D                         lda (song_list_ptr),y
0A0FC 85 4A                         sta famistudio_tempo_env_ptr_lo
0A0FE 85 30                         sta temp_env_ptr+0
0A100 C8                            iny
0A101 B1 2D                         lda (song_list_ptr),y
0A103 85 4B                         sta famistudio_tempo_env_ptr_hi
0A105 85 31                         sta temp_env_ptr+1
0A107 C8                            iny
0A108 B1 2D                         lda (song_list_ptr),y
0A10A                           .if FAMISTUDIO_DUAL_SUPPORT ; Dual mode
0A10A                               ldx famistudio_pal_adjust
0A10A                               bne @ntsc_target
0A10A                               ora #1
0A10A                               @ntsc_target:
0A10A                           .elseif FAMISTUDIO_CFG_PAL_SUPPORT ; PAL only
0A10A                               ora #1
0A10A                           .endif
0A10A AA                            tax
0A10B BD 1A A7                      lda famistudio_tempo_frame_lookup, x ; Lookup contains the number of frames to run (0,1,2) to maintain tempo
0A10E 85 5C                         sta famistudio_tempo_frame_num
0A110 A0 00                         ldy #0
0A112 84 5B                         sty famistudio_tempo_env_idx
0A114 B1 30                         lda (temp_env_ptr),y
0A116 18                            clc 
0A117 69 01                         adc #1
0A119 85 5A                         sta famistudio_tempo_env_counter
0A11B A9 06                         lda #6
0A11D 85 2F                         sta famistudio_song_speed ; Non-zero simply so the song isnt considered paused.
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_EXP_VRC7
0A11F                               lda #0
0A11F                               ldx #5
0A11F                               @clear_vrc7_loop:
0A11F                                   sta famistudio_chn_vrc7_prev_hi, x
0A11F                                   sta famistudio_chn_vrc7_patch, x
0A11F                                   sta famistudio_chn_vrc7_trigger,x
0A11F                                   dex
0A11F                                   bpl @clear_vrc7_loop 
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_EXP_EPSM
0A11F                           .if FAMISTUDIO_EXP_EPSM_TRIG_CHN > 0
0A11F                               lda #0
0A11F                               ldx #FAMISTUDIO_EXP_EPSM_FM_CHN_CNT + FAMISTUDIO_EXP_EPSM_RHYTHM_CNT - 1
0A11F                               @clear_epsm_loop:
0A11F                                   sta famistudio_chn_epsm_trigger,x
0A11F                                   dex
0A11F                                   bpl @clear_epsm_loop 
0A11F                           .endif
0A11F                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT > 0
0A11F                               lda #0
0A11F                               sta famistudio_epsm_env_period_lo
0A11F                               sta famistudio_epsm_env_period_hi
0A11F                               sta famistudio_epsm_env_override
0A11F                               ldx #(FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT - 1)
0A11F                               @clear_epsm_sq_loop:
0A11F                                   sta famistudio_epsm_chn_env_shape, x
0A11F                                   sta famistudio_epsm_chn_env_octave, x
0A11F                                   dex
0A11F                                   bpl @clear_epsm_sq_loop
0A11F                           .endif
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_EXP_VRC6
0A11F                               lda #0
0A11F                               sta famistudio_vrc6_saw_volume
0A11F                               .if FAMISTUDIO_USE_PHASE_RESET
0A11F                                   sta famistudio_vrc6_pulse1_prev_hi
0A11F                                   sta famistudio_vrc6_pulse2_prev_hi
0A11F                                   sta famistudio_vrc6_saw_prev_hi
0A11F                               .endif
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_USE_PHASE_RESET
0A11F                               lda #0
0A11F                               sta famistudio_phase_reset
0A11F                               .if FAMISTUDIO_EXP_N163
0A11F                                   sta famistudio_phase_reset_n163
0A11F                               .endif
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_USE_DELTA_COUNTER
0A11F                               lda #$ff
0A11F                               sta famistudio_dmc_delta_counter
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_EXP_FDS
0A11F                               lda #0
0A11F                               sta famistudio_fds_mod_envelope+0
0A11F                               sta famistudio_fds_mod_envelope+1
0A11F                               sta famistudio_fds_mod_speed+0
0A11F                               sta famistudio_fds_mod_speed+1
0A11F                               sta famistudio_fds_mod_depth
0A11F                               sta famistudio_fds_mod_delay
0A11F                               sta famistudio_fds_mod_delay_counter
0A11F                               sta famistudio_fds_override_flags
0A11F                               sta famistudio_fds_wave_index
0A11F                               .if FAMISTUDIO_USE_FDS_AUTOMOD    
0A11F                                   sta famistudio_fds_automod_numer
0A11F                                   sta famistudio_fds_automod_denom
0A11F                               .endif
0A11F                               .if FAMISTUDIO_USE_PHASE_RESET
0A11F                                   sta famistudio_fds_prev_hi
0A11F                               .endif
0A11F                           .endif
0A11F                           
0A11F                           .if FAMISTUDIO_EXP_N163
0A11F                               lda #0
0A11F                               ldx #(FAMISTUDIO_EXP_N163_CHN_CNT - 1)
0A11F                               @clear_n163_loop:
