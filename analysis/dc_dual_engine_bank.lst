0B3C6 00 00 00 00 00 00 00 00..     .org $b500
0B500                               .include "dc_dual_audio_bridge.asm"
0B500                           ; Dual-engine dispatcher for the expanded Mapper 194 DC.nes.
0B500                           ;
0B500                           ; Stock songs and stock SFX remain on the original driver. Commands $9D-$9F
0B500                           ; select the three unbound FamiStudio songs. While one of those songs is
0B500                           ; active, commands $00-$37 use the migrated FamiStudio SFX set so that music
0B500                           ; and effects share one APU owner.
0B500                           ;
0B500                           ; Both engines reuse the stock driver's certified $0028-$005D/$0400-$046F
0B500                           ; RAM, but never update in the same frame. $004C-$0056 is saved around each
0B500                           ; FamiStudio update because it is both the game interface and the compact
0B500                           ; engine's transient APU output buffer.
0B500                           
0B500                           music_command = $004c
0B500                           music_state   = $004d
0B500                           music_current = $0052
0B500                           music_limit   = $0053
0B500                           
0B500                           command_temp = $0028
0B500                           
0B500                           bridge_magic_a = $0468
0B500                           bridge_magic_b = $0469
0B500                           bridge_magic_c = $046a
0B500                           custom_state   = $046b
0B500                           
0B500                           famistudio_sfx_ptr_hi = $045b
0B500                           
0B500                           mapper_select = $8000
0B500                           mapper_data   = $8001
0B500                           
0B500                           custom_first = $9d
0B500                           custom_count = 3
0B500                           stock_low_bank = $60
0B500                           
0B500                           engine_init     = $a000
0B500                           engine_play     = $a003
0B500                           engine_stop     = $a006
0B500                           engine_update   = $a009
0B500                           engine_sfx_init = $a00c
0B500                           engine_sfx_play = $a00f
0B500                           data_banks      = $a012
0B500                           stock_restore_dispatch = $99bc
0B500                           stock_handoff_dispatch = $99ec
0B500                           
0B500                           dc_dual_audio_bridge:
0B500                               ; A direct custom selector always wins. The stock driver is allowed to
0B500                               ; overwrite the bridge bytes while inactive, so do not test magic first.
0B500 A5 4C                         lda music_command
0B502 C9 9D                         cmp #custom_first
0B504 90 12                         bcc @check_active
0B506 C9 A0                         cmp #custom_first + custom_count
0B508 B0 0E                         bcs @check_active
0B50A 85 28                         sta command_temp
0B50C A9 FF                         lda #$ff
0B50E 85 4C                         sta music_command
0B510 A5 28                         lda command_temp
0B512 20 DE B5                      jsr @start_custom_song
0B515 4C 64 B5                      jmp @update
0B518                           
0B518                           @check_active:
0B518 AD 68 04                      lda bridge_magic_a
0B51B C9 5A                         cmp #$5a
0B51D F0 03                         beq @magic_a_valid
0B51F 4C BC B5                      jmp @stock_update
0B522                           @magic_a_valid:
0B522 AD 69 04                      lda bridge_magic_b
0B525 C9 A5                         cmp #$a5
0B527 F0 03                         beq @magic_b_valid
0B529 4C BC B5                      jmp @stock_update
0B52C                           @magic_b_valid:
0B52C AD 6A 04                      lda bridge_magic_c
0B52F C9 C3                         cmp #$c3
0B531 F0 03                         beq @magic_c_valid
0B533 4C BC B5                      jmp @stock_update
0B536                           @magic_c_valid:
0B536 AD 6B 04                      lda custom_state
0B539 C9 9D                         cmp #custom_first
0B53B 90 7F                         bcc @stock_update
0B53D C9 A0                         cmp #custom_first + custom_count
0B53F B0 7B                         bcs @stock_update
0B541                           
0B541 A5 4C                         lda music_command
0B543 C9 FF                         cmp #$ff
0B545 F0 1D                         beq @update
0B547 85 28                         sta command_temp
0B549 A9 FF                         lda #$ff
0B54B 85 4C                         sta music_command
0B54D                           
0B54D A5 28                         lda command_temp
0B54F 30 6F                         bmi @leave_with_stock_command
0B551 C9 38                         cmp #$38
0B553 B0 0F                         bcs @update
0B555                           
0B555 A5 53                         lda music_limit
0B557 C5 28                         cmp command_temp
0B559 90 09                         bcc @update
0B55B A5 28                         lda command_temp
0B55D 85 53                         sta music_limit
0B55F A2 00                         ldx #$00
0B561 20 0F A0                      jsr engine_sfx_play
0B564                           
0B564                           @update:
0B564 20 18 B6                      jsr @map_song_bank
0B567                           
0B567                               ; Preserve the complete game-facing zero-page interface while the compact
0B567                               ; FamiStudio engine uses it as an 11-byte call-local output buffer.
0B567 A5 4C                         lda $4c
0B569 48                            pha
0B56A A5 4D                         lda $4d
0B56C 48                            pha
0B56D A5 4E                         lda $4e
0B56F 48                            pha
0B570 A5 4F                         lda $4f
0B572 48                            pha
0B573 A5 50                         lda $50
0B575 48                            pha
0B576 A5 51                         lda $51
0B578 48                            pha
0B579 A5 52                         lda $52
0B57B 48                            pha
0B57C A5 53                         lda $53
0B57E 48                            pha
0B57F A5 54                         lda $54
0B581 48                            pha
0B582 A5 55                         lda $55
0B584 48                            pha
0B585 A5 56                         lda $56
0B587 48                            pha
0B588 20 09 A0                      jsr engine_update
0B58B 68                            pla
0B58C 85 56                         sta $56
0B58E 68                            pla
0B58F 85 55                         sta $55
0B591 68                            pla
0B592 85 54                         sta $54
0B594 68                            pla
0B595 85 53                         sta $53
0B597 68                            pla
0B598 85 52                         sta $52
0B59A 68                            pla
0B59B 85 51                         sta $51
0B59D 68                            pla
0B59E 85 50                         sta $50
0B5A0 68                            pla
0B5A1 85 4F                         sta $4f
0B5A3 68                            pla
0B5A4 85 4E                         sta $4e
0B5A6 68                            pla
0B5A7 85 4D                         sta $4d
0B5A9 68                            pla
0B5AA 85 4C                         sta $4c
0B5AC                           
0B5AC                               ; FamiStudio clears ptr_hi when its only SFX stream finishes.
0B5AC AD 5B 04                      lda famistudio_sfx_ptr_hi
0B5AF D0 04                         bne @return_to_game
0B5B1 A9 FF                         lda #$ff
0B5B3 85 53                         sta music_limit
0B5B5                           
0B5B5                           @return_to_game:
0B5B5 20 2B B6                      jsr @restore_stock_low_bank
0B5B8 18                            clc
0B5B9 4C BC 99                      jmp stock_restore_dispatch
0B5BC                           
0B5BC                           @stock_update:
0B5BC 38                            sec
0B5BD 4C BC 99                      jmp stock_restore_dispatch
0B5C0                           
0B5C0                           @leave_with_stock_command:
0B5C0                               ; The low-bank handoff maps the stock high bank, resets the old driver,
0B5C0                               ; then replays this command in the same NMI. A requested reset becomes the
0B5C0                               ; normal $FF update after the explicit reset call.
0B5C0 A5 28                         lda command_temp
0B5C2 C9 FE                         cmp #$fe
0B5C4 D0 02                         bne @handoff_command_ready
0B5C6 A9 FF                         lda #$ff
0B5C8                           @handoff_command_ready:
0B5C8 AA                            tax
0B5C9 A9 00                         lda #$00
0B5CB 8D 68 04                      sta bridge_magic_a
0B5CE 8D 69 04                      sta bridge_magic_b
0B5D1 8D 6A 04                      sta bridge_magic_c
0B5D4 8D 6B 04                      sta custom_state
0B5D7 20 2B B6                      jsr @restore_stock_low_bank
0B5DA 8A                            txa
0B5DB 4C EC 99                      jmp stock_handoff_dispatch
0B5DE                           
0B5DE                           @start_custom_song:
0B5DE 8D 6B 04                      sta custom_state
0B5E1 A9 5A                         lda #$5a
0B5E3 8D 68 04                      sta bridge_magic_a
0B5E6 A9 A5                         lda #$a5
0B5E8 8D 69 04                      sta bridge_magic_b
0B5EB A9 C3                         lda #$c3
0B5ED 8D 6A 04                      sta bridge_magic_c
0B5F0                           
0B5F0 AD 6B 04                      lda custom_state
0B5F3 29 1F                         and #$1f
0B5F5 85 52                         sta music_current
0B5F7 A9 00                         lda #$00
0B5F9 85 4D                         sta music_state
0B5FB A9 FF                         lda #$ff
0B5FD 85 53                         sta music_limit
0B5FF                           
0B5FF 20 18 B6                      jsr @map_song_bank
0B602 A2 00                         ldx #$00
0B604 A0 80                         ldy #$80
0B606 A9 01                         lda #$01
0B608 20 00 A0                      jsr engine_init
0B60B A2 1E                         ldx #<sounds
0B60D A0 A8                         ldy #>sounds
0B60F 20 0C A0                      jsr engine_sfx_init
0B612 A9 00                         lda #$00
0B614 20 03 A0                      jsr engine_play
0B617 60                            rts
0B618                           
0B618                           @map_song_bank:
0B618 AD 6B 04                      lda custom_state
0B61B 38                            sec
0B61C E9 9D                         sbc #custom_first
0B61E AA                            tax
0B61F A9 86                         lda #$86
0B621 8D 00 80                      sta mapper_select
0B624 BD 12 A0                      lda data_banks,x
0B627 8D 01 80                      sta mapper_data
0B62A 60                            rts
0B62B                           
0B62B                           @restore_stock_low_bank:
0B62B A9 86                         lda #$86
0B62D 8D 00 80                      sta mapper_select
0B630 A9 60                         lda #stock_low_bank
0B632 8D 01 80                      sta mapper_data
0B635 60                            rts
0B636                           
0B636                           dc_dual_audio_bridge_end:
0B636                           
0B636                           dc_dual_bridge_end:
0B636 00 00 00 00 00 00 00 00..     .org $c000
