0A50C                           .if FAMISTUDIO_EXP_EPSM
0A50C                               cmp #FAMISTUDIO_EPSM_CHAN_FM_START
0A50C                               bcs @note_table_epsm
0A50C                           .endif    
0A50C                               cmp #FAMISTUDIO_EXP_NOTE_START
0A50C                               bcs @note_table_expansion
0A50C                           .endif
0A50C                               sec ; Subtract the pitch of both notes.
0A50C                               lda famistudio_note_table_lsb,y
0A50C                               sbc famistudio_note_table_lsb,x
0A50C                               sta slide_delta_lo
0A50C                               lda famistudio_note_table_msb,y
0A50C                               sbc famistudio_note_table_msb,x
0A50C                           .ifdef FAMISTUDIO_EXP_NOTE_START
0A50C                               jmp @note_table_done
0A50C                           .if FAMISTUDIO_EXP_EPSM
0A50C                           @note_table_epsm:
