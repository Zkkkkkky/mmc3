0A312 A5 4C                         lda famistudio_output_buf      ; Pulse 1 volume
0A314 8D 00 40                      sta FAMISTUDIO_APU_PL1_VOL
0A317 A5 4D                         lda famistudio_output_buf+1    ; Pulse 1 period LSB
0A319 8D 02 40                      sta FAMISTUDIO_APU_PL1_LO
0A31C A5 4E                         lda famistudio_output_buf+2    ; Pulse 1 period MSB, only applied when changed
0A31E                           
0A31E                               .if FAMISTUDIO_CFG_SMOOTH_VIBRATO
0A31E                                   famistudio_smooth_vibrato famistudio_output_buf+1, famistudio_pulse1_prev, FAMISTUDIO_APU_PL1_HI, FAMISTUDIO_APU_PL1_LO, FAMISTUDIO_APU_PL1_SWEEP
0A31E                               .else
0A31E CD 6E 04                          cmp famistudio_pulse1_prev
0A321 F0 06                             beq @no_pulse1_upd
