0A064                           ;======================================================================================================================
0A064                           ; FAMISTUDIO_MUSIC_STOP (public)
0A064                           ;
0A064                           ; Stops any music currently playing, if any. Note that this will not update the APU, so sound might linger. Calling
0A064                           ; famistudio_update after this will update the APU.
0A064                           ; 
0A064                           ; [in] no input params.
0A064                           ;======================================================================================================================
0A064                           
0A064                           famistudio_music_stop:
0A064                           
0A064 A9 00                         lda #0
0A066 85 2F                         sta famistudio_song_speed
0A068                           .if FAMISTUDIO_CFG_DPCM_SUPPORT
0A068                               sta famistudio_dpcm_effect
0A068                           .endif
0A068                           
0A068 A2 00                         ldx #0
0A06A                           
0A06A                           @set_channels:
0A06A                           
0A06A 9D 4F 04                      sta famistudio_chn_repeat,x
0A06D 9D 4A 04                      sta famistudio_chn_note,x
0A070 95 37                         sta famistudio_chn_ref_len,x
0A072                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A072 95 42                             sta famistudio_chn_volume_track,x
0A074                               .endif    
0A074                               .if FAMISTUDIO_USE_VIBRATO || FAMISTUDIO_USE_ARPEGGIO
0A074                                   sta famistudio_chn_env_override,x
0A074                               .endif
0A074                               .if FAMISTUDIO_CFG_EQUALIZER
0A074                                   sta famistudio_chn_note_counter,x
0A074                               .endif    
0A074                               .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A074                                   lda #$ff
0A074                                   sta famistudio_chn_note_delay,x
0A074                                   sta famistudio_chn_cut_delay,x
0A074                                   lda #0
0A074                               .endif
0A074 E8                            inx
0A075 E0 05                         cpx #FAMISTUDIO_NUM_CHANNELS
0A077 D0 F1                         bne @set_channels
0A079                           
0A079                           .if FAMISTUDIO_USE_DUTYCYCLE_EFFECT
0A079                           ldx #0
0A079                           @set_duty_cycles:
0A079                               sta famistudio_duty_cycle,x
0A079                               inx
0A079                               cpx #FAMISTUDIO_NUM_DUTY_CYCLES
0A079                               bne @set_duty_cycles
0A079                           .endif
0A079                           
0A079                           .if FAMISTUDIO_USE_SLIDE_NOTES
0A079                               ldx #0
0A079                           @set_slides:
0A079                               sta famistudio_slide_step, x
0A079                               inx
0A079                               cpx #FAMISTUDIO_NUM_SLIDES
0A079                               bne @set_slides
0A079                           .endif
0A079                           
0A079                           .if FAMISTUDIO_USE_VOLUME_SLIDES
0A079                               ldx #0
0A079                           @set_volume_slides:
0A079                               sta famistudio_chn_volume_slide_step, x
0A079                               sta famistudio_chn_volume_slide_target, x
0A079                               inx
0A079                               cpx #FAMISTUDIO_NUM_VOLUME_SLIDES
0A079                               bne @set_volume_slides
0A079                           .endif
0A079                           
0A079 A2 00                         ldx #0
0A07B                           
0A07B                           @set_envelopes:
0A07B                           
0A07B A9 41                         lda #<famistudio_dummy_envelope
0A07D 9D 16 04                      sta famistudio_env_addr_lo,x
0A080 A9 A6                         lda #>famistudio_dummy_envelope
0A082 9D 21 04                      sta famistudio_env_addr_hi,x
0A085 A9 00                         lda #0
0A087 9D 0B 04                      sta famistudio_env_repeat,x
0A08A 9D 00 04                      sta famistudio_env_value,x
0A08D 9D 35 04                      sta famistudio_env_ptr,x
0A090 E8                            inx
0A091 E0 0B                         cpx #FAMISTUDIO_NUM_ENVELOPES
0A093 D0 E6                         bne @set_envelopes
0A095                           
0A095 A2 00                         ldx #0
0A097                           @set_pitch_envelopes:
0A097                           
0A097 A9 45                         lda #<famistudio_dummy_pitch_envelope
0A099 95 3F                         sta famistudio_pitch_env_addr_lo,x
0A09B A9 A6                         lda #>famistudio_dummy_pitch_envelope
0A09D 95 47                         sta famistudio_pitch_env_addr_hi,x
0A09F A9 00                         lda #0
0A0A1 95 3C                         sta famistudio_pitch_env_repeat,x
0A0A3 9D 2C 04                      sta famistudio_pitch_env_value_lo,x
0A0A6 9D 2F 04                      sta famistudio_pitch_env_value_hi,x
0A0A9                               .if FAMISTUDIO_USE_PITCH_TRACK
0A0A9 9D 32 04                          sta famistudio_pitch_env_fine_value,x
0A0AC                               .endif
0A0AC A9 01                         lda #1
0A0AE 95 57                         sta famistudio_pitch_env_ptr,x
0A0B0 E8                            inx
0A0B1 E0 03                         cpx #FAMISTUDIO_NUM_PITCH_ENVELOPES
0A0B3 D0 E2                         bne @set_pitch_envelopes
0A0B5                           
0A0B5 4C 37 A5                      jmp famistudio_sample_stop
