0A32B 8D 04 40                      sta FAMISTUDIO_APU_PL2_VOL
0A32E A5 50                         lda famistudio_output_buf+4    ; Pulse 2 period LSB
0A330 8D 06 40                      sta FAMISTUDIO_APU_PL2_LO
0A333 A5 51                         lda famistudio_output_buf+5    ; Pulse 2 period MSB, only applied when changed
0A335                           
0A335                               .if FAMISTUDIO_CFG_SMOOTH_VIBRATO
0A335                                   famistudio_smooth_vibrato famistudio_output_buf+4, famistudio_pulse2_prev, FAMISTUDIO_APU_PL2_HI, FAMISTUDIO_APU_PL2_LO, FAMISTUDIO_APU_PL2_SWEEP
0A335                               .else
0A335 CD 6F 04                          cmp famistudio_pulse2_prev
0A338 F0 06                             beq @no_pulse2_upd
0A33A 8D 6F 04                          sta famistudio_pulse2_prev
0A33D 8D 07 40                          sta FAMISTUDIO_APU_PL2_HI
0A340                               .endif
0A340                           
0A340                           @no_pulse2_upd:
