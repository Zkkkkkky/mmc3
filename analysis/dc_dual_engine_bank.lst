0A50C                               sec
0A50C                               sbc (channel_data_ptr),y ; Read slide note to
0A50C                               sta famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               bpl @positive_noise_slide
0A50C                           @negative_noise_slide:
0A50C                               ; Sign extend.
0A50C                               lda #$ff
0A50C                               bmi @noise_shift
0A50C                           @positive_noise_slide:
0A50C                               lda #$00
