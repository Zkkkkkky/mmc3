0A50C                                   asl ; Shift-left, we have 1 bit of fractional slide.
0A50C                                   sta famistudio_slide_pitch_lo,x
0A50C                                   rol famistudio_slide_pitch_hi,x ; Shift-left, we have 1 bit of fractional slide.
0A50C                               .if FAMISTUDIO_EXP_N163 || FAMISTUDIO_EXP_VRC7 || FAMISTUDIO_EXP_EPSM
0A50C                                   jmp @shift_done
0A50C                               @positive_shift:
0A50C                                   lda slide_delta_lo
0A50C                                   sta famistudio_slide_pitch_lo,x
0A50C                                   ldy #FAMISTUDIO_PITCH_SHIFT
0A50C                                   @positive_shift_loop:
0A50C                                       lda famistudio_slide_pitch_hi,x
0A50C                                       cmp #$80
0A50C                                       ror famistudio_slide_pitch_hi,x 
0A50C                                       ror famistudio_slide_pitch_lo,x
0A50C                                       dey 
0A50C                                       bne @positive_shift_loop
0A50C                               @shift_done:
0A50C                               .endif
0A50C                               ldx chan_idx
0A50C                               ldy tmp_y2
0A50C                           
0A50C                           @slide_done_pos:
0A50C                               lda (channel_data_ptr),y ; Re-read the target note (ugly...)
0A50C                               sta famistudio_chn_note,x ; Store note code
0A50C                               iny
0A50C                               jmp @cancel_delayed_cut
0A50C                           .endif
