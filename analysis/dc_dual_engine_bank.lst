0A306                           .if FAMISTUDIO_USE_FAMITRACKER_TEMPO
0A306                               lda famistudio_song_speed
0A306                               bmi @skip_famitracker_tempo_update ; bit 7 = paused
0A306                                   clc  ; Update frame counter that considers speed, tempo, and PAL/NTSC
0A306                                   lda famistudio_tempo_acc_lo
0A306                                   adc famistudio_tempo_step_lo
0A306                                   sta famistudio_tempo_acc_lo
0A306                                   lda famistudio_tempo_acc_hi
0A306                                   adc famistudio_tempo_step_hi
0A306                                   sta famistudio_tempo_acc_hi
0A306                               @skip_famitracker_tempo_update:
0A306                           .else
