0A141                           
0A141                           ;======================================================================================================================
0A141                           ; FAMISTUDIO_GET_NOTE_PITCH_MACRO (internal)
0A141                           ;
0A141                           ; Uber-macro used to compute the final pitch of a note, taking into account the current note, arpeggios, instrument
0A141                           ; pitch envelopes, slide notes and fine pitch tracks.
0A141                           ; 
0A141                           ; [in] x : note index.
0A141                           ; [in] y : slide/pitch envelope index.
0A141                           ; [out] famistudio_ptr1 : Final note pitch.
0A141                           ;======================================================================================================================
0A141                           
0A141                           .macro famistudio_get_note_pitch_macro pitch_env_offset, pitch_shift, note_table_lsb, note_table_msb
0A141                           
0A141                               pitch   = famistudio_ptr1
0A141                               tmp_ror = famistudio_r0
0A141                           
0A141                           .if FAMISTUDIO_USE_PITCH_TRACK
0A141                           
0A141                               ; Pitch envelope + fine pitch (sign extended)
0A141                               clc
0A141                               lda famistudio_pitch_env_fine_value+pitch_env_offset, y 
0A141                               adc famistudio_pitch_env_value_lo+pitch_env_offset, y 
0A141                               sta pitch+0
0A141                               lda famistudio_pitch_env_fine_value+pitch_env_offset, y 
0A141                               and #$80
0A141                               beq pos
0A141                               lda #$ff
0A141                           pos:
0A141                               adc famistudio_pitch_env_value_hi+pitch_env_offset, y 
0A141                               sta pitch+1
0A141                           
0A141                           .else
0A141                           
0A141                               ; Pitch envelope only
0A141                               lda famistudio_pitch_env_value_lo+pitch_env_offset, y 
0A141                               sta pitch+0
0A141                               lda famistudio_pitch_env_value_hi+pitch_env_offset, y 
0A141                               sta pitch+1
0A141                           
0A141                           .endif
0A141                           
0A141                           .if FAMISTUDIO_USE_SLIDE_NOTES
0A141                           
0A141                               ; Check if there is an active slide.
0A141                               lda famistudio_slide_step+pitch_env_offset, y 
0A141                               beq no_slide
0A141                           
0A141                               ; Add slide
0A141                           .if pitch_shift >= 1
0A141                               ; These channels dont have fractional part for slides and have the same shift for slides + pitch.
0A141                               clc
0A141                               lda famistudio_slide_pitch_lo+pitch_env_offset, y 
0A141                               adc pitch+0
0A141                               sta pitch+0
0A141                               lda famistudio_slide_pitch_hi+pitch_env_offset, y 
0A141                               adc pitch+1
0A141                               sta pitch+1     
0A141                            .else
0A141                               ; Most channels have 1 bit of fraction for slides.
0A141                               lda famistudio_slide_pitch_hi+pitch_env_offset, y 
0A141                               cmp #$80 ; Sign extend upcoming right shift.
0A141                               ror ; We have 1 bit of fraction for slides, shift right hi byte.
0A141                               sta tmp_ror
0A141                               lda famistudio_slide_pitch_lo+pitch_env_offset, y 
0A141                               ror ; Shift right low byte.
0A141                               clc
0A141                               adc pitch+0
0A141                               sta pitch+0
0A141                               lda tmp_ror
0A141                               adc pitch+1 
0A141                               sta pitch+1 
0A141                           .endif
0A141                           .endif
0A141                           
0A141                           no_slide:    
0A141                           
0A141                               .if pitch_shift >= 1
0A141                                   asl pitch+0
0A141                                   rol pitch+1
0A141                               .if pitch_shift >= 2
0A141                                   asl pitch+0
0A141                                   rol pitch+1
0A141                               .if pitch_shift >= 3
0A141                                   asl pitch+0
0A141                                   rol pitch+1
0A141                               .if pitch_shift >= 4
0A141                                   asl pitch+0
0A141                                   rol pitch+1
0A141                               .if pitch_shift >= 5
0A141                                   asl pitch+0
0A141                                   rol pitch+1
0A141                               .endif 
0A141                               .endif
0A141                               .endif
0A141                               .endif
0A141                               .endif
0A141                           
0A141                               ; Finally, add note pitch.
0A141                               clc
0A141                               lda note_table_lsb,x
0A141                               adc pitch+0
0A141                               sta pitch+0
0A141                               lda note_table_msb,x
0A141                               adc pitch+1
0A141                               sta pitch+1   
0A141                           
0A141                           .endm
0A141                           
0A141                           famistudio_get_note_pitch:
0A141 18 B9 32 04 79 2C 04 85..     famistudio_get_note_pitch_macro 0, 0, famistudio_note_table_lsb, famistudio_note_table_msb
0A167 60                            rts
0A168                           
0A168                           .if FAMISTUDIO_EXP_VRC6
0A168                           famistudio_get_note_pitch_vrc6_saw:
0A168                               famistudio_get_note_pitch_macro 0, 0, famistudio_saw_note_table_lsb, famistudio_saw_note_table_msb
0A168                               rts
0A168                           .endif
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_SMOOTH_VIBRATO (internal)
0A168                           ;
0A168                           ; Implementation of Blaarg's smooth vibrato to eliminate pops on square channels. Called either from regular channel
0A168                           ; updates or from SFX code.
0A168                           ;
0A168                           ; [in] a : new hi period.
0A168                           ;======================================================================================================================
0A168                           
0A168                           .macro famistudio_smooth_vibrato pulse_lo, pulse_prev, reg_hi, reg_lo, reg_sweep
0A168                           
0A168                               ; Blaarg's smooth vibrato technique, only used if high period delta is 1 or -1.
0A168                               and #7 ; Clamp hi-period to sane range, breaks smooth vibrato otherwise.
0A168                               tax ; X = new hi-period
0A168                               sec
0A168                               sbc pulse_prev ; A = signed hi-period delta.
0A168                               beq done
0A168                               stx pulse_prev
0A168                               tay 
0A168                               iny ; We only care about -1 ($ff) and 1. Adding one means we only check of 0 or 2, we already checked for zero (so < 3).
0A168                               cpy #$03
0A168                               bcs hi_delta_too_big
0A168                               ldx #$40
0A168                               stx FAMISTUDIO_APU_FRAME_CNT ; Reset frame counter in case it was about to clock
0A168                               lda famistudio_smooth_vibrato_period_lo_lookup, y ; Be sure low 8 bits of timer period are $ff (for positive delta), or $00 (for negative delta)
0A168                               sta reg_lo
0A168                               lda famistudio_smooth_vibrato_sweep_lookup, y ; Sweep enabled, shift = 7, set negative flag or delta is negative..
0A168                               sta reg_sweep
0A168                               lda #$c0
0A168                               sta FAMISTUDIO_APU_FRAME_CNT ; Clock sweep immediately
0A168                               lda #$08
0A168                               sta reg_sweep ; Disable sweep
0A168                               lda pulse_lo
0A168                               sta reg_lo ; Restore lo-period.
0A168                               jmp done
0A168                           hi_delta_too_big:
0A168                               stx reg_hi
0A168                           done:
0A168                           .endm
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Uber-macro used to update the APU registers for a given 2A03/VRC6/MMC5 channel. This macro is an absolute mess, but
0A168                           ; it is still more maintainable than having many different functions.
0A168                           ;
0A168                           ; [in] no input params.
0A168                           ;======================================================================================================================
0A168                           
0A168                           .macro famistudio_update_channel_sound idx, env_offset, pulse_prev, reg_hi, reg_lo, reg_vol, reg_sweep, phase_reset_mask
0A168                           
0A168                               tmp   = famistudio_r0
0A168                               pitch = famistudio_ptr1
0A168                           
0A168                               lda famistudio_chn_note+idx
0A168                               bne nocut
0A168                               jmp set_volume
0A168                           
0A168                           nocut:
0A168                               clc
0A168                               adc famistudio_env_value+env_offset+FAMISTUDIO_ENV_NOTE_OFF
0A168                           
0A168                           .if idx = 3 ; Noise channel is a bit special    
0A168                           
0A168                           .if FAMISTUDIO_USE_NOISE_SLIDE_NOTES
0A168                           
0A168                               ; Check if there is an active slide on the noise channel.
0A168                               ldy famistudio_slide_step+FAMISTUDIO_NOISE_SLIDE_INDEX
0A168                               beq no_noise_slide
0A168                           
0A168                                   ; We have 4 bits of fraction for noise slides.
0A168                                   sta tmp
0A168                           
0A168                                   lda famistudio_slide_pitch_lo+FAMISTUDIO_NOISE_SLIDE_INDEX
0A168                                   sta pitch+0
0A168                                   lda famistudio_slide_pitch_hi+FAMISTUDIO_NOISE_SLIDE_INDEX
0A168                                   cmp #$80
0A168                                   ror
0A168                                   ror pitch+0
0A168                                   cmp #$80
0A168                                   ror
0A168                                   ror pitch+0
0A168                                   cmp #$80
0A168                                   ror
0A168                                   ror pitch+0
0A168                                   cmp #$80
0A168                                   ror
0A168                                   lda pitch+0
0A168                                   ror
0A168                           
0A168                                   clc 
0A168                                   adc tmp
0A168                           
0A168                           .endif
0A168                           
0A168                           no_noise_slide:
0A168                               and #$0f
0A168                               eor #$0f
0A168                               sta tmp
0A168                           
0A168                               ldx famistudio_env_value+env_offset+FAMISTUDIO_ENV_DUTY_OFF
0A168                               lda famistudio_duty_lookup, x
0A168                               asl a
0A168                               and #$80
0A168                               ora tmp
0A168                           
0A168                           .else
0A168                           
0A168                               .if FAMISTUDIO_DUAL_SUPPORT
0A168                                   clc
0A168                                   adc famistudio_pal_adjust
0A168                               .endif
0A168                               tax
0A168                           
0A168                               ; This basically does same as "famistudio_channel_to_pitch_env"
0A168                               .if idx < 3
0A168                                   ldy #idx
0A168                               .else
0A168                                   ldy #(idx - 2)
0A168                               .endif
0A168                           
0A168                               .if FAMISTUDIO_EXP_VRC6 && idx = FAMISTUDIO_VRC6_CH2_IDX
0A168                                   jsr famistudio_get_note_pitch_vrc6_saw
0A168                               .else
0A168                                   jsr famistudio_get_note_pitch
0A168                               .endif
0A168                           
0A168                               lda pitch+0
0A168                               sta reg_lo
0A168                               lda pitch+1
0A168                           
0A168                               ; HACK : VRC6 only. We are out of macro param for NESASM. TODO : Is that still true?
0A168                               .if idx >= FAMISTUDIO_VRC6_CH0_IDX && idx <= FAMISTUDIO_VRC6_CH2_IDX 
0A168                                   .if FAMISTUDIO_USE_PHASE_RESET
0A168                                       sta pulse_prev
0A168                                   .endif
0A168                                   ora #$80
0A168                               .else
0A168                                   .if pulse_prev && (!FAMISTUDIO_CFG_SFX_SUPPORT || !reg_sweep)
0A168                                       .if reg_sweep && FAMISTUDIO_CFG_SMOOTH_VIBRATO
0A168                                           famistudio_smooth_vibrato famistudio_ptr1, pulse_prev, reg_hi, reg_lo, reg_sweep
0A168                                       .else
0A168                                           cmp pulse_prev
0A168                                           beq compute_volume
0A168                                           sta pulse_prev    
0A168                                       .endif
0A168                                   .endif
0A168                               .endif
0A168                           
0A168                           .endif ; idx = 3
0A168                           
0A168                           .if (!pulse_prev) || (!reg_sweep) || FAMISTUDIO_CFG_SFX_SUPPORT || (!FAMISTUDIO_CFG_SMOOTH_VIBRATO)
0A168                               sta reg_hi
0A168                           .endif
0A168                           
0A168                           compute_volume:
0A168                           
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK    
0A168                                   lda famistudio_chn_volume_track+idx
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif
0A168                                   ora famistudio_env_value+env_offset+FAMISTUDIO_ENV_VOLUME_OFF
0A168                                   tax
0A168                                   lda famistudio_volume_table, x 
0A168                               .else
0A168                                   lda famistudio_env_value+env_offset+FAMISTUDIO_ENV_VOLUME_OFF
0A168                               .endif
0A168                           
0A168                           .if FAMISTUDIO_EXP_VRC6 && (idx = FAMISTUDIO_VRC6_CH2_IDX)
0A168                               ; VRC6 saw has 6-bits
0A168                               ldx famistudio_vrc6_saw_volume
0A168                               bmi set_volume 
0A168                               asl
0A168                               ldx famistudio_vrc6_saw_volume
0A168                               beq set_volume
0A168                               asl
0A168                           .endif
0A168                           
0A168                           set_volume:
0A168                           
0A168                           .if idx = 0 || idx = 1 || idx = 3 || (FAMISTUDIO_EXP_MMC5 && (idx = FAMISTUDIO_MMC5_CH0_IDX || idx = FAMISTUDIO_MMC5_CH1_IDX))
0A168                               ldx famistudio_env_value+env_offset+FAMISTUDIO_ENV_DUTY_OFF
0A168                               ora famistudio_duty_lookup, x
0A168                           .elseif FAMISTUDIO_EXP_VRC6 && (idx = FAMISTUDIO_VRC6_CH0_IDX || idx = FAMISTUDIO_VRC6_CH1_IDX)
0A168                               ldx famistudio_env_value+env_offset+FAMISTUDIO_ENV_DUTY_OFF
0A168                               ora famistudio_vrc6_duty_lookup, x
0A168                           .endif
0A168                           
0A168                           ; HACK : We are out of macro param for NESASM.
0A168                           .if idx = 2
0A168                               ora #$80
0A168                           .elseif idx = 3
0A168                               ora #$f0
0A168                           .endif
0A168                           
0A168                               sta reg_vol
0A168                           
0A168                           .endm
0A168                           
0A168                           .if FAMISTUDIO_EXP_FDS
0A168                           
0A168                           .if FAMISTUDIO_USE_FDS_AUTOMOD
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_MUL (internal)
0A168                           ;
0A168                           ; From : https://codebase64.org/doku.php?id=base:8bit_multiplication_16bit_product
0A168                           ; Using the 16x8 version. May overflow if using too large numbers.
0A168                           ;
0A168                           ; [in]  ptr0 : 16-bit number
0A168                           ; [in]  r1   : 8-bit number
0A168                           ; [out] x+a  : Result lo-byte
0A168                           ; [out] y    : Result hi-byte
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_mul:
0A168                           
0A168                               num1 = famistudio_ptr1
0A168                               num2 = famistudio_r1
0A168                           
0A168                               lda #$00
0A168                               tay
0A168                               beq @enter_loop
0A168                           @do_add:
0A168                               clc
0A168                               adc num1+0
0A168                               tax
0A168                               tya
0A168                               adc num1+1
0A168                               tay
0A168                               txa
0A168                           @loop:
0A168                               asl num1+0
0A168                               rol num1+1
0A168                           @enter_loop:
0A168                               lsr num2
0A168                               bcs @do_add
0A168                               bne @loop
0A168                               rts
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_DIV (internal)
0A168                           ;
0A168                           ; From : https://forums.nesdev.org/viewtopic.php?p=895&sid=5c263dea8d9e3cf15cd1093856f211a9#p895 (tepples)
0A168                           ;
0A168                           ; [in]  ptr0 : 16-bit number
0A168                           ; [in]  r1   : 8-bit divisor
0A168                           ; [out] ptr0 : Result
0A168                           ; [out] a    : Remainder
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_div:
0A168                           
0A168                               dividend = famistudio_ptr1
0A168                               divisor  = famistudio_r1
0A168                           
0A168                               ldx #16
0A168                               lda #0
0A168                           @divloop:
0A168                               asl dividend
0A168                               rol dividend+1
0A168                               rol a
0A168                               cmp divisor
0A168                               bcc @no_sub
0A168                               sbc divisor
0A168                               inc dividend
0A168                           @no_sub:
0A168                               dex
0A168                               bne @divloop
0A168                               rts
0A168                           
0A168                           .endif
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_FDS_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the FDS audio registers.
0A168                           ;
0A168                           ; [in] no input params.
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_update_fds_channel_sound:
0A168                           
0A168                               pitch = famistudio_ptr1
0A168                               mul   = famistudio_r1
0A168                               div   = famistudio_r1
0A168                           
0A168                               lda famistudio_chn_note+FAMISTUDIO_FDS_CH0_IDX
0A168                               bne @nocut
0A168                               lda #0 ; Disable mod on note off
0A168                               sta FAMISTUDIO_FDS_MOD_LO
0A168                               sta FAMISTUDIO_FDS_SWEEP_BIAS
0A168                               lda #$80
0A168                               sta FAMISTUDIO_FDS_MOD_HI
0A168                               sta FAMISTUDIO_FDS_SWEEP_ENV
0A168                               jmp @set_volume
0A168                           
0A168                           @nocut:
0A168                           
0A168                               jsr famistudio_update_fds_wave
0A168                           
0A168                               lda famistudio_chn_note+FAMISTUDIO_FDS_CH0_IDX
0A168                               clc
0A168                               adc famistudio_env_value+FAMISTUDIO_FDS_CH0_ENVS+FAMISTUDIO_ENV_NOTE_OFF
0A168                               .if FAMISTUDIO_DUAL_SUPPORT
0A168                                   clc
0A168                                   adc famistudio_pal_adjust
0A168                               .endif
0A168                               tax
0A168                           
0A168                               ldy #0
0A168                               famistudio_get_note_pitch_macro FAMISTUDIO_FDS_CH0_PITCH_ENV_IDX, 0, famistudio_fds_note_table_lsb, famistudio_fds_note_table_msb
0A168                           
0A168                               lda pitch+0
0A168                               sta FAMISTUDIO_FDS_FREQ_LO
0A168                               lda pitch+1
0A168                               sta FAMISTUDIO_FDS_FREQ_HI
0A168                               .if FAMISTUDIO_USE_PHASE_RESET
0A168                                   sta famistudio_fds_prev_hi
0A168                               .endif
0A168                           
0A168                           @check_mod_delay:
0A168                               lda famistudio_fds_mod_delay_counter
0A168                               beq @zero_delay
0A168                               lda #0
0A168                               sta FAMISTUDIO_FDS_MOD_LO
0A168                               sta FAMISTUDIO_FDS_SWEEP_BIAS
0A168                               lda #$80
0A168                               sta FAMISTUDIO_FDS_MOD_HI
0A168                               sta FAMISTUDIO_FDS_SWEEP_ENV
0A168                               dec famistudio_fds_mod_delay_counter
0A168                               bne @compute_volume
0A168                           
0A168                           @zero_delay:
0A168                           
0A168                               lda famistudio_fds_mod_depth
0A168                               beq @mod_depth
0A168                           
0A168                               .if FAMISTUDIO_USE_FDS_AUTOMOD
0A168                                   lda famistudio_fds_automod_numer
0A168                                   beq @manual_mod
0A168                           
0A168                                   @auto_mod_mul_div:
0A168                                       sta mul
0A168                                       jsr famistudio_mul
0A168                                       stx pitch+0
0A168                                       sty pitch+1
0A168                                       lda famistudio_fds_automod_denom
0A168                                       sta div
0A168                                       jsr famistudio_div
0A168                                       lda pitch+1
0A168                                       cmp #$10
0A168                                       bcc @write_auto_mod
0A168                                       @write_max:
0A168                                           lda #$0f
0A168                                           sta FAMISTUDIO_FDS_MOD_HI
0A168                                           lda #$ff
0A168                                           sta FAMISTUDIO_FDS_MOD_LO  
0A168                                           jmp @mod_depth
0A168                           
0A168                                       @write_auto_mod:
0A168                                           sta FAMISTUDIO_FDS_MOD_HI
0A168                                           lda pitch+0
0A168                                           sta FAMISTUDIO_FDS_MOD_LO  
0A168                                           jmp @mod_depth
0A168                               .endif
0A168                           
0A168                               @manual_mod:
0A168                                   lda famistudio_fds_mod_speed+1
0A168                                   sta FAMISTUDIO_FDS_MOD_HI
0A168                                   lda famistudio_fds_mod_speed+0
0A168                                   sta FAMISTUDIO_FDS_MOD_LO
0A168                           
0A168                               @mod_depth:
0A168                                   lda famistudio_fds_mod_depth
0A168                                   ora #$80
0A168                                   sta FAMISTUDIO_FDS_SWEEP_ENV
0A168                           
0A168                           @compute_volume:
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_FDS_CH0_IDX 
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif        
0A168                                   ora famistudio_env_value+FAMISTUDIO_FDS_CH0_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
0A168                                   tax
0A168                                   lda famistudio_volume_table, x 
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_FDS_CH0_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
0A168                               .endif
0A168                               asl ; FDS volume is 6-bits, but clamped to 32. Just double it.
0A168                           
0A168                           @set_volume:
0A168                               ora #$80
0A168                               sta FAMISTUDIO_FDS_VOL_ENV
0A168                               lda #0
0A168                               sta famistudio_fds_override_flags
0A168                               rts 
0A168                           
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_EXP_VRC7
0A168                           
0A168                           famistudio_vrc7_reg_table_lo:
0A168                               .byte FAMISTUDIO_VRC7_REG_LO_1, FAMISTUDIO_VRC7_REG_LO_2, FAMISTUDIO_VRC7_REG_LO_3, FAMISTUDIO_VRC7_REG_LO_4, FAMISTUDIO_VRC7_REG_LO_5, FAMISTUDIO_VRC7_REG_LO_6
0A168                           famistudio_vrc7_reg_table_hi:
0A168                               .byte FAMISTUDIO_VRC7_REG_HI_1, FAMISTUDIO_VRC7_REG_HI_2, FAMISTUDIO_VRC7_REG_HI_3, FAMISTUDIO_VRC7_REG_HI_4, FAMISTUDIO_VRC7_REG_HI_5, FAMISTUDIO_VRC7_REG_HI_6
0A168                           famistudio_vrc7_vol_table:
0A168                               .byte FAMISTUDIO_VRC7_REG_VOL_1, FAMISTUDIO_VRC7_REG_VOL_2, FAMISTUDIO_VRC7_REG_VOL_3, FAMISTUDIO_VRC7_REG_VOL_4, FAMISTUDIO_VRC7_REG_VOL_5, FAMISTUDIO_VRC7_REG_VOL_6
0A168                           famistudio_vrc7_env_table:
0A168                               .byte FAMISTUDIO_VRC7_CH0_ENVS, FAMISTUDIO_VRC7_CH1_ENVS, FAMISTUDIO_VRC7_CH2_ENVS, FAMISTUDIO_VRC7_CH3_ENVS, FAMISTUDIO_VRC7_CH4_ENVS, FAMISTUDIO_VRC7_CH5_ENVS 
0A168                           famistudio_vrc7_invert_vol_table:
0A168                               .byte $0f, $0e, $0d, $0c, $0b, $0a, $09, $08, $07, $06, $05, $04, $03, $02, $01, $00
0A168                           
0A168                           ; From nesdev wiki.
0A168                           famistudio_vrc7_wait_reg_write:
0A168                               stx famistudio_vrc7_dummy
0A168                               ldx #$08
0A168                               @wait_loop:
0A168                                   dex
0A168                                   bne @wait_loop
0A168                                   ldx famistudio_vrc7_dummy
0A168                               rts
0A168                           
0A168                           ; From nesdev wiki.
0A168                           famistudio_vrc7_wait_reg_select:
0A168                               rts
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_VRC7_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the VRC7 audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: VRC7 channel idx (0,1,2,3,4,5)
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_update_vrc7_channel_sound:
0A168                           
0A168                               tmp   = famistudio_r0
0A168                               pitch = famistudio_ptr1
0A168                           
0A168                           check_cut:
0A168                               lda famistudio_chn_note+FAMISTUDIO_VRC7_CH0_IDX,y
0A168                               bne check_release
0A168                           
0A168                           cut:  
0A168                               ; Untrigger note.  
0A168                               lda famistudio_vrc7_reg_table_hi,y
0A168                               sta FAMISTUDIO_VRC7_REG_SEL
0A168                               jsr famistudio_vrc7_wait_reg_select
0A168                           
0A168                               lda famistudio_chn_vrc7_sustain
0A168                               bmi override_stop
0A168                               lda famistudio_chn_vrc7_prev_hi, y
0A168                               and #$cf
0A168                               bne apply_cut
0A168                           
0A168                           override_stop:
0A168                               lda famistudio_chn_vrc7_prev_hi, y
0A168                               and #$ef
0A168                               ora #$20 ; Set sustain flag to override
0A168                           
0A168                           apply_cut:
0A168                               sta famistudio_chn_vrc7_prev_hi, y
0A168                               sta FAMISTUDIO_VRC7_REG_WRITE
0A168                               jsr famistudio_vrc7_wait_reg_write
0A168                           
0A168                               rts
0A168                           
0A168                           check_release:
0A168                           
0A168                               lda famistudio_chn_vrc7_trigger,y
0A168                               bpl check_attack
0A168                           
0A168                               release:
0A168                                  
0A168                                   lda famistudio_chn_vrc7_prev_hi, y
0A168                                   and #$ef ; remove trigger
0A168                                   sta famistudio_chn_vrc7_prev_hi, y
0A168                                   jmp musical_note
0A168                           
0A168                           check_attack:
0A168                           
0A168                               lda famistudio_chn_vrc7_trigger,y
0A168                               and #1
0A168                               beq musical_note
0A168                           
0A168                               attack:
0A168                           
0A168                                   lda famistudio_chn_vrc7_prev_hi, y
0A168                                   and #$10
0A168                                   beq prev_note_had_release
0A168                           
0A168                                   ; Two attacks in a row, need to insert a dummy release.
0A168                                   prev_note_had_attack:
0A168                           
0A168                                       lda famistudio_vrc7_reg_table_hi,y
0A168                                       sta FAMISTUDIO_VRC7_REG_SEL
0A168                                       jsr famistudio_vrc7_wait_reg_select
0A168                                       lda #0
0A168                                       sta FAMISTUDIO_VRC7_REG_WRITE
0A168                                       jsr famistudio_vrc7_wait_reg_write
0A168                                       jmp musical_note
0A168                           
0A168                                   prev_note_had_release:
0A168                                       lda famistudio_chn_vrc7_prev_hi, y
0A168                                       ora #$10
0A168                                       sta famistudio_chn_vrc7_prev_hi, y
0A168                           
0A168                           musical_note:
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_vrc7_env_table,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_VRC7_CH0_IDX, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif
0A168                                   ora famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .endif
0A168                               tax
0A168                           
0A168                               ; Write volume
0A168                               lda famistudio_vrc7_vol_table,y
0A168                               sta FAMISTUDIO_VRC7_REG_SEL
0A168                               jsr famistudio_vrc7_wait_reg_select
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_volume_table,x
0A168                                   tax
0A168                               .endif
0A168                               lda famistudio_vrc7_invert_vol_table,x
0A168                               ora famistudio_chn_vrc7_patch,y
0A168                               sta FAMISTUDIO_VRC7_REG_WRITE
0A168                               jsr famistudio_vrc7_wait_reg_write
0A168                           
0A168                               ; Read note, apply arpeggio 
0A168                               ldx famistudio_vrc7_env_table,y    
0A168                               lda famistudio_chn_note+FAMISTUDIO_VRC7_CH0_IDX,y
0A168                               clc
0A168                               adc famistudio_env_value+FAMISTUDIO_ENV_NOTE_OFF,x
0A168                               tax
0A168                           
0A168                               ; Apply pitch envelope, fine pitch & slides
0A168                               famistudio_get_note_pitch_macro FAMISTUDIO_VRC7_CH0_PITCH_ENV_IDX, FAMISTUDIO_VRC7_PITCH_SHIFT, famistudio_vrc7_note_table_lsb, famistudio_vrc7_note_table_msb
0A168                           
0A168                               ; Compute octave by dividing by 2 until we are <= 512 (0x100).
0A168                               ldx #0
0A168                               compute_octave_loop:
0A168                                   lda pitch+1
0A168                                   cmp #2
0A168                                   bcc octave_done
0A168                                   lsr
0A168                                   sta pitch+1
0A168                                   ror pitch+0
0A168                                   inx
0A168                                   jmp compute_octave_loop
0A168                           
0A168                               octave_done:
0A168                           
0A168                               ; Write pitch (lo)
0A168                               lda famistudio_vrc7_reg_table_lo,y
0A168                               sta FAMISTUDIO_VRC7_REG_SEL
0A168                               jsr famistudio_vrc7_wait_reg_select
0A168                           
0A168                               lda pitch+0
0A168                               sta FAMISTUDIO_VRC7_REG_WRITE
0A168                               jsr famistudio_vrc7_wait_reg_write
0A168                           
0A168                               ; Write pitch (hi)
0A168                               lda famistudio_chn_vrc7_prev_hi, y
0A168                               and #$10
0A168                               sta tmp
0A168                           
0A168                               lda famistudio_vrc7_reg_table_hi,y
0A168                               sta FAMISTUDIO_VRC7_REG_SEL
0A168                               jsr famistudio_vrc7_wait_reg_select
0A168                           
0A168                               txa
0A168                               asl
0A168                               ora famistudio_chn_vrc7_sustain
0A168                               ora pitch+1
0A168                               ora tmp
0A168                               sta famistudio_chn_vrc7_prev_hi, y
0A168                               sta FAMISTUDIO_VRC7_REG_WRITE
0A168                               jsr famistudio_vrc7_wait_reg_write
0A168                           
0A168                               lda #0
0A168                               sta famistudio_chn_vrc7_trigger,y
0A168                           
0A168                               rts
0A168                           
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_EXP_EPSM
0A168                           FM_ENV_OFFSET = FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT*4
0A168                           RHY_ENV_OFFSET = FM_ENV_OFFSET + FAMISTUDIO_EXP_EPSM_FM_CHN_CNT*2
0A168                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT > 0
0A168                           famistudio_epsm_vol_table_op1:
0A168                               .byte FAMISTUDIO_EPSM_REG_TL, FAMISTUDIO_EPSM_REG_TL+1, FAMISTUDIO_EPSM_REG_TL+2,FAMISTUDIO_EPSM_REG_TL, FAMISTUDIO_EPSM_REG_TL+1, FAMISTUDIO_EPSM_REG_TL+2
0A168                           famistudio_epsm_vol_table_op2:
0A168                               .byte FAMISTUDIO_EPSM_REG_TL+8, FAMISTUDIO_EPSM_REG_TL+1+8, FAMISTUDIO_EPSM_REG_TL+2+8,FAMISTUDIO_EPSM_REG_TL+8, FAMISTUDIO_EPSM_REG_TL+1+8, FAMISTUDIO_EPSM_REG_TL+2+8
0A168                           famistudio_epsm_vol_table_op3:
0A168                               .byte FAMISTUDIO_EPSM_REG_TL+4, FAMISTUDIO_EPSM_REG_TL+1+4, FAMISTUDIO_EPSM_REG_TL+2+4,FAMISTUDIO_EPSM_REG_TL+4, FAMISTUDIO_EPSM_REG_TL+1+4, FAMISTUDIO_EPSM_REG_TL+2+4
0A168                           famistudio_epsm_vol_table_op4:
0A168                               .byte FAMISTUDIO_EPSM_REG_TL+12, FAMISTUDIO_EPSM_REG_TL+1+12, FAMISTUDIO_EPSM_REG_TL+2+12,FAMISTUDIO_EPSM_REG_TL+12, FAMISTUDIO_EPSM_REG_TL+1+12, FAMISTUDIO_EPSM_REG_TL+2+12
0A168                           famistudio_epsm_fm_vol_table:
0A168                               .byte $7e, $65, $50, $3f, $32, $27, $1e, $17, $12, $0d, $09, $06, $04, $02, $01, $00
0A168                           famistudio_epsm_fm_stereo_reg_table:
0A168                               .byte $b4,$b5,$b6
0A168                               .byte $b4,$b5,$b6
0A168                           famistudio_channel_epsm_chan_table:
0A168                               .byte $00, $01, $02
0A168                               .byte $00, $01, $02
0A168                           .endif
0A168                           .if FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A168                           famistudio_epsm_rhythm_key_table:
0A168                               .byte $01,$02,$04,$08,$10,$20
0A168                           famistudio_epsm_rhythm_reg_table:
0A168                               .byte FAMISTUDIO_EPSM_REG_RHY_BD, FAMISTUDIO_EPSM_REG_RHY_SD, FAMISTUDIO_EPSM_REG_RHY_TC, FAMISTUDIO_EPSM_REG_RHY_HH, FAMISTUDIO_EPSM_REG_RHY_TOM, FAMISTUDIO_EPSM_REG_RHY_RIM
0A168                           .endif
0A168                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT > 0
0A168                           famistudio_epsm_reg_table_lo:
0A168                               .byte FAMISTUDIO_EPSM_REG_FN_LO, FAMISTUDIO_EPSM_REG_FN_LO2, FAMISTUDIO_EPSM_REG_FN_LO3, FAMISTUDIO_EPSM_REG_FN_LO, FAMISTUDIO_EPSM_REG_FN_LO2, FAMISTUDIO_EPSM_REG_FN_LO3
0A168                           famistudio_epsm_reg_table_hi:
0A168                               .byte FAMISTUDIO_EPSM_REG_FN_HI, FAMISTUDIO_EPSM_REG_FN_HI2, FAMISTUDIO_EPSM_REG_FN_HI3, FAMISTUDIO_EPSM_REG_FN_HI, FAMISTUDIO_EPSM_REG_FN_HI2, FAMISTUDIO_EPSM_REG_FN_HI3
0A168                           famistudio_epsm_vol_table:
0A168                               .byte FAMISTUDIO_EPSM_REG_VOL_1, FAMISTUDIO_EPSM_REG_VOL_2, FAMISTUDIO_EPSM_REG_VOL_3, FAMISTUDIO_EPSM_REG_VOL_4, FAMISTUDIO_EPSM_REG_VOL_5, FAMISTUDIO_EPSM_REG_VOL_6
0A168                           famistudio_epsm_fm_env_table:
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET + 2
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET + 4
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET + 6
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET + 8
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS + FM_ENV_OFFSET + 10
0A168                           famistudio_epsm_register_order:
0A168                               .byte $B0, $B4, $30, $50, $60, $70, $80, $90, $38, $58, $68, $78, $88, $98, $34, $54, $64, $74, $84, $94, $3c, $5c, $6c, $7c, $8c, $9c, $40, $48, $44, $4c, $22 ;40,48,44,4c replaced for not sending data there during instrument updates,
0A168                           famistudio_epsm_channel_key_table:
0A168                               .byte $f0, $f1, $f2, $f4, $f5, $f6
0A168                           .endif
0A168                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT > 0
0A168                           famistudio_epsm_sqr_reg_table_lo:
0A168                               .byte FAMISTUDIO_EPSM_REG_LO_A, FAMISTUDIO_EPSM_REG_LO_B, FAMISTUDIO_EPSM_REG_LO_C
0A168                           famistudio_epsm_sqr_reg_table_hi:
0A168                               .byte FAMISTUDIO_EPSM_REG_HI_A, FAMISTUDIO_EPSM_REG_HI_B, FAMISTUDIO_EPSM_REG_HI_C
0A168                           famistudio_epsm_square_vol_table:
0A168                               .byte FAMISTUDIO_EPSM_REG_VOL_A, FAMISTUDIO_EPSM_REG_VOL_B, FAMISTUDIO_EPSM_REG_VOL_C
0A168                           famistudio_epsm_square_env_table:
0A168                               .byte FAMISTUDIO_EPSM_CH0_ENVS, FAMISTUDIO_EPSM_CH1_ENVS, FAMISTUDIO_EPSM_CH2_ENVS
0A168                           famistudio_epsm_square_noise_mask:
0A168                               .byte $08, $10, $20
0A168                           .endif
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_EPSM_SQUARE_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the EPSM audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: EPSM channel idx (0,1,2)
0A168                           ;======================================================================================================================
0A168                           
0A168                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT > 0
0A168                           famistudio_update_epsm_square_channel_sound:
0A168                               
0A168                               pitch   = famistudio_ptr1
0A168                               env_bit = famistudio_ptr1_lo
0A168                           
0A168                               ; These are shared by all 3 channels.
0A168                               env_period = famistudio_ptr0
0A168                               attack     = famistudio_ptr2
0A168                               env_shape  = famistudio_r1
0A168                               env_octave = famistudio_r2
0A168                               noise_freq = famistudio_r3
0A168                           
0A168                               ; First channel will clear these, last channel will write the registers.
0A168                               cpy #0
0A168                               bne @not_first_channel
0A168                               sty env_shape
0A168                               sty noise_freq
0A168                               sty attack
0A168                               lda #$80 ; This mean 'manual pitch'
0A168                               sty env_octave
0A168                           
0A168                           @not_first_channel:
0A168                               ldx #0 ; This will fetch volume 0.
0A168                               stx env_bit
0A168                               lda famistudio_chn_note+FAMISTUDIO_EPSM_CH0_IDX,y
0A168                               bne @nocut
0A168                               jmp @update_volume
0A168                           
0A168                           @nocut:
0A168                               ; Store noise if mixer has it enabled
0A168                               ldx famistudio_epsm_square_env_table,y
0A168                               lda famistudio_env_value+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A168                               and famistudio_epsm_square_noise_mask,y
0A168                               bne @nonoise
0A168                               lda famistudio_env_value+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A168                               sta noise_freq
0A168                           
0A168                           @nonoise:
0A168                               lda famistudio_chn_note+FAMISTUDIO_EPSM_CH0_IDX,y
0A168                               ; Read note, apply arpeggio 
0A168                               clc
0A168                               ldx famistudio_epsm_square_env_table,y
0A168                               adc famistudio_env_value+FAMISTUDIO_ENV_NOTE_OFF,x
0A168                               tax
0A168                           
0A168                               ; Apply pitch envelope, fine pitch & slides
0A168                               famistudio_get_note_pitch_macro FAMISTUDIO_EPSM_CH0_PITCH_ENV_IDX, 0, famistudio_epsm_s_note_table_lsb, famistudio_epsm_s_note_table_msb
0A168                           
0A168                               ; Write pitch
0A168                               lda famistudio_epsm_sqr_reg_table_lo,y
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               lda pitch+0
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                               lda famistudio_epsm_sqr_reg_table_hi,y
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               lda pitch+1
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                               ; Store env shape + period if active.
0A168                               lda famistudio_epsm_chn_env_shape,y
0A168                               and #$0f
0A168                               beq @noenv
0A168                               sta env_shape
0A168                           
0A168                               ; If bit 7 of any channel is on, well reset the envelope.
0A168                               lda famistudio_epsm_chn_env_shape,y
0A168                               ora attack 
0A168                               sta attack
0A168                               lda famistudio_epsm_chn_env_shape,y
0A168                               and #$0f
0A168                               sta famistudio_epsm_chn_env_shape,y
0A168                           
0A168                               ; Store auto-period settings
0A168                               lda famistudio_epsm_chn_env_octave,y
0A168                               sta env_octave
0A168                               cmp #$80 ; This mean 'manual pitch'
0A168                               beq @manual_period
0A168                           
0A168                               @auto_period:
0A168                                   lda pitch+0
0A168                                   sta env_period+0
0A168                                   lda pitch+1
0A168                                   sta env_period+1
0A168                                   jmp @set_envelope_volume_flag
0A168                           
0A168                               @manual_period:
0A168                                   lda famistudio_epsm_env_period_lo
0A168                                   sta env_period+0
0A168                                   lda famistudio_epsm_env_period_hi
0A168                                   sta env_period+1
0A168                           
0A168                           @set_envelope_volume_flag:
0A168                               lda #$10
0A168                           
0A168                           @noenv:
0A168                               sta env_bit
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_epsm_square_env_table,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_EPSM_CH0_IDX, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif        
0A168                                   ora famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .endif
0A168                               tax
0A168                           
0A168                           @update_volume:
0A168                               ; Write volume
0A168                               lda famistudio_epsm_square_vol_table,y
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK    
0A168                                   lda famistudio_volume_table,x 
0A168                                   ora env_bit
0A168                               .else
0A168                                   txa
0A168                                   ora env_bit
0A168                               .endif
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                           @write_shared_registers:
0A168                               ; Channel 2 writes all 5 shared registers.
0A168                               cpy #(FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT - 1)
0A168                               bne @done
0A168                               lda env_shape
0A168                               beq @write_shared_noise
0A168                               ldx env_octave
0A168                               cpx #$80
0A168                               beq @write_shared_env_register
0A168                           
0A168                           @compute_auto_period:
0A168                               cpx #0
0A168                               beq @write_shared_env_register
0A168                               bpl @positive_octave_loop
0A168                               
0A168                               @negative_octave_loop:
0A168                                       asl env_period+0
0A168                                       rol env_period+1
0A168                                       inx
0A168                                       bne @negative_octave_loop
0A168                                   beq @write_shared_env_register
0A168                                   
0A168                               @positive_octave_loop:
0A168                                   cpx #1
0A168                                   bne @do_shift
0A168                                   @rounding:
0A168                                       lda env_period+0
0A168                                       and #1
0A168                                       beq @do_shift
0A168                                       lda env_period+0
0A168                                       clc
0A168                                       adc #1
0A168                                       sta env_period+0
0A168                                       bcc @do_shift
0A168                                       inc env_period+1
0A168                                   @do_shift:
0A168                                       lsr env_period+1
0A168                                       ror env_period+0
0A168                                       dex
0A168                                       bne @positive_octave_loop
0A168                           
0A168                           @write_shared_env_register:    
0A168                           
0A168                               ; Envelope period.
0A168                               lda #FAMISTUDIO_EPSM_REG_ENV_LO
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               lda env_period+0
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                               lda #FAMISTUDIO_EPSM_REG_ENV_HI
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               lda env_period+1
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                               ; Reset envelope if there was an attack.
0A168                               lda attack
0A168                               bpl @write_shared_noise
0A168                                   lda #FAMISTUDIO_EPSM_REG_SHAPE
0A168                                   sta FAMISTUDIO_EPSM_ADDR
0A168                                   lda env_shape
0A168                                   sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                           @write_shared_noise:
0A168                           
0A168                               ; Tone/noise enabled.
0A168                               lda #FAMISTUDIO_EPSM_REG_TONE
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT = 3
0A168                               lda famistudio_env_value+FAMISTUDIO_EPSM_CH2_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               asl
0A168                               ora famistudio_env_value+FAMISTUDIO_EPSM_CH1_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               asl
0A168                               ora famistudio_env_value+FAMISTUDIO_EPSM_CH0_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                           .elseif FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT = 2
0A168                               lda famistudio_env_value+FAMISTUDIO_EPSM_CH1_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               asl
0A168                               ora famistudio_env_value+FAMISTUDIO_EPSM_CH0_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                           .else
0A168                               lda famistudio_env_value+FAMISTUDIO_EPSM_CH0_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                           .endif
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                               
0A168                               ; Noise freq
0A168                               lda #FAMISTUDIO_EPSM_REG_NOISE
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               lda noise_freq
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                               lda #0
0A168                               sta famistudio_epsm_env_override
0A168                           
0A168                           @done:
0A168                               rts
0A168                           
0A168                           .endif
0A168                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT > 0
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_EPSM_FM_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the EPSM audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: EPSM channel idx (0,1,2,3,4,5)
0A168                           ;======================================================================================================================
0A168                           famistudio_update_epsm_fm_channel_sound:
0A168                           
0A168                               pitch      = famistudio_ptr1
0A168                               reg_offset = famistudio_r1
0A168                               vol_offset = famistudio_r0
0A168                               chan_idx   = famistudio_r2
0A168                           
0A168                               sty chan_idx
0A168                               ; If the writes are done to channels 0-2, use FAMISTUDIO_EPSM_REG_SEL0 if 3-5 use FAMISTUDIO_EPSM_REG_SEL1
0A168                               ; This reg_offset stores the difference so we can later load it into x and do sta FAMISTUDIO_EPSM_REG_SEL0, x
0A168                               ; to account for the difference
0A168                               lda #0
0A168                               cpy #3
0A168                               bcc @fm_0_2
0A168                                   lda #2
0A168                               @fm_0_2:
0A168                               sta reg_offset
0A168                           
0A168                           @check_cut:
0A168                           
0A168                               lda famistudio_chn_note+FAMISTUDIO_EPSM_CHAN_FM_START,y
0A168                               bne @nocut
0A168                           
0A168                           @cut:  
0A168                               ; Untrigger note.  
0A168                               lda #FAMISTUDIO_EPSM_REG_KEY
0A168                               sta FAMISTUDIO_EPSM_REG_SEL0
0A168                               
0A168                               lda famistudio_epsm_channel_key_table, y
0A168                               and #$0f ; remove trigger
0A168                               sta FAMISTUDIO_EPSM_REG_WRITE0
0A168                               
0A168                               ;Mute channel
0A168                               ldx reg_offset
0A168                               lda famistudio_epsm_fm_stereo_reg_table,y
0A168                               sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                               lda #$00
0A168                               sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                               rts
0A168                           
0A168                           @nocut:
0A168                           
0A168                               ; Check if the channel needs to stop the note
0A168                           
0A168                               ; Un-trigger previous note if needed.
0A168                               lda famistudio_chn_epsm_trigger,y
0A168                               beq @update_instrument_check
0A168                               @untrigger_prev_note:
0A168                                   ; Untrigger note.  
0A168                                   lda #FAMISTUDIO_EPSM_REG_KEY
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0
0A168                           
0A168                                   lda famistudio_epsm_channel_key_table, y
0A168                                   and #$0f ; remove trigger
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0
0A168                           ;        nop
0A168                           ;        nop
0A168                           ;        nop
0A168                                   nop
0A168                                   nop
0A168                                   nop
0A168                           ;        rts
0A168                               @update_instrument_check:
0A168                               lda famistudio_chn_epsm_fm_instrument,y
0A168                               cmp #$ff
0A168                               beq @no_instrument_update
0A168                               jsr update_fm_instrument
0A168                               ldy chan_idx
0A168                               lda #$ff
0A168                               sta famistudio_chn_epsm_fm_instrument,y
0A168                               @no_instrument_update:
0A168                           
0A168                               ldx reg_offset
0A168                               lda famistudio_epsm_fm_stereo_reg_table,y
0A168                               sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                               lda famistudio_chn_epsm_fm_stereo,y
0A168                               sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                               lda famistudio_chn_note+FAMISTUDIO_EPSM_CHAN_FM_START,y
0A168                               ; Read note, apply arpeggio
0A168                               clc
0A168                               ldx famistudio_epsm_fm_env_table,y    
0A168                               adc famistudio_env_value+FAMISTUDIO_ENV_NOTE_OFF,x
0A168                               tax
0A168                           
0A168                               ; Apply pitch envelope, fine pitch & slides
0A168                               famistudio_get_note_pitch_macro (FAMISTUDIO_EPSM_CH0_PITCH_ENV_IDX + FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT), FAMISTUDIO_EPSM_PITCH_SHIFT, famistudio_epsm_note_table_lsb, famistudio_epsm_note_table_msb
0A168                           
0A168                               ; Compute octave by dividing by 2 until we are <= 512 (0x100).
0A168                               ldx #0
0A168                           
0A168                               lda pitch+1
0A168                               cmp #$02 ; check if shifted the pitch to a 9 bit number yet.
0A168                               bcc @octave_done
0A168                               @compute_octave_loop:
0A168                                   inx
0A168                                   lsr
0A168                                   ror pitch+0
0A168                                   cmp #$02
0A168                                   bcc @octave_done
0A168                                   bcs @compute_octave_loop ;unconditional
0A168                               @octave_done:
0A168                               sta pitch+1
0A168                           
0A168                               ; 9 bit pitch * 4 to get the pitch back to an 11 bit number
0A168                               ; the final 16 bit pitch will look like 00ooohhh llllllll where o = octave, h = pitch bits 8-11, l = pitch bits 0-8
0A168                               asl pitch+0
0A168                               rol pitch+1
0A168                               asl pitch+0
0A168                               rol pitch+1
0A168                           
0A168                               txa ; x holds the 3 bit octave information. octave = log2(pitch_hi)
0A168                               asl
0A168                               asl
0A168                               asl
0A168                               ora pitch+1
0A168                               sta pitch+1
0A168                           
0A168                               @write_hi_period:
0A168                           
0A168                               ; Write pitch (hi)
0A168                               ldx reg_offset
0A168                               lda famistudio_epsm_reg_table_hi,y
0A168                               sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                               lda pitch+1
0A168                               sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                           
0A168                               ; Write pitch (lo)
0A168                               lda famistudio_epsm_reg_table_lo,y
0A168                               sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                               lda pitch+0
0A168                               sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_epsm_fm_env_table,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_EPSM_CHAN_FM_START, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif
0A168                                   ora famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .endif
0A168                               
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   tax
0A168                                   lda famistudio_volume_table,x
0A168                               .endif    
0A168                                   sta vol_offset
0A168                           
0A168                               @update_volume:
0A168                               ldx vol_offset
0A168                               lda famistudio_epsm_fm_vol_table,x
0A168                               sta vol_offset ; store volume level here
0A168                               
0A168                               ldx reg_offset    
0A168                               lda famistudio_chn_epsm_alg,y
0A168                               cmp #4
0A168                               bcc @op_4 ; 0-1-2-3
0A168                               beq @op_2_4 ; 4
0A168                               cmp #7 ; 5
0A168                               bcc @op_2_3_4 ; 6
0A168                                          ; 7
0A168                               @op_1_2_3_4:
0A168                                   lda famistudio_epsm_vol_table_op1,y
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                                   lda famistudio_chn_epsm_vol_op1,y
0A168                                   clc
0A168                               adc vol_offset
0A168                                   bpl @save_op1
0A168                                   lda #127
0A168                               @save_op1:
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                               @op_2_3_4:
0A168                                   lda famistudio_epsm_vol_table_op3,y
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                                   lda famistudio_chn_epsm_vol_op3,y
0A168                                   clc
0A168                                   adc vol_offset
0A168                                   bpl @save_op3
0A168                                   lda #127
0A168                               @save_op3:
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                               @op_2_4:
0A168                                   lda famistudio_epsm_vol_table_op2,y
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0,x
0A168                                   lda famistudio_chn_epsm_vol_op2,y
0A168                                   clc
0A168                                   adc vol_offset
0A168                                   bpl @save_op2
0A168                                   lda #127
0A168                               @save_op2:
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0,x
0A168                               @op_4:
0A168                                   ; Write volume
0A168                                   lda famistudio_epsm_vol_table_op4,y ; 4
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0,x ; 5
0A168                                   lda famistudio_chn_epsm_vol_op4,y ; 4
0A168                               clc ; 2
0A168                                   adc vol_offset ; 3
0A168                                   bpl @save_op4 ; 2/3
0A168                                   lda #127 ; 2
0A168                               @save_op4:
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0,x ; 5  = 26/27
0A168                           
0A168                                   nop
0A168                                   clc
0A168                                   lda famistudio_chn_epsm_trigger,y
0A168                                   bpl @no_release
0A168                           
0A168                           @release:
0A168                                   ; Untrigger note.  
0A168                                   lda #FAMISTUDIO_EPSM_REG_KEY
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0
0A168                           
0A168                                   lda famistudio_epsm_channel_key_table, y
0A168                                   and #$0f ; remove trigger
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0
0A168                           
0A168                                   rts
0A168                           @no_release:
0A168                                   lda #0
0A168                                   sta famistudio_chn_epsm_trigger,y
0A168                                   lda #FAMISTUDIO_EPSM_REG_KEY
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0
0A168                                   lda famistudio_epsm_channel_key_table, y
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0
0A168                           
0A168                               rts
0A168                           
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_EPSM_WRITE_PATCH_REGISTER (internal)
0A168                           ;
0A168                           ; Internal function to set a EPSM instrument for a given channel
0A168                           ;
0A168                           ; [in] y/r0: channel index
0A168                           ; [in] x:    index of first envelope of instrument
0A168                           ; [in] a:    instrument index.
0A168                           ;======================================================================================================================
0A168                           .macro famistudio_epsm_write_patch_registers select, write
0A168                               ldy #30-5 ; we skip updating the 4 operators
0A168                               ldx reg_offset
0A168                           @loop_extra_patch:
0A168                                   txa    ; 2
0A168                                   ora famistudio_epsm_register_order,y ; 4
0A168                                   sta select ; 4
0A168                                   lda (ex_patch),y ; 5
0A168                                   sta write ; 4
0A168                                   dey    ; 2
0A168                                   nop    ; 2 DELAY FOR MESEN-X
0A168                                   bpl @loop_extra_patch ; 3  ; =26
0A168                           
0A168                               ldx chan_idx2
0A168                               lda famistudio_chn_epsm_alg,x
0A168                               cmp #4
0A168                               bcc @alg_0_1_2_3 ; 0-1-2-3
0A168                               beq @alg_4 ; 4
0A168                               jmp @alg_5_6 ; 5
0A168                           @alg_0_1_2_3:
0A168                               ;3+2+1
0A168                               ldy #27
0A168                               ldx reg_offset
0A168                               txa    ; 2
0A168                               ora famistudio_epsm_register_order,y ; 4
0A168                               sta select ; 4
0A168                               lda (ex_patch),y ; 5
0A168                               sta write ; 4
0A168                               nop    ; 2 DELAY FOR MESEN-X
0A168                           @alg_4:
0A168                               ;3+1
0A168                               ldy #28
0A168                               ldx reg_offset
0A168                               txa    ; 2
0A168                               ora famistudio_epsm_register_order,y ; 4
0A168                               sta select ; 4
0A168                               lda (ex_patch),y ; 5
0A168                               sta write ; 4
0A168                               nop    ; 2 DELAY FOR MESEN-X
0A168                           @alg_5_6:
0A168                               ;1
0A168                               ldy #26
0A168                               ldx reg_offset
0A168                               txa    ; 2
0A168                               ora famistudio_epsm_register_order,y ; 4
0A168                               sta select ; 4
0A168                               lda (ex_patch),y ; 5
0A168                               sta write ; 4
0A168                               nop    ; 2 DELAY FOR MESEN-X
0A168                           .endm
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_EPSM_FM_INSTRUMENT (internal)
0A168                           ;
0A168                           ; Updates the EPSM audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: EPSM channel idx (0,1,2,3,4,5)
0A168                           ;======================================================================================================================
0A168                               ; Now we are dealing with either a FM or Rhythm instrument. a = channel index
0A168                               ; if we are an FM instrument then there is a offset we need to apply to the register select
0A168                           
0A168                               ; Skip over the two SSG specific envelopes by jumping up 4 bytes
0A168                           update_fm_instrument:
0A168                               ptr          = famistudio_ptr1
0A168                               env_ptr      = famistudio_ptr2
0A168                               ex_patch     = famistudio_ptr2
0A168                               chan_idx     = famistudio_r0
0A168                               chan_idx2    = famistudio_r2
0A168                               update_flags = famistudio_r1 ; bit 7 = no attack, bit 6 = has set delayed cut
0A168                               reg_offset   = famistudio_r3
0A168                               jsr famistudio_get_exp_inst_ptr
0A168                               clc 
0A168                               tya
0A168                               adc #14 ; skip over envelopes + square stuff.
0A168                               tay
0A168                               ; And then read the pointer to the extended instrument patch data
0A168                               lda (ptr),y
0A168                               sta ex_patch
0A168                               iny
0A168                               lda (ptr),y
0A168                               sta ex_patch+1
0A168                           
0A168                           @fm_channel:
0A168                               ldx chan_idx2
0A168                               ; FM channel 1-6, we need to look up the register select offset from the table
0A168                               lda famistudio_channel_epsm_chan_table,x
0A168                               sta reg_offset
0A168                               ldy #0
0A168                               ; Now we need to store the algorithm and stereo for later use
0A168                               lda (ex_patch),y
0A168                               and #$07
0A168                               sta famistudio_chn_epsm_alg,x ;store algorithm
0A168                               iny
0A168                               lda (ex_patch),y
0A168                               sta famistudio_chn_epsm_fm_stereo ,x
0A168                               dey
0A168                           
0A168                               ; Now if we are channels 1-3 then we use @reg_set_0, otherwise for 4-6 its reg set 1
0A168                               lda chan_idx2
0A168                               cmp #3
0A168                               bpl @reg_set_1
0A168                           
0A168                               @reg_set_0:
0A168                                   famistudio_epsm_write_patch_registers FAMISTUDIO_EPSM_REG_SEL0, FAMISTUDIO_EPSM_REG_WRITE0
0A168                                   jmp @last_reg
0A168                           
0A168                               @reg_set_1:
0A168                                   famistudio_epsm_write_patch_registers FAMISTUDIO_EPSM_REG_SEL1, FAMISTUDIO_EPSM_REG_WRITE1
0A168                                   nop
0A168                               
0A168                               @last_reg:
0A168                                   ldy #30 ; last reg patch ptr
0A168                                   lda #$22 ; famistudio_epsm_register_order,x
0A168                                   clc
0A168                                   adc reg_offset
0A168                                   sta FAMISTUDIO_EPSM_REG_SEL0
0A168                                   lda (ex_patch),y
0A168                                   sta FAMISTUDIO_EPSM_REG_WRITE0    
0A168                                   lda chan_idx2
0A168                                   tax
0A168                                   ldy #26
0A168                                   lda (ex_patch),y
0A168                                   sta famistudio_chn_epsm_vol_op1,x
0A168                                   iny
0A168                                   lda (ex_patch),y
0A168                                   sta famistudio_chn_epsm_vol_op2,x
0A168                                   iny
0A168                                   lda (ex_patch),y
0A168                                   sta famistudio_chn_epsm_vol_op3,x
0A168                                   iny
0A168                                   lda (ex_patch),y
0A168                                   sta famistudio_chn_epsm_vol_op4,x
0A168                               @done:
0A168                               rts
0A168                           .endif
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_EPSM_RHYTHM_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the EPSM audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: EPSM channel idx (0,1,2,3,4,5)
0A168                           ;======================================================================================================================
0A168                           
0A168                           .if FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A168                           famistudio_update_epsm_rhythm_channel_sound:
0A168                               
0A168                               pitch = famistudio_ptr1
0A168                           
0A168                               lda famistudio_chn_note+FAMISTUDIO_EPSM_CHAN_RHYTHM_START,y
0A168                               bne @nocut
0A168                               sta famistudio_chn_epsm_trigger+FAMISTUDIO_EXP_EPSM_FM_CHN_CNT,y
0A168                               ldx #0 ; This will fetch volume 0.
0A168                               beq @noupdate
0A168                           
0A168                           @nocut:
0A168                           
0A168                               lda famistudio_chn_epsm_trigger+FAMISTUDIO_EXP_EPSM_FM_CHN_CNT,y
0A168                               cmp #$10
0A168                               beq @noupdate
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_chn_epsm_rhythm_volume,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_EPSM_CHAN_RHYTHM_START, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif        
0A168                                   ora famistudio_chn_epsm_rhythm_volume,y
0A168                               .else
0A168                                   lda famistudio_chn_epsm_rhythm_volume,y
0A168                               .endif
0A168                               tax
0A168                           
0A168                           @update_volume:
0A168                               ; Write volume
0A168                               lda famistudio_epsm_rhythm_reg_table,y
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK    
0A168                                   lda famistudio_volume_table,x 
0A168                               .else
0A168                                   txa
0A168                               .endif
0A168                                   rol
0A168                                   adc famistudio_chn_epsm_rhythm_stereo,y
0A168                                   sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                               lda #$10 ;FAMISTUDIO_EPSM_REG_RHY_KY
0A168                               sta famistudio_chn_epsm_trigger+FAMISTUDIO_EXP_EPSM_FM_CHN_CNT,y
0A168                               sta FAMISTUDIO_EPSM_ADDR
0A168                               nop ;Some delay needed before writing the rhythm key
0A168                               nop
0A168                               lda famistudio_epsm_rhythm_key_table,y
0A168                               sta FAMISTUDIO_EPSM_DATA
0A168                           
0A168                           @noupdate:
0A168                               rts
0A168                           
0A168                           .endif
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_EXP_N163
0A168                           
0A168                           ; This is getting out of hand. Maybe we should compute those on the fly.
0A168                           famistudio_n163_freq_table_lo:
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $00
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $08
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $10
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $18
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $20
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $28
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $30
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_LO - $38
0A168                           famistudio_n163_freq_table_mid:
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $00
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $08
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $10
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $18
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $20
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $28
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $30
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_MID - $38
0A168                           famistudio_n163_freq_table_hi:
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $00
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $08
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $10
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $18
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $20
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $28
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $30
0A168                               .byte FAMISTUDIO_N163_REG_FREQ_HI - $38
0A168                           famistudio_n163_vol_table:
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $00
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $08
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $10
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $18
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $20
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $28
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $30
0A168                               .byte FAMISTUDIO_N163_REG_VOLUME - $38    
0A168                           famistudio_n163_env_table:
0A168                               .byte FAMISTUDIO_N163_CH0_ENVS
0A168                               .byte FAMISTUDIO_N163_CH1_ENVS
0A168                               .byte FAMISTUDIO_N163_CH2_ENVS
0A168                               .byte FAMISTUDIO_N163_CH3_ENVS
0A168                               .byte FAMISTUDIO_N163_CH4_ENVS
0A168                               .byte FAMISTUDIO_N163_CH5_ENVS
0A168                               .byte FAMISTUDIO_N163_CH6_ENVS
0A168                               .byte FAMISTUDIO_N163_CH7_ENVS
0A168                           .if FAMISTUDIO_USE_PHASE_RESET
0A168                           famistudio_n163_phase_table_lo:
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $00
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $08
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $10
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $18
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $20
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $28
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $30
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_LO - $38
0A168                           famistudio_n163_phase_table_mid:
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $00
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $08
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $10
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $18
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $20
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $28
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $30
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_MID - $38
0A168                           famistudio_n163_phase_table_hi:
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $00
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $08
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $10
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $18
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $20
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $28
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $30
0A168                               .byte FAMISTUDIO_N163_REG_PHASE_HI - $38
0A168                           .endif
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_N163_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the N163 audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: N163 channel idx (0,1,2,3,4,5,6,7)
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_update_n163_channel_sound:
0A168                               
0A168                               pitch    = famistudio_ptr1
0A168                               pitch_hi = famistudio_r2
0A168                           
0A168                               lda famistudio_chn_note+FAMISTUDIO_N163_CH0_IDX,y
0A168                               bne @nocut
0A168                               ldx #0 ; This will fetch volume 0.
0A168                               jmp @update_volume
0A168                           
0A168                           @nocut:
0A168                           
0A168                               jsr famistudio_update_n163_wave
0A168                           
0A168                               ; Read note, apply arpeggio 
0A168                               lda famistudio_chn_note+FAMISTUDIO_N163_CH0_IDX,y 
0A168                               clc
0A168                               ldx famistudio_n163_env_table,y
0A168                               adc famistudio_env_value+FAMISTUDIO_ENV_NOTE_OFF,x
0A168                               .if FAMISTUDIO_DUAL_SUPPORT
0A168                                   clc
0A168                                   adc famistudio_pal_adjust
0A168                               .endif
0A168                               tax
0A168                           
0A168                               ; Apply pitch envelope, fine pitch & slides
0A168                               famistudio_get_note_pitch_macro FAMISTUDIO_N163_CH0_PITCH_ENV_IDX, FAMISTUDIO_N163_PITCH_SHIFT, famistudio_n163_note_table_lsb, famistudio_n163_note_table_msb
0A168                           
0A168                               ; Convert 16-bit -> 18-bit.
0A168                               asl pitch+0
0A168                               rol pitch+1
0A168                               lda #0
0A168                               adc #0
0A168                               sta pitch_hi
0A168                               asl pitch+0
0A168                               rol pitch+1
0A168                               rol pitch_hi 
0A168                           
0A168                               ; Write pitch
0A168                               lda famistudio_n163_freq_table_lo,y
0A168                               sta FAMISTUDIO_N163_ADDR
0A168                               lda pitch+0
0A168                               sta FAMISTUDIO_N163_DATA
0A168                               lda famistudio_n163_freq_table_mid,y
0A168                               sta FAMISTUDIO_N163_ADDR
0A168                               lda pitch+1
0A168                               sta FAMISTUDIO_N163_DATA
0A168                               lda famistudio_n163_freq_table_hi,y
0A168                               sta FAMISTUDIO_N163_ADDR
0A168                               lda famistudio_chn_n163_wave_len,y
0A168                               ora pitch_hi
0A168                               sta FAMISTUDIO_N163_DATA
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_n163_env_table,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_N163_CH0_IDX, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif        
0A168                                   ora famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .endif
0A168                               tax
0A168                           
0A168                           @update_volume:
0A168                               ; Write volume
0A168                               lda famistudio_n163_vol_table,y
0A168                               sta FAMISTUDIO_N163_ADDR
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_volume_table,x 
0A168                               .else
0A168                                   txa
0A168                               .endif
0A168                               ora #FAMISTUDIO_N163_CHN_MASK
0A168                               sta FAMISTUDIO_N163_DATA
0A168                           
0A168                           @done:
0A168                               rts
0A168                           
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_EXP_S5B
0A168                           
0A168                           famistudio_s5b_reg_table_lo:
0A168                               .byte FAMISTUDIO_S5B_REG_LO_A, FAMISTUDIO_S5B_REG_LO_B, FAMISTUDIO_S5B_REG_LO_C
0A168                           famistudio_s5b_reg_table_hi:
0A168                               .byte FAMISTUDIO_S5B_REG_HI_A, FAMISTUDIO_S5B_REG_HI_B, FAMISTUDIO_S5B_REG_HI_C
0A168                           famistudio_s5b_vol_table:
0A168                               .byte FAMISTUDIO_S5B_REG_VOL_A, FAMISTUDIO_S5B_REG_VOL_B, FAMISTUDIO_S5B_REG_VOL_C
0A168                           famistudio_s5b_env_table:
0A168                               .byte FAMISTUDIO_S5B_CH0_ENVS, FAMISTUDIO_S5B_CH1_ENVS, FAMISTUDIO_S5B_CH2_ENVS
0A168                           famistudio_s5b_noise_mask:
0A168                               .byte $08, $10, $20
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_S5B_CHANNEL_SOUND (internal)
0A168                           ;
0A168                           ; Updates the S5B audio registers for a given channel.
0A168                           ;
0A168                           ; [in] y: S5B channel idx (0,1,2)
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_update_s5b_channel_sound:
0A168                               
0A168                               pitch   = famistudio_ptr1
0A168                               env_bit = famistudio_ptr1_lo
0A168                           
0A168                               ; These are shared by all 3 channels.
0A168                               env_period = famistudio_ptr0
0A168                               attack     = famistudio_ptr2
0A168                               env_shape  = famistudio_r1
0A168                               env_octave = famistudio_r2
0A168                               noise_freq = famistudio_r3
0A168                           
0A168                               ; First channel will clear these, last channel will write the registers.
0A168                               cpy #0
0A168                               bne @not_first_channel
0A168                               sty env_shape
0A168                               sty noise_freq
0A168                               sty attack
0A168                               lda #$80 ; This mean 'manual pitch'
0A168                               sty env_octave
0A168                           
0A168                           @not_first_channel:
0A168                               ldx #0 ; This will fetch volume 0.
0A168                               stx env_bit
0A168                               lda famistudio_chn_note+FAMISTUDIO_S5B_CH0_IDX,y
0A168                               bne @nocut
0A168                               jmp @update_volume
0A168                           
0A168                           @nocut:
0A168                               ; Store noise if mixer has it enabled
0A168                               ldx famistudio_s5b_env_table,y
0A168                               lda famistudio_env_value+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A168                               and famistudio_s5b_noise_mask,y
0A168                               bne @nonoise
0A168                               lda famistudio_env_value+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A168                               sta noise_freq
0A168                           
0A168                           @nonoise:
0A168                               lda famistudio_chn_note+FAMISTUDIO_S5B_CH0_IDX,y
0A168                               ; Read note, apply arpeggio 
0A168                               clc
0A168                               ldx famistudio_s5b_env_table,y
0A168                               adc famistudio_env_value+FAMISTUDIO_ENV_NOTE_OFF,x
0A168                               .if FAMISTUDIO_DUAL_SUPPORT
0A168                                   clc
0A168                                   adc famistudio_pal_adjust
0A168                               .endif
0A168                               tax
0A168                           
0A168                               ; Apply pitch envelope, fine pitch & slides
0A168                               famistudio_get_note_pitch_macro FAMISTUDIO_S5B_CH0_PITCH_ENV_IDX, 0, famistudio_note_table_lsb, famistudio_note_table_msb
0A168                           
0A168                               ; Write pitch + 1 (pitches on S5B are off by one compared to regular note table)
0A168                               lda famistudio_s5b_reg_table_lo,y
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda pitch+0
0A168                               clc
0A168                               adc #1
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                               sta pitch+0
0A168                               lda famistudio_s5b_reg_table_hi,y
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda pitch+1
0A168                               adc #0
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                               sta pitch+1
0A168                           
0A168                               ; Store env shape + period if active.
0A168                               lda famistudio_s5b_chn_env_shape,y
0A168                               and #$0f
0A168                               beq @noenv
0A168                               sta env_shape
0A168                           
0A168                               ; If bit 7 of any channel is on, well reset the envelope.
0A168                               lda famistudio_s5b_chn_env_shape,y
0A168                               ora attack 
0A168                               sta attack
0A168                               lda famistudio_s5b_chn_env_shape,y
0A168                               and #$0f
0A168                               sta famistudio_s5b_chn_env_shape,y
0A168                           
0A168                               ; Store auto-period settings
0A168                               lda famistudio_s5b_chn_env_octave,y
0A168                               sta env_octave
0A168                               cmp #$80 ; This mean 'manual pitch'
0A168                               beq @manual_period
0A168                           
0A168                               @auto_period:
0A168                                   lda pitch+0
0A168                                   sta env_period+0
0A168                                   lda pitch+1
0A168                                   sta env_period+1
0A168                                   jmp @set_envelope_volume_flag
0A168                           
0A168                               @manual_period:
0A168                                   lda famistudio_s5b_env_period_lo
0A168                                   sta env_period+0
0A168                                   lda famistudio_s5b_env_period_hi
0A168                                   sta env_period+1
0A168                           
0A168                           @set_envelope_volume_flag:
0A168                               lda #$10
0A168                           
0A168                           @noenv:
0A168                               sta env_bit
0A168                           
0A168                               ; Read/multiply volume
0A168                               ldx famistudio_s5b_env_table,y
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK
0A168                                   lda famistudio_chn_volume_track+FAMISTUDIO_S5B_CH0_IDX, y
0A168                                   .if FAMISTUDIO_USE_VOLUME_SLIDES
0A168                                       ; During a slide, the lower 4 bits are fraction.
0A168                                       and #$f0
0A168                                   .endif        
0A168                                   ora famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .else
0A168                                   lda famistudio_env_value+FAMISTUDIO_ENV_VOLUME_OFF,x
0A168                               .endif
0A168                               tax
0A168                           
0A168                           @update_volume:
0A168                               ; Write volume
0A168                               lda famistudio_s5b_vol_table,y
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               .if FAMISTUDIO_USE_VOLUME_TRACK    
0A168                                   lda famistudio_volume_table,x 
0A168                                   ora env_bit
0A168                               .else
0A168                                   txa
0A168                                   ora env_bit
0A168                               .endif
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                           
0A168                           @write_shared_registers:
0A168                               ; Channel 2 writes all 5 shared registers.
0A168                               cpy #2
0A168                               bne @done
0A168                               lda env_shape
0A168                               beq @write_shared_noise
0A168                               ldx env_octave
0A168                               cpx #$80
0A168                               beq @write_shared_env_register
0A168                           
0A168                           @compute_auto_period:
0A168                               cpx #0
0A168                               beq @write_shared_env_register
0A168                               bpl @positive_octave_loop
0A168                               
0A168                               @negative_octave_loop:
0A168                                       asl env_period+0
0A168                                       rol env_period+1
0A168                                       inx
0A168                                       bne @negative_octave_loop
0A168                                   beq @write_shared_env_register
0A168                                   
0A168                               @positive_octave_loop:
0A168                                   cpx #1
0A168                                   bne @do_shift
0A168                                   @rounding:
0A168                                       lda env_period+0
0A168                                       and #1
0A168                                       beq @do_shift
0A168                                       lda env_period+0
0A168                                       clc
0A168                                       adc #1
0A168                                       sta env_period+0
0A168                                       bcc @do_shift
0A168                                       inc env_period+1
0A168                                   @do_shift:
0A168                                       lsr env_period+1
0A168                                       ror env_period+0
0A168                                       dex
0A168                                       bne @positive_octave_loop
0A168                           
0A168                           @write_shared_env_register:    
0A168                           
0A168                               ; Envelope period.
0A168                               lda #FAMISTUDIO_S5B_REG_ENV_LO
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda env_period+0
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                               lda #FAMISTUDIO_S5B_REG_ENV_HI
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda env_period+1
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                           
0A168                               ; Reset envelope if there was an attack.
0A168                               lda attack
0A168                               bpl @write_shared_noise
0A168                                   lda #FAMISTUDIO_S5B_REG_SHAPE
0A168                                   sta FAMISTUDIO_S5B_ADDR
0A168                                   lda env_shape
0A168                                   sta FAMISTUDIO_S5B_DATA
0A168                           
0A168                           @write_shared_noise:
0A168                           
0A168                               ; Tone/noise enabled.
0A168                               lda #FAMISTUDIO_S5B_REG_TONE
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda famistudio_env_value+FAMISTUDIO_S5B_CH2_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               asl
0A168                               ora famistudio_env_value+FAMISTUDIO_S5B_CH1_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               asl
0A168                               ora famistudio_env_value+FAMISTUDIO_S5B_CH0_ENVS+FAMISTUDIO_ENV_MIXER_IDX_OFF
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                               
0A168                               ; Noise freq
0A168                               lda #FAMISTUDIO_S5B_REG_NOISE
0A168                               sta FAMISTUDIO_S5B_ADDR
0A168                               lda noise_freq
0A168                               sta FAMISTUDIO_S5B_DATA
0A168                           
0A168                               lda #0
0A168                               sta famistudio_s5b_env_override
0A168                           
0A168                           @done:
0A168                               rts
0A168                           
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_USE_PHASE_RESET
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_PROCESS_PHASE_RESETS (internal)
0A168                           ;
0A168                           ; Reset phases for channels that requested it this frame. 
0A168                           ;======================================================================================================================
0A168                           
0A168                           .macro conditional_phase_reset_regular prev_hi, reg_hi 
0A168                               lsr
0A168                               bcc @done
0A168                               ldy prev_hi
0A168                               sty reg_hi
0A168                               @done:
0A168                           .endm
0A168                           
0A168                           .macro conditional_phase_reset_vrc6 prev_hi, reg_hi 
0A168                               lsr
0A168                               bcc @done
0A168                               tax
0A168                               lda prev_hi
0A168                               sta reg_hi
0A168                               ora #$80
0A168                               sta reg_hi
0A168                               txa
0A168                               @done:
0A168                           .endm
0A168                           
0A168                           .macro conditional_phase_reset_fds prev_hi, reg_hi 
0A168                               lsr
0A168                               bcc @done
0A168                               lda prev_hi
0A168                               ora #$80
0A168                               sta reg_hi
0A168                               and #$7f
0A168                               sta reg_hi
0A168                               @done:
0A168                           .endm
0A168                           
0A168                           famistudio_process_phase_resets:
0A168                           
0A168                               ; We group all the phase resets here at the end of the frame to make it easier to replicate in the main app since
0A168                               ; this routine will have very predictable # of cycle between channels, and having channels closers mean its easier 
0A168                               ; to sync 2 channels together. The downside is that we need to keep the previous hi-period for VRC6 (3-bytes) and
0A168                               ; FDS (1-byte).
0A168                           
0A168                               lda famistudio_phase_reset
0A168                           
0A168                               ; TODO : What about SFX here? A phase reset here will reset the SFX? Or will it?
0A168                               conditional_phase_reset_regular famistudio_pulse1_prev, FAMISTUDIO_APU_PL1_HI
0A168                               conditional_phase_reset_regular famistudio_pulse2_prev, FAMISTUDIO_APU_PL2_HI
0A168                               
0A168                               .if FAMISTUDIO_EXP_VRC6
0A168                                   conditional_phase_reset_vrc6 famistudio_vrc6_pulse1_prev_hi, FAMISTUDIO_VRC6_PL1_HI
0A168                                   conditional_phase_reset_vrc6 famistudio_vrc6_pulse2_prev_hi, FAMISTUDIO_VRC6_PL2_HI
0A168                                   conditional_phase_reset_vrc6 famistudio_vrc6_saw_prev_hi, FAMISTUDIO_VRC6_SAW_HI
0A168                               .else
0A168                                   lsr
0A168                                   lsr
0A168                                   lsr
0A168                               .endif
0A168                           
0A168                               .if FAMISTUDIO_EXP_MMC5
0A168                                   conditional_phase_reset_regular famistudio_mmc5_pulse1_prev, FAMISTUDIO_MMC5_PL1_HI
0A168                                   conditional_phase_reset_regular famistudio_mmc5_pulse2_prev, FAMISTUDIO_MMC5_PL2_HI
0A168                               .else
0A168                                   lsr
0A168                                   lsr
0A168                               .endif
0A168                           
0A168                               .if FAMISTUDIO_EXP_FDS    
0A168                                   conditional_phase_reset_fds famistudio_fds_prev_hi, FAMISTUDIO_FDS_FREQ_HI
0A168                               .endif
0A168                           
0A168                               .if FAMISTUDIO_EXP_N163
0A168                               ldx #0
0A168                               @n163_phase_reset_loop:
0A168                                   lda famistudio_channel_to_phase_reset_mask+FAMISTUDIO_N163_CH0_IDX, x 
0A168                                   and famistudio_phase_reset_n163
0A168                                   beq @next_n163_channel
0A168                                       ldy #0    
0A168                                       lda famistudio_n163_phase_table_lo,x
0A168                                       sta FAMISTUDIO_N163_ADDR
0A168                                       sty FAMISTUDIO_N163_DATA
0A168                                       lda famistudio_n163_phase_table_mid,x
0A168                                       sta FAMISTUDIO_N163_ADDR
0A168                                       sty FAMISTUDIO_N163_DATA
0A168                                       lda famistudio_n163_phase_table_hi,x
0A168                                       sta FAMISTUDIO_N163_ADDR
0A168                                       sty FAMISTUDIO_N163_DATA
0A168                                   @next_n163_channel:
0A168                                       inx
0A168                                       cpx #FAMISTUDIO_EXP_N163_CHN_CNT
0A168                                       bne @n163_phase_reset_loop
0A168                               .endif
0A168                           
0A168                               @clear_phase_reset_flags:
0A168                                   lda #0
0A168                                   sta famistudio_phase_reset
0A168                                   .if FAMISTUDIO_EXP_N163
0A168                                       sta famistudio_phase_reset_n163
0A168                                   .endif
0A168                                   rts
0A168                           
0A168                           .endif
0A168                           
0A168                           .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE_ROW_WITH_DELAYS (internal)
0A168                           ;
0A168                           ; Advance the song for a given channel, but while managing notes/cuts delays. 
0A168                           ;
0A168                           ; [in] x: channel index (also true when leaving the function)
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_advance_channel_with_delays:
0A168                           
0A168                               ; Is the tempo telling us to advance by 1 row?
0A168                               lda famistudio_tempo_advance_row
0A168                               beq @check_delayed_note
0A168                           
0A168                               ; Tempo says we need to advance, was there a delayed note wairing?
0A168                               lda famistudio_chn_note_delay,x
0A168                               bmi @advance
0A168                           
0A168                               ; Need to clear any pending delayed note before advancing (will be inaudible).
0A168                               @clear_delayed_note:
0A168                               lda #$ff
0A168                               sta famistudio_chn_note_delay,x
0A168                               jsr famistudio_advance_channel ; This is the update for the de delayed note.
0A168                               jmp @advance
0A168                           
0A168                               ; Tempo said we didnt need to advance, see if there is delayed note with a counter that reached zero.
0A168                               @check_delayed_note:
0A168                               lda famistudio_chn_note_delay,x
0A168                               bmi @check_delayed_cut
0A168                               sec
0A168                               sbc #1
0A168                               sta famistudio_chn_note_delay,x
0A168                               bpl @check_delayed_cut ; When wrapping from 0 -> 0xff, we play the note.
0A168                           
0A168                               ; Finally, advance by 1 row.
0A168                               @advance:
0A168                               jsr famistudio_advance_channel
0A168                           
0A168                               ; Handle delayed cuts.
0A168                               @check_delayed_cut:
0A168                               lda famistudio_chn_cut_delay,x
0A168                               bmi @done
0A168                               sec
0A168                               sbc #1
0A168                               sta famistudio_chn_cut_delay,x
0A168                               bpl @done ; When wrapping from 0 -> 0xff, we play the note.
0A168                           
0A168                               ; Write a stop note.
0A168                               lda #0
0A168                               sta famistudio_chn_note,x
0A168                           
0A168                               ; Special case for DPCM, need to stop it manually.
0A168                               cpx #4
0A168                               bne @done
0A168                               jsr famistudio_sample_stop
0A168                               
0A168                               @done:
0A168                               rts
0A168                           
0A168                           .endif
0A168                           
0A168                           ;======================================================================================================================
0A168                           ; FAMISTUDIO_UPDATE (public)
0A168                           ;
0A168                           ; Main update function, should be called once per frame, ideally at the end of NMI. Will update the tempo, advance
0A168                           ; the song if needed, update instrument and apply any change to the APU registers.
0A168                           ;
0A168                           ; [in] no input params.
0A168                           ;======================================================================================================================
0A168                           
0A168                           famistudio_update:
0A168                           
0A168                               pitch_env_type = famistudio_r0
0A168                               temp_pitch     = famistudio_r1
0A168                               tempo_env_ptr  = famistudio_ptr0
0A168                               env_ptr        = famistudio_ptr0
0A168                               pitch_env_ptr  = famistudio_ptr0
0A168                           
0A168                           .if FAMISTUDIO_CFG_THREAD
0A168                               lda famistudio_ptr0_lo
0A168                               pha
0A168                               lda famistudio_ptr0_hi
0A168                               pha
0A168                           .endif
0A168                           
0A168 A5 2F                         lda famistudio_song_speed ; Speed 0 means that no music is playing currently
0A16A 30 02                         bmi @pause ; Bit 7 set is the pause flag
0A16C D0 07                         bne @update
0A16E                           @pause:
0A16E                           .if !FAMISTUDIO_USE_FAMITRACKER_TEMPO
0A16E A9 01                         lda #1
0A170 85 5D                         sta famistudio_tempo_frame_cnt
0A172                           .endif
0A172 4C 57 A2                      jmp @update_sound
0A175                           
0A175                           ;----------------------------------------------------------------------------------------------------------------------
0A175                           @update:
0A175                           
0A175                           .if FAMISTUDIO_USE_FAMITRACKER_TEMPO
0A175                           
0A175                               lda famistudio_tempo_acc_hi
0A175                               cmp famistudio_song_speed
0A175                               .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A175                                   ldx #0
0A175                                   stx famistudio_tempo_advance_row    
0A175                                   bcc @advance_song
0A175                               .else
0A175                                   bcc @update_envelopes
0A175                               .endif
0A175                               sbc famistudio_song_speed ; Carry is set.
0A175                               sta famistudio_tempo_acc_hi    
0A175                               .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A175                                   ldx #1
0A175                                   stx famistudio_tempo_advance_row
0A175                               .endif
0A175                           
0A175                           .else ; FamiStudio tempo
0A175                           
0A175                               ; Decrement envelope counter, see if we need to advance.
0A175 C6 5A                         dec famistudio_tempo_env_counter
0A177 F0 05                         beq @advance_tempo_envelope
0A179 A9 01                         lda #1
0A17B 4C 9D A1                      jmp @store_frame_count
0A17E                           
0A17E                           @advance_tempo_envelope:
0A17E                               ; Advance the envelope by one step.
0A17E A5 4A                         lda famistudio_tempo_env_ptr_lo
0A180 85 2D                         sta tempo_env_ptr+0
0A182 A5 4B                         lda famistudio_tempo_env_ptr_hi
0A184 85 2E                         sta tempo_env_ptr+1
0A186                           
0A186 E6 5B                         inc famistudio_tempo_env_idx
0A188 A4 5B                         ldy famistudio_tempo_env_idx
0A18A B1 2D                         lda (tempo_env_ptr),y
0A18C 10 06                         bpl @store_counter ; Negative value means we loop back to to index 1.
0A18E                           
0A18E                           @tempo_envelope_end:
0A18E A0 01                         ldy #1
0A190 84 5B                         sty famistudio_tempo_env_idx
0A192 B1 2D                         lda (tempo_env_ptr),y
0A194                           
0A194                           @store_counter:
0A194                               ; Reset the counter
0A194 85 5A                         sta famistudio_tempo_env_counter
0A196 A5 5C                         lda famistudio_tempo_frame_num
0A198 D0 03                         bne @store_frame_count
0A19A 4C 0D A3                      jmp @skip_frame
0A19D                           
0A19D                           @store_frame_count:
0A19D 85 5D                         sta famistudio_tempo_frame_cnt
0A19F                           
0A19F                           .endif
0A19F                           
0A19F                           ;----------------------------------------------------------------------------------------------------------------------
0A19F                           @advance_song:
0A19F A2 00                         ldx #0
0A1A1                               @channel_loop:
0A1A1                                   .if !FAMISTUDIO_CFG_DPCM_SUPPORT
0A1A1 E0 04                                 cpx #4
0A1A3 F0 03                                 beq @channel_loop_end
0A1A5                                   .endif    
0A1A5                                   .if FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A1A5                                       jsr famistudio_advance_channel_with_delays
0A1A5                                   .else
0A1A5 20 F3 A3                              jsr famistudio_advance_channel
0A1A8                                   .endif
0A1A8                                   @channel_loop_end:
0A1A8 E8                                inx
0A1A9 E0 05                             cpx #FAMISTUDIO_NUM_CHANNELS
0A1AB D0 F4                             bne @channel_loop
0A1AD                           
0A1AD                           ;----------------------------------------------------------------------------------------------------------------------
0A1AD                           @update_envelopes:
0A1AD A2 00                         ldx #0
0A1AF                           
0A1AF                           @env_process:
0A1AF BD 0B 04                      lda famistudio_env_repeat,x
0A1B2 F0 05                         beq @env_read  
0A1B4 DE 0B 04                      dec famistudio_env_repeat,x
0A1B7 D0 2B                         bne @env_next
0A1B9                           
0A1B9                           @env_read:
0A1B9 BD 16 04                      lda famistudio_env_addr_lo,x
0A1BC 85 2D                         sta env_ptr+0
0A1BE BD 21 04                      lda famistudio_env_addr_hi,x
0A1C1 85 2E                         sta env_ptr+1
0A1C3 BC 35 04                      ldy famistudio_env_ptr,x
0A1C6                           
0A1C6                           @env_read_value:
0A1C6 B1 2D                         lda (env_ptr),y
0A1C8 10 09                         bpl @env_special ; Values below 128 used as a special code, loop or repeat
0A1CA 18                            clc              ; Values above 128 are output value+192 (output values are signed -63..64)
0A1CB 69 40                         adc #256-192
0A1CD 9D 00 04                      sta famistudio_env_value,x
0A1D0 C8                            iny
0A1D1 D0 0D                         bne @env_next_store_ptr
0A1D3                           
0A1D3                           @env_special:
0A1D3 D0 07                         bne @env_set_repeat  ; Zero is the loop point, non-zero values used for the repeat counter
0A1D5 C8                            iny
0A1D6 B1 2D                         lda (env_ptr),y     ; Read loop position
0A1D8 A8                            tay
0A1D9 4C C6 A1                      jmp @env_read_value
0A1DC                           
0A1DC                           @env_set_repeat:
0A1DC C8                            iny
0A1DD 9D 0B 04                      sta famistudio_env_repeat,x ; Store the repeat counter value
0A1E0                           
0A1E0                           @env_next_store_ptr:
0A1E0 98                            tya
0A1E1 9D 35 04                      sta famistudio_env_ptr,x
0A1E4                           
0A1E4                           @env_next:
0A1E4 E8                            inx
0A1E5                           
0A1E5 E0 0B                         cpx #FAMISTUDIO_NUM_ENVELOPES
0A1E7 D0 C6                         bne @env_process
0A1E9                           
0A1E9                           ;----------------------------------------------------------------------------------------------------------------------
0A1E9                           @update_pitch_envelopes:
0A1E9 A2 00                         ldx #0
0A1EB 4C EE A1                      jmp @pitch_env_process
0A1EE                           
0A1EE                           @pitch_env_process:
0A1EE B5 3C                         lda famistudio_pitch_env_repeat,x
0A1F0 F0 04                         beq @pitch_env_read
0A1F2 D6 3C                         dec famistudio_pitch_env_repeat,x
0A1F4 D0 5C                         bne @pitch_env_next
0A1F6                           
0A1F6                           @pitch_env_read:
0A1F6 B5 3F                         lda famistudio_pitch_env_addr_lo,x 
0A1F8 85 2D                         sta pitch_env_ptr+0
0A1FA B5 47                         lda famistudio_pitch_env_addr_hi,x
0A1FC 85 2E                         sta pitch_env_ptr+1
0A1FE A0 00                         ldy #0
0A200 B1 2D                         lda (pitch_env_ptr),y
0A202 85 28                         sta pitch_env_type ; First value is 0 for absolute envelope, 0x80 for relative.
0A204 B4 57                         ldy famistudio_pitch_env_ptr,x
0A206                           
0A206                           @pitch_env_read_value:
0A206 B1 2D                         lda (pitch_env_ptr),y
0A208 10 37                         bpl @pitch_env_special 
0A20A 18                            clc  
0A20B 69 40                         adc #256-192
0A20D 24 28                         bit pitch_env_type
0A20F 30 15                         bmi @pitch_relative
0A211                           
0A211                           @pitch_absolute:
0A211 9D 2C 04                      sta famistudio_pitch_env_value_lo,x
0A214 09 00                         ora #0
0A216 30 05                         bmi @pitch_absolute_neg  
0A218 A9 00                         lda #0
0A21A 4C 1F A2                      jmp @pitch_absolute_set_value_hi
0A21D                           @pitch_absolute_neg:
0A21D A9 FF                         lda #$ff
0A21F                           @pitch_absolute_set_value_hi:
0A21F 9D 2F 04                      sta famistudio_pitch_env_value_hi,x
0A222 C8                            iny 
0A223 4C 4F A2                      jmp @pitch_env_next_store_ptr
0A226                           
0A226                           @pitch_relative:
0A226 85 29                         sta temp_pitch
0A228 18                            clc
0A229 7D 2C 04                      adc famistudio_pitch_env_value_lo,x
0A22C 9D 2C 04                      sta famistudio_pitch_env_value_lo,x
0A22F A5 29                         lda temp_pitch
0A231 29 80                         and #$80
0A233 10 02                         bpl @pitch_relative_pos  
0A235 A9 FF                         lda #$ff
0A237                           @pitch_relative_pos:
0A237 7D 2F 04                      adc famistudio_pitch_env_value_hi,x
0A23A 9D 2F 04                      sta famistudio_pitch_env_value_hi,x
0A23D C8                            iny 
0A23E 4C 4F A2                      jmp @pitch_env_next_store_ptr
0A241                           
0A241                           @pitch_env_special:
0A241 D0 07                         bne @pitch_env_set_repeat
0A243 C8                            iny 
0A244 B1 2D                         lda (pitch_env_ptr),y 
0A246 A8                            tay
0A247 4C 06 A2                      jmp @pitch_env_read_value 
0A24A                           
0A24A                           @pitch_env_set_repeat:
0A24A C8                            iny
0A24B 05 28                         ora pitch_env_type ; This is going to set the relative flag in the hi-bit.
0A24D 95 3C                         sta famistudio_pitch_env_repeat,x
0A24F                           
0A24F                           @pitch_env_next_store_ptr:
0A24F 98                            tya 
0A250 95 57                         sta famistudio_pitch_env_ptr,x
0A252                           
0A252                           @pitch_env_next:
0A252 E8                            inx 
0A253                           
0A253 E0 03                         cpx #FAMISTUDIO_NUM_PITCH_ENVELOPES
0A255 D0 97                         bne @pitch_env_process
0A257                           
0A257                           .if FAMISTUDIO_USE_SLIDE_NOTES
0A257                           ;----------------------------------------------------------------------------------------------------------------------
0A257                           @update_slides:
0A257                               ldx #0
0A257                           
0A257                           @slide_process:
0A257                               lda famistudio_slide_step,x ; Zero repeat means no active slide.
0A257                               beq @slide_next
0A257                               clc ; Add step to slide pitch (16bit + 8bit signed).
0A257                               lda famistudio_slide_step,x
0A257                               adc famistudio_slide_pitch_lo,x
0A257                               sta famistudio_slide_pitch_lo,x
0A257                               lda famistudio_slide_step,x
0A257                               and #$80
0A257                               beq @positive_slide
0A257                           
0A257                           @negative_slide:
0A257                               lda #$ff
0A257                               adc famistudio_slide_pitch_hi,x
0A257                               sta famistudio_slide_pitch_hi,x
0A257                               bpl @slide_next
0A257                               jmp @clear_slide
0A257                           
0A257                           @positive_slide:
0A257                               adc famistudio_slide_pitch_hi,x
0A257                               sta famistudio_slide_pitch_hi,x
0A257                               bmi @slide_next
0A257                           
0A257                           @clear_slide:
0A257                               lda #0
0A257                               sta famistudio_slide_step,x
0A257                           
0A257                           @slide_next:
0A257                               inx 
0A257                               cpx #FAMISTUDIO_NUM_SLIDES
0A257                               bne @slide_process
0A257                           .endif
0A257                           
0A257                           .if FAMISTUDIO_USE_VOLUME_SLIDES
0A257                           
0A257                           ; FIXME : This seem wayyyy more complicated than it should.
0A257                           ; - The track volume has 4 bits of fraction : VVVVFFFF
0A257                           ; - The slide step is signed : SVVVFFFF
0A257                           ; - The slide target (end volume) is simply : VVVV0000
0A257                           ;
0A257                           ; foreach slides
0A257                           ;     if step != 0
0A257                           ;         volume += step
0A257                           ;         if step > 0 && volume >= target || step < 0 && volume <= target
0A257                           ;             volume = target
0A257                           ;             step = 0
0A257                           
0A257                           @update_volume_slides:
0A257                               ldx #0
0A257                           
0A257                           @volume_side_process:
0A257                               lda famistudio_chn_volume_slide_step,x
0A257                               beq @volume_slide_next
0A257                               clc 
0A257                               bmi @negative_volume_slide
0A257                               
0A257                           @positive_volume_slide:
0A257                               ; If the slide goes up, stop if we hit the target or go over it, over 15 (carry will be set)
0A257                               adc famistudio_chn_volume_track,x
0A257                               bcs @clear_volume_slide
0A257                               sta famistudio_chn_volume_track,x
0A257                               cmp famistudio_chn_volume_slide_target,x
0A257                               bcc @volume_slide_next
0A257                               bcs @clear_volume_slide
0A257                           
0A257                           @negative_volume_slide:
0A257                               ; If the slide goes do, stop if we hit the target or go below it, or below zero.
0A257                               ; This is a bit trickier since we cant rely on the carry or any flag to 
0A257                               ; tell us if we wrapped around. 
0A257                               adc famistudio_chn_volume_track,x
0A257                               ldy famistudio_chn_volume_track,x
0A257                               bmi @slide_upper_half
0A257                           
0A257                           @slide_lower_half:
0A257                               sta famistudio_chn_volume_track,x
0A257                               cmp famistudio_chn_volume_slide_target,x
0A257                               beq @clear_volume_slide
0A257                               bmi @clear_volume_slide
0A257                               bpl @volume_slide_next
0A257                           
0A257                           @slide_upper_half:
0A257                               sta famistudio_chn_volume_track,x
0A257                               cmp famistudio_chn_volume_slide_target,x
0A257                               beq @clear_volume_slide
0A257                               bcs @volume_slide_next
0A257                           
0A257                           @clear_volume_slide:    
0A257                               lda famistudio_chn_volume_slide_target,x
0A257                               sta famistudio_chn_volume_track,x
0A257                               lda #0
0A257                               sta famistudio_chn_volume_slide_step,x
0A257                           
0A257                           @volume_slide_next:
0A257                               inx 
0A257                               cpx #FAMISTUDIO_NUM_VOLUME_SLIDES
0A257                               bne @volume_side_process
0A257                           .endif
0A257                           
0A257                           .if FAMISTUDIO_CFG_EQUALIZER
0A257                           @update_equalizer:
0A257                               ldx #0
0A257                               @eq_channel_loop:
0A257                                   lda famistudio_chn_note_counter, x
0A257                                   beq @no_note
0A257                                       dec famistudio_chn_note_counter, x
0A257                                   @no_note:
0A257                                   inx
0A257                                   cpx #FAMISTUDIO_NUM_CHANNELS
0A257                                   bne @eq_channel_loop
0A257                           .endif
0A257                           
