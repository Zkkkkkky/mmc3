0A020                           
0A020                           ; DC.nes compact layout.  Every persistent byte is inside the removed stock
0A020                           ; driver's proven $0400-$046F/$0028-$005D state.  $002C was not used by the
0A020                           ; stock driver and is intentionally left alone.  $004C-$0056 is reserved for
0A020                           ; a call-local APU output buffer and is saved/restored by the bridge.
0A020                           .enum $0400
00400                           famistudio_env_value:             .dsb FAMISTUDIO_NUM_ENVELOPES
0040B                           famistudio_env_repeat:            .dsb FAMISTUDIO_NUM_ENVELOPES
00416                           famistudio_env_addr_lo:           .dsb FAMISTUDIO_NUM_ENVELOPES
00421                           famistudio_env_addr_hi:           .dsb FAMISTUDIO_NUM_ENVELOPES
0042C                           famistudio_pitch_env_value_lo:    .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
0042F                           famistudio_pitch_env_value_hi:    .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
00432                           .if FAMISTUDIO_USE_PITCH_TRACK
00432                           famistudio_pitch_env_fine_value:  .dsb FAMISTUDIO_NUM_PITCH_ENVELOPES
00435                           .endif
00435                           .ende
0A020                           
0A020                           .enum $0435
