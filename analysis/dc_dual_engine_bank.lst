0A50C                           @noise_slide:
0A50C                               lda (channel_data_ptr),y ; Read slide step size
0A50C                               iny
0A50C                               sta famistudio_slide_step+FAMISTUDIO_NOISE_SLIDE_INDEX
0A50C                               lda (channel_data_ptr),y ; Read slide note from
