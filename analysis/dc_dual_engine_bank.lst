0A35A                           ;======================================================================================================================
0A35A                           ; FAMISTUDIO_DO_NOTE_ATTACK + EXP VARIANTS (internal)
0A35A                           ;
0A35A                           ; Internal function to reset all the envelopes of a channnel (note attack).
0A35A                           ;
0A35A                           ; [in] x/r0 : channel index
0A35A                           ;======================================================================================================================
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_VRC7
0A35A                           
0A35A                           famistudio_do_vrc7_note_attack:
0A35A                           
0A35A                               chan_idx = famistudio_r0
0A35A                           
0A35A                               ; Set trigger flag for VRC7
0A35A                               lda #1
0A35A                               ldx chan_idx
0A35A                               sta famistudio_chn_vrc7_trigger-FAMISTUDIO_VRC7_CH0_IDX,x 
0A35A                               rts
0A35A                           
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_EPSM
0A35A                           
0A35A                           famistudio_do_epsm_note_attack:
0A35A                               
0A35A                               chan_idx = famistudio_r0
0A35A                               tmp_y    = famistudio_r1
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT+FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A35A                               sty tmp_y
0A35A                               ldy chan_idx
0A35A                               cpy #FAMISTUDIO_EPSM_CHAN_FM_START
0A35A                               bcs @fm_or_rhythm_channel
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT > 0
0A35A                           @square_channel:
0A35A                           
0A35A                               ; Reset mixer/noise envelopes.
0A35A                               ldx famistudio_channel_env,y
0A35A                               lda #0
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_value+FAMISTUDIO_ENV_MIXER_IDX_OFF,x
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                               sta famistudio_env_value+FAMISTUDIO_ENV_NOISE_IDX_OFF,x
0A35A                           
0A35A                               ; Set hi-bit of envelope shape to remember to reset it.
0A35A                               lda #$80
0A35A                               ldx chan_idx
0A35A                               ora famistudio_epsm_chn_env_shape-FAMISTUDIO_EPSM_CH0_IDX,x
0A35A                               sta famistudio_epsm_chn_env_shape-FAMISTUDIO_EPSM_CH0_IDX,x
0A35A                           
0A35A                               beq @done
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_EPSM_FM_CHN_CNT+FAMISTUDIO_EXP_EPSM_RHYTHM_CNT > 0
0A35A                           @fm_or_rhythm_channel:
0A35A                           
0A35A                               ; Set trigger flag for FM/rhythm. For rhythm we'll actually write 
0A35A                               ; out of bounds here, but the rhtyhm key array is immediately after.
0A35A                               lda #1
0A35A                               sta famistudio_chn_epsm_trigger-FAMISTUDIO_EPSM_CHAN_FM_START,y
0A35A                           .endif
0A35A                           
0A35A                           @done:
0A35A                               ldx chan_idx
0A35A                               ldy tmp_y
0A35A                               rts
0A35A                           
0A35A                           .endif
0A35A                           
0A35A                           .if FAMISTUDIO_EXP_N163
0A35A                           
0A35A                           famistudio_do_n163_note_attack:
0A35A                           
0A35A                               chan_idx = famistudio_r0
0A35A                               tmp_y    = famistudio_r1
0A35A                           
0A35A                               ; Reset wave envelope.
0A35A                               sty tmp_y
0A35A                               ldy chan_idx
0A35A                               ldx famistudio_channel_env,y
0A35A                               lda #0
0A35A                               sta famistudio_env_repeat+FAMISTUDIO_ENV_N163_WAVE_IDX_OFF,x
0A35A                               lda #1 ; Index 0 is release point, so envelope starts at 1.
0A35A                               sta famistudio_env_ptr+FAMISTUDIO_ENV_N163_WAVE_IDX_OFF,x
0A35A                           
0A35A                               ; Clear wave index to -1 to force reload.
0A35A                               ldx chan_idx
0A35A                               lda #$ff
0A35A                               sta famistudio_chn_n163_wave_index-FAMISTUDIO_N163_CH0_IDX, x
