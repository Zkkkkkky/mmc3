0A020                           
0A020                           .ifndef FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS
0A020                               FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS = 0
