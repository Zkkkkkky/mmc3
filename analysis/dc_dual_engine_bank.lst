0A020                               FAMISTUDIO_EXP_RAINBOW = 0
0A020                           .endif
0A020                           
0A020                           .if FAMISTUDIO_EXP_RAINBOW
0A020                               FAMISTUDIO_EXP_VRC6 = 1
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_VRC6
0A020                               FAMISTUDIO_EXP_VRC6 = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_VRC7
0A020                               FAMISTUDIO_EXP_VRC7 = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_EPSM
0A020                               FAMISTUDIO_EXP_EPSM = 0
0A020                               FAMISTUDIO_EXP_EPSM_ENV_CNT = 0
0A020                               FAMISTUDIO_EXP_EPSM_RHYTHM_CNT = 0
0A020                               FAMISTUDIO_EXP_EPSM_FM_CHN_CNT = 0
0A020                               FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT = 0
0A020                               FAMISTUDIO_EXP_EPSM_TRIG_CHN = 0
0A020                           .else
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT
0A020                                   FAMISTUDIO_EXP_EPSM_SSG_CHN_CNT     = 3
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_FM_CHN_CNT
0A020                                   FAMISTUDIO_EXP_EPSM_FM_CHN_CNT      = 6
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN1_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN1_ENABLE = 1
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN2_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN2_ENABLE = 1
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN3_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN3_ENABLE = 1
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN4_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN4_ENABLE = 1
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN5_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN5_ENABLE = 1
0A020                               .endif
0A020                               .ifndef FAMISTUDIO_EXP_EPSM_RHYTHM_CHN6_ENABLE
0A020                                   FAMISTUDIO_EXP_EPSM_RHYTHM_CHN6_ENABLE = 1
0A020                               .endif
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_MMC5
0A020                               FAMISTUDIO_EXP_MMC5 = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_S5B
0A020                               FAMISTUDIO_EXP_S5B = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_FDS
0A020                               FAMISTUDIO_EXP_FDS = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_N163
0A020                               FAMISTUDIO_EXP_N163 = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_EXP_N163_CHN_CNT
0A020                               FAMISTUDIO_EXP_N163_CHN_CNT = 1
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_CFG_PAL_SUPPORT
0A020                               FAMISTUDIO_CFG_PAL_SUPPORT = 0
0A020                           .endif
0A020                           
0A020                           .ifndef FAMISTUDIO_CFG_NTSC_SUPPORT
0A020                               .if FAMISTUDIO_CFG_PAL_SUPPORT
0A020                                   FAMISTUDIO_CFG_NTSC_SUPPORT = 0
0A020                               .else
0A020                                   FAMISTUDIO_CFG_NTSC_SUPPORT = 1
0A020                               .endif
0A020                           .endif
0A020                           
0A020                           .if FAMISTUDIO_CFG_NTSC_SUPPORT && FAMISTUDIO_CFG_PAL_SUPPORT
