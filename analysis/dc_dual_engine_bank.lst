0A120                           ;======================================================================================================================
0A120                           ; FAMISTUDIO_MUSIC_PAUSE (public)
0A120                           ;
0A120                           ; Pause/unpause the currently playing song. Note that this will not update the APU, so sound might linger. Calling
0A120                           ; famistudio_update after this will update the APU.
0A120                           ; 
0A120                           ; [in] a : zero to play, non-zero to pause.
0A120                           ;======================================================================================================================
0A120                           
0A120                           famistudio_music_pause:
0A120                           
0A120 AA                            tax
0A121 F0 17                         beq @unpause
0A123                               
0A123                           @pause:
0A123                           
0A123 20 37 A5                      jsr famistudio_sample_stop
0A126                               
0A126 A9 00                         lda #0
0A128 8D 00 04                      sta famistudio_env_value+FAMISTUDIO_CH0_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
0A12B 8D 03 04                      sta famistudio_env_value+FAMISTUDIO_CH1_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
0A12E 8D 06 04                      sta famistudio_env_value+FAMISTUDIO_CH2_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
