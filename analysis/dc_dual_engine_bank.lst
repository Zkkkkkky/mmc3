0A50C                               lda (channel_data_ptr),y ; Read slide note to
0A50C                               ldy tmp_slide_from       ; reload note from
0A50C                           .if FAMISTUDIO_DUAL_SUPPORT
0A50C                               adc famistudio_pal_adjust
0A50C                           .endif
