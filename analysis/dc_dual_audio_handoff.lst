                                ; Same-frame custom-to-stock handoff stored in the expanded copy of stock PRG
                                ; bank $18. The source range $99EC-$9A7F is all zero and remains untouched in
                                ; the original bank; only the expanded copy receives this code.
                                
                                    .base $99ec
099EC                           
099EC                           mapper_select = $8000
099EC                           mapper_data   = $8001
099EC                           music_command = $004c
099EC                           
099EC                           stock_handoff_dispatch:
099EC 48                            pha
099ED A9 87                         lda #$87
099EF 8D 00 80                      sta mapper_select
099F2 A9 19                         lda #$19
099F4 8D 01 80                      sta mapper_data
099F7 A9 FE                         lda #$fe
099F9 85 4C                         sta music_command
099FB 20 20 80                      jsr $8020
099FE 68                            pla
099FF 85 4C                         sta music_command
09A01 4C 20 80                      jmp $8020
09A04                           
09A04                           stock_handoff_dispatch_end:
